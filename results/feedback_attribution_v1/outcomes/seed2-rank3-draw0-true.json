  "child": {
    "name": "seed2-rank3-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp_d = 0\n    my_d = 0\n    for m, o in history:\n        if o == 'D':\n            opp_d += 1\n        if m == 'D':\n            my_d += 1\n    opp_c = n - opp_d\n    my_c = n - my_d\n    last_me, last_opp = history[-1]\n    rounds_left = 100 - n\n\n    # Very endgame: exploit cooperative opponents, avoid being exploited by defectors.\n    if rounds_left <= 0:\n        return 'D'\n    if rounds_left <= 2:\n        if opp_d * 3 <= n:\n            return 'D'\n        return 'D' if last_opp == 'D' else 'C'\n    if rounds_left <= 6:\n        if opp_d * 4 < n:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        if rng.random() < 0.5:\n            return 'D'\n        return 'C'\n\n    # Detect persistent defectors.\n    if opp_d >= 5 and opp_d * 3 > n * 2:\n        # Punish hard, with rare cooperation to avoid pure DD trap only when clearly recovering.\n        if n >= 4 and history[-2][1] == 'C' and last_opp == 'C':\n            return 'C'\n        if rng.random() < 0.9:\n            return 'D'\n        return 'C'\n\n    # Very cooperative opponent: maintain mutual cooperation, probe lightly.\n    if opp_d == 0:\n        if n < 3:\n            return 'C'\n        if n >= 90:\n            return 'D'\n        if n >= 75 and rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    # Mostly cooperative opponent: cooperate, but punish recent defection clusters.\n    if opp_c >= opp_d * 3:\n        recent_d = 0\n        for i in range(max(0, n - 4), n):\n            if history[i][1] == 'D':\n                recent_d += 1\n        if last_opp == 'D':\n            if recent_d >= 2:\n                return 'D'\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        if last_me == 'D' and opp_d > 0:\n            return 'C'\n        if n >= 85 and rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    # Moderately mixed opponent: reciprocal with controlled forgiveness.\n    if opp_c * 2 >= opp_d:\n        # Count opponent defections in last 3 rounds.\n        recent3_d = 0\n        for i in range(max(0, n - 3), n):\n            if history[i][1] == 'D':\n                recent3_d += 1\n        if last_opp == 'D':\n            if recent3_d >= 2:\n                return 'D'\n            if rng.random() < 0.18:\n                return 'C'\n            return 'D'\n        # Opponent cooperated last.\n        if last_me == 'D':\n            if rng.random() < 0.85:\n                return 'C'\n            return 'D'\n        if recent3_d >= 1 and rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    # Defect-heavy opponent: defect mostly.\n    if last_opp == 'C' and rng.random() < 0.35:\n        return 'C'\n    return 'D'"
  },
