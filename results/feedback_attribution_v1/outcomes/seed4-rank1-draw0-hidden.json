    "name": "seed4-rank1-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Count opponent cooperations overall and recent\n    opp_c = 0\n    cc = 0\n    cd = 0\n    dc = 0\n    for me, op in history:\n        if op == 'C':\n            opp_c += 1\n        if me == 'C' and op == 'C':\n            cc += 1\n        elif me == 'C' and op == 'D':\n            cd += 1\n        elif me == 'D' and op == 'C':\n            dc += 1\n\n    # Last opponent move\n    last_me, last_op = history[-1]\n\n    # First round of late game: grab endgame advantage opportunistically\n    if n >= 98:\n        # Against known cooperative opponents, defecting near the end is very profitable.\n        if opp_c >= n * 0.6:\n            return 'D'\n        # Against defectors, defect too.\n        return 'D'\n\n    # Early game: cooperate, but if opponent defected twice in a row, retaliate.\n    if n < 3:\n        return 'C'\n\n    # Recent window stats\n    window = history[-10:]\n    w = len(window)\n    recent_opp_d = 0\n    recent_me_d = 0\n    for me, op in window:\n        if op == 'D':\n            recent_opp_d += 1\n        if me == 'D':\n            recent_me_d += 1\n    recent_opp_c = w - recent_opp_d\n\n    # Detect relentless defector: punish hard but occasionally test.\n    if n >= 6 and opp_c * 4 <= n:\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # Detect near-pure cooperator: cooperate mostly but exploit at the very end.\n    if opp_c >= n - 1 and n >= 20:\n        # Cooperate to keep mutual gains, do not defect prematurely.\n        return 'C'\n\n    # Tit-for-tat-ish core with forgiveness tuned to exploit cooperative opponents.\n    if last_op == 'C':\n        # Opponent cooperated. Defect rarely as a probe only if we haven't been\n        # punished, and only against very cooperative opponents in mid-game.\n        if n >= 15 and opp_c >= n * 0.8:\n            # Very cooperative: probe occasionally for extra gain.\n            if rng.random() < 0.06:\n                return 'D'\n        # If we defected last round, return to cooperation to maintain trust.\n        if last_me == 'D':\n            return 'C'\n        return 'C'\n\n    # Opponent defected last round.\n    # If they mostly cooperate, be forgiving to avoid death spirals.\n    if opp_c >= n * 0.7:\n        # Forgive most of the time when cooperative history is strong.\n        if recent_opp_c >= 6:\n            return 'C'\n        if rng.random() < 0.5:\n            return 'C'\n        return 'D'\n\n    # If they are aggressive, retaliate consistently.\n    if recent_opp_d >= 5:\n        return 'D'\n\n    # Middle-ground: retaliate but with small forgiveness probability.\n    if rng.random() < 0.2:\n        return 'C'\n    return 'D'"
  },
