    "name": "seed1-rank1-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    last_opp = opp[-1]\n\n    # Track consecutive cooperation streak of opponent (cheap detection\n    # of unconditional cooperators before deciding to exploit).\n    opp_cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'C' and my[i] == 'C':\n            opp_cc_streak += 1\n        else:\n            break\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n\n    # Endgame: last few rounds, exploit likely cooperators slightly.\n    remaining = 100 - n\n    if remaining <= 1:\n        return 'D'\n    if remaining <= 3:\n        if opp_c * 3 >= n * 2:  # mostly cooperative\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Very early: cooperate to establish mutual cooperation.\n    if n < 3:\n        return 'C'\n\n    # Strong retaliation against heavily-defecting opponents.\n    if opp_d * 2 > n:\n        # But if opponent just cooperated after long defect streak, probe.\n        if last_opp == 'C' and opp_d >= 5 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # If opponent has been very cooperative, cooperate but exploit rarely.\n    # Use streak to avoid breaking solid mutual cooperation too often.\n    if opp_c * 10 >= n * 9:\n        if n > 6 and rng.random() < 0.04 and remaining > 5:\n            return 'D'\n        return 'C'\n\n    # Standard tit-for-tat with controlled forgiveness.\n    if last_opp == 'C':\n        # Avoid defecting when we just defected and they forgave.\n        if my[-1] == 'D':\n            return 'C'\n        # Rare probe against cooperative-ish opponents.\n        if opp_c * 10 >= n * 7 and rng.random() < 0.03 and remaining > 5:\n            return 'D'\n        return 'C'\n\n    # Opponent just defected. Count trailing defect streak.\n    def_streak = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'D':\n            def_streak += 1\n        else:\n            break\n\n    if def_streak >= 2:\n        # Firm retaliation while streak continues; occasional repair.\n        if rng.random() < 0.08 and opp_c * 3 >= n:\n            return 'C'\n        return 'D'\n\n    # Single defection: retaliate once but forgive periodically to\n    # avoid endless DD spirals with retaliatory strategies.\n    if rng.random() < 0.22:\n        return 'C'\n    return 'D'"
  },
