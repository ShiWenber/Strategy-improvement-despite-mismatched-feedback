  "child": {
    "name": "seed3-rank3-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    remaining = 100 - n\n\n    # Unconditional cooperator detection and sustained exploitation.\n    if n >= 4:\n        if opp.count('D') == 0:\n            if remaining <= 2:\n                return 'D'\n            return 'D'\n\n    # Unconditional defector detection.\n    if n >= 3:\n        if opp.count('C') == 0:\n            return 'D'\n\n    # Endgame: defect in final rounds when facing a cooperator.\n    if remaining <= 1:\n        return 'D'\n    if remaining <= 3:\n        if opp[-3:].count('C') >= 2:\n            return 'D'\n        return 'D'\n\n    # Detect very recent cooperation streak from opponent.\n    last_opp = opp[-1]\n    coop_rate = opp.count('C') / n\n\n    # Compute recent cooperation rate over last 8 rounds.\n    k8 = 8 if n >= 8 else n\n    recent8 = opp[-k8:]\n    recent_coop8 = recent8.count('C')\n    recent_rate8 = recent_coop8 / k8\n\n    # Opponent highly cooperative: exploit moderately but mostly cooperate.\n    if recent_rate8 >= 0.875 and n >= 8:\n        # Exploit more often if they never retaliate.\n        if recent_coop8 == k8:\n            # They always cooperate recently. Probe every few rounds.\n            if remaining > 6 and rng.random() < 0.28:\n                return 'D'\n            return 'C'\n        if remaining > 5 and rng.random() < 0.12:\n            return 'D'\n        return 'C'\n\n    # Opponent very uncooperative recently: defend.\n    if recent_rate8 <= 0.25:\n        return 'D'\n\n    # Tit-for-tat core with forgiveness to escape DD traps.\n    if last_opp == 'D':\n        # Count consecutive recent defections by opponent.\n        cd = 0\n        i = n - 1\n        while i >= 0 and opp[i] == 'D':\n            cd += 1\n            i -= 1\n        if cd >= 3:\n            return 'D'\n        # If opponent overall fairly cooperative, forgive earlier.\n        if coop_rate >= 0.55 and rng.random() < 0.32:\n            return 'C'\n        if rng.random() < 0.12:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    # If we defected last round and they still cooperated, they are exploitable.\n    if me[-1] == 'D' and last_opp == 'C':\n        if coop_rate >= 0.6 and remaining > 4:\n            if rng.random() < 0.45:\n                return 'D'\n        return 'C'\n\n    # Mild probing against passive cooperators.\n    if coop_rate >= 0.75 and remaining > 10:\n        if rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Default cooperate to sustain CC.\n    return 'C'"
  },
