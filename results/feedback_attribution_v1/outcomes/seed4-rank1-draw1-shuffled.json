  "child": {
    "name": "seed4-rank1-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Count outcomes\n    cc = cd = dc = dd = 0\n    for me, op in history:\n        if me == 'C':\n            if op == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_C = cc + dc\n    opp_D = cd + dd\n    my_C = cc + cd\n    my_D = dc + dd\n    last_me, last_op = history[-1]\n\n    # Detect pure cooperator: cooperate to build mutual score, few endgame defections\n    if n >= 5 and opp_D == 0:\n        # Slight endgame exploitation in final round only\n        if n >= 99:\n            return 'D'\n        return 'C'\n\n    # Detect pure/near-pure defector: defect hard, occasional probe\n    if n >= 5 and opp_C <= 1:\n        if n >= 99:\n            return 'D'\n        if n % 19 == 0:\n            return 'C'\n        return 'D'\n\n    # Very high cooperation rate: stay cooperative, retaliate only vs repeated defection\n    if n >= 6 and opp_C * 10 >= n * 9:\n        if n >= 99:\n            return 'D'\n        if last_op == 'D':\n            # Check recent defection count\n            r = history[-5:]\n            rd = sum(1 for _, o in r if o == 'D')\n            if rd >= 2:\n                return 'D'\n            # Forgive once\n            return 'C'\n        return 'C'\n\n    # Very low cooperation: defect, occasional probes\n    if n >= 6 and opp_C * 4 <= n:\n        if n >= 95:\n            return 'D'\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # Mirror detection: does opponent mirror our previous move?\n    if n >= 8:\n        hits = 0\n        for i in range(1, n):\n            if history[i][1] == history[i - 1][0]:\n                hits += 1\n        if hits * 4 >= (n - 1) * 3:\n            # Facing mirror-like opponent. Exploit at tail, but maintain cooperation.\n            # Cooperative play gives 3/round; occasional defection steals 5 but triggers retaliation.\n            # Best: cooperate mostly, defect only in final round(s).\n            if n >= 99:\n                return 'D'\n            if n >= 98 and opp_C * 2 >= n:\n                return 'D'\n            return 'C'\n\n    # Recent window analysis\n    if n >= 6:\n        window = history[-8:]\n        wn = len(window)\n        rc = sum(1 for _, o in window if o == 'C')\n        rd = wn - rc\n    else:\n        rc = opp_C\n        rd = opp_D\n        wn = n\n\n    # Mutual cooperation streak -> keep cooperating\n    if last_op == 'C' and last_me == 'C':\n        if rc * 2 >= wn:\n            if n >= 99:\n                return 'D'\n            return 'C'\n\n    # Opponent just defected\n    if last_op == 'D':\n        # Streak of opponent defections\n        streak = 0\n        for _, o in reversed(history):\n            if o == 'D':\n                streak += 1\n            else:\n                break\n        if streak >= 3:\n            return 'D'\n        # Recently mostly cooperative: forgive once\n        if rc * 2 > wn:\n            return 'C'\n        # Otherwise retaliate\n        return 'D'\n\n    # opponent just cooperated, we defected last -> return to cooperation\n    if last_me == 'D' and last_op == 'C':\n        return 'C'\n\n    # Default: cooperate if recent cooperation is reasonable\n    if rc * 5 >= wn * 3:\n        if n >= 99:\n            return 'D'\n        return 'C'\n\n    # Moderate defection: mixed response\n    if n >= 95:\n        return 'D'\n    if rng.random() < 0.25:\n        return 'C'\n    return 'D'"
  },
