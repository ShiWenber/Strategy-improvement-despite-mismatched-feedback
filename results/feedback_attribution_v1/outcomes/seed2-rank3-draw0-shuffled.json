  "child": {
    "name": "seed2-rank3-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Count opponent history\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    opp_d = sum(1 for x in opp if x == 'D')\n    opp_c = n - opp_d\n    my_d = sum(1 for x in me if x == 'D')\n\n    last_me = me[-1]\n    last_opp = opp[-1]\n\n    # Last 10 window\n    w = min(10, n)\n    rec_opp = opp[-w:]\n    rec_opp_d = sum(1 for x in rec_opp if x == 'D')\n\n    # Last 5 window\n    w5 = min(5, n)\n    rec5_opp_d = sum(1 for x in opp[-w5:] if x == 'D')\n\n    # Detect pure cooperator\n    if opp_d == 0:\n        # Exploit at end game and occasionally test\n        if n >= 95:\n            return 'D'\n        if n >= 20 and rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    # Defect at very end against anyone (last 1-2 rounds)\n    if n >= 99:\n        return 'D'\n\n    # Detect pure/near-pure defector\n    if opp_d >= 4 and opp_c <= 1:\n        # Punish hard\n        if rng.random() < 0.92:\n            return 'D'\n        return 'C'\n\n    # Endgame exploitation (last 3 rounds): if opponent mostly cooperative, defect\n    if n >= 97:\n        if opp_d <= n * 0.25:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Strongly defective opponent - always defect\n    if opp_d * 2 > n:\n        return 'D'\n\n    # Noisy/mostly cooperative opponent - tit for tat with forgiveness\n    if opp_d * 4 < n:\n        # Mostly cooperative: cooperate but retaliate defections\n        if last_opp == 'D':\n            if rec_opp_d >= 3:\n                return 'D'\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        if last_me == 'D':\n            return 'C'\n        # Occasional probe in midgame\n        if 20 <= n < 90 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Mixed opponent\n    if last_opp == 'D':\n        if rec5_opp_d >= 3:\n            return 'D'\n        if rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # last_opp == 'C'\n    if last_me == 'D':\n        # repair\n        if my_d > opp_d + 2 and rng.random() < 0.3:\n            return 'D'\n        return 'C'\n    if rec_opp_d >= 3:\n        return 'D'\n    return 'C'"
  },
