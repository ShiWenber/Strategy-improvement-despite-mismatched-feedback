  "child": {
    "name": "seed2-rank1-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    if n == 2:\n        return 'C' if history[-1][1] == 'C' else 'D'\n\n    rounds_left = 100 - n\n\n    # Scan counts once\n    opp_c = 0\n    opp_d = 0\n    for h in history:\n        if h[1] == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n\n    # Recent window\n    w = 8 if n >= 8 else n\n    rec_opp_d = 0\n    for h in history[-w:]:\n        if h[1] == 'D':\n            rec_opp_d += 1\n\n    last_me, last_opp = history[-1]\n    prev_opp = history[-2][1]\n\n    # Opponent basically always defects -> pure defect\n    if opp_d >= 4 and opp_c <= 1:\n        return 'D'\n\n    # Opponent basically always cooperates\n    if opp_d == 0:\n        # Pure cooperator: take advantage near the end strongly\n        if rounds_left <= 4:\n            return 'D'\n        if rounds_left <= 10 and rng.random() < 0.5:\n            return 'D'\n        if last_me == 'D':\n            return 'C'\n        return 'C'\n\n    # Opponent recently very cooperative\n    if rec_opp_d == 0 and n >= 5:\n        if rounds_left <= 2:\n            return 'D'\n        if last_me == 'D':\n            return 'C'\n        if rounds_left <= 6 and rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Endgame exploitation\n    if rounds_left <= 1:\n        return 'D'\n    if rounds_left <= 3:\n        if opp_d == 0:\n            return 'D'\n        if rng.random() < 0.7:\n            return 'D'\n        return 'C'\n    if rounds_left <= 6:\n        if opp_d * 4 <= n:\n            return 'D' if rng.random() < 0.75 else 'C'\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Main phase: conditional cooperation with retaliation\n    if last_opp == 'D':\n        # If opponent rarely defects, occasionally forgive\n        if prev_opp == 'C' and opp_d <= max(1, n // 5):\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        # If we've been defecting too long, try to reset\n        if last_me == 'D' and prev_opp == 'D':\n            if opp_d * 3 < n:\n                return 'C'\n        return 'D'\n\n    # Opponent cooperated last\n    if last_me == 'D':\n        # We defected and they cooperated -> exploit chance if pure-ish cooperator\n        if opp_d == 0:\n            return 'D' if rng.random() < 0.3 else 'C'\n        if opp_d <= max(1, n // 10):\n            return 'D' if rng.random() < 0.2 else 'C'\n        return 'C'\n\n    # Both cooperated\n    if opp_d * 4 > n:\n        if rng.random() < 0.6:\n            return 'D'\n        return 'C'\n    if opp_d * 3 > n:\n        if rng.random() < 0.3:\n            return 'D'\n        return 'C'\n    if rec_opp_d >= 2:\n        return 'D' if rng.random() < 0.4 else 'C'\n    if n >= 15 and rng.random() < 0.03:\n        return 'D'\n    return 'C'"
  },
