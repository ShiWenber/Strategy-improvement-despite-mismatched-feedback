  "child": {
    "name": "seed0-rank6-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    last_opp = opp[-1]\n    last_my = my[-1]\n\n    # Mutual defection loop breaker\n    if n >= 5:\n        recent5 = history[-5:]\n        dd = sum(1 for m, o in recent5 if m == 'D' and o == 'D')\n        if dd >= 4:\n            return 'C'\n\n    # All-cooperator detection: milk near the end\n    if opp_d == 0:\n        if n >= 92 and n < 99:\n            return 'D'\n        return 'C'\n\n    # Pure defector\n    if opp_c == 0:\n        return 'D'\n\n    # Endgame\n    if n >= 95:\n        if opp_d * 3 > n:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        if opp_d * 5 > n:\n            if rng.random() < 0.5:\n                return 'D'\n        return 'C'\n\n    # Recent window stats\n    w = 12 if n >= 12 else n\n    rec_opp = opp[-w:]\n    rec_d = rec_opp.count('D')\n    rec_c = w - rec_d\n\n    # Opponent mostly defecting recently -> defect\n    if rec_d * 5 >= w * 4:\n        return 'D'\n\n    # Opponent mostly cooperating -> cooperate, rare probes\n    if rec_d == 0:\n        if n >= 20 and n < 90 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Respond to last move (TFT-with-forgiveness core)\n    if last_opp == 'D':\n        # If opponent rarely defects overall, forgive\n        if opp_d * 5 <= n and rng.random() < 0.4:\n            return 'C'\n        # If we are in mutual defection and opponent mostly cooperative overall, try reset\n        if last_my == 'D' and opp_c * 2 > n and rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    # last_opp == 'C'\n    if last_my == 'D':\n        return 'C'\n    # both cooperated\n    if opp_d * 5 <= n:\n        return 'C'\n    if opp_d * 3 > n:\n        if rng.random() < 0.5:\n            return 'D'\n    return 'C'"
  },
