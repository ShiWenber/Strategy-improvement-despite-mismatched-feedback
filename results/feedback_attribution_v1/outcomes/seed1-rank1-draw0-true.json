    "name": "seed1-rank1-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    my_c = my.count('C')\n    my_d = n - my_c\n\n    # Endgame: exploit a cooperative opponent hard, otherwise protect.\n    remaining = 100 - n\n    if remaining <= 2:\n        if opp_c * 2 >= n:\n            return 'D'\n        return 'D'\n    if remaining <= 5:\n        if opp_c > opp_d:\n            return 'D'\n        return 'D'\n\n    # Early: establish cooperation, punish immediate defection.\n    if n < 4:\n        if opp[-1] == 'D':\n            return 'D'\n        return 'C'\n\n    # Opponent totally defective: defend.\n    if opp_c == 0:\n        return 'D'\n\n    # Opponent totally cooperative: cooperate, occasional calibrated exploit.\n    if opp_d == 0:\n        # Exploit rarely early, more often mid, but keep it sustainable.\n        if n >= 20 and remaining > 15:\n            if n % 9 == 8:\n                return 'D'\n        return 'C'\n\n    # Highly exploitative opponents: defect.\n    if opp_d * 2 >= n + 2:\n        return 'D'\n\n    # Recent cooperation rate.\n    k = min(n, 10)\n    recent_opp = opp[-k:]\n    recent_c = recent_opp.count('C')\n    recent_d = k - recent_c\n\n    # Opponent defecting recently a lot.\n    if recent_d >= 7:\n        return 'D'\n\n    # Opponent cooperated a lot recently: reward cooperation.\n    if recent_c >= 8 and n >= 10:\n        # Small exploit against naive cooperators mid-game.\n        if remaining > 10:\n            if n % 11 == 10:\n                return 'D'\n            return 'C'\n\n    # Mostly cooperative overall and last move D as isolated event: forgive.\n    if opp_c * 4 >= n * 3:\n        if opp[-1] == 'D':\n            # Retaliate short then forgive.\n            if n >= 2 and opp[-2] == 'D' and n >= 3 and opp[-3] == 'D':\n                return 'D'\n            if rng.random() < 0.2:\n                return 'D'\n            return 'C'\n        return 'C'\n\n    # Mixed opponent: tit-for-tat with forgiveness.\n    if opp[-1] == 'D':\n        # Defect, but if opponent has shown recent cooperation, sometimes forgive.\n        if recent_c >= 5 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent just cooperated.\n    # Avoid getting stuck: if we just defected, return to cooperation.\n    if my[-1] == 'D':\n        return 'C'\n    return 'C'"
  },
