  "child": {
    "name": "seed4-rank3-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Fast counters\n    opp_c = 0\n    opp_d = 0\n    cc = 0\n    cd = 0\n    dc = 0\n    for me, op in history:\n        if op == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if me == 'C':\n            if op == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n\n    # Endgame: last round, exploit a known defector or a pure cooperator.\n    if n >= 99:\n        if opp_d == 0:\n            return 'D'\n        return 'D' if opp_d * 3 >= n else 'C'\n\n    last_me, last_op = history[-1]\n\n    # Opening: cooperate a bit, then adapt.\n    if n < 3:\n        return 'C'\n\n    # If opponent never defected, mostly cooperate but occasionally probe late.\n    if opp_d == 0:\n        if n >= 70 and rng.random() < 0.07:\n            return 'D'\n        return 'C'\n\n    opp_rate = opp_c / n\n    recent = history[-8:] if n >= 8 else history\n    recent_opp_c = sum(1 for a, b in recent if b == 'C')\n    recent_opp_d = len(recent) - recent_opp_c\n\n    # Persistent defector: punish hard, with rare tests.\n    if opp_rate <= 0.2 and n >= 8:\n        if n % 13 == 0 and rng.random() < 0.5:\n            return 'C'\n        return 'D'\n\n    # Persistent cooperator: exploit opportunistically, keep them cooperating.\n    if opp_rate >= 0.9 and opp_d <= 2 and n >= 10:\n        if recent_opp_d == 0:\n            if rng.random() < 0.25:\n                return 'D'\n            return 'C'\n        return 'D'\n\n    # If heavily exploited, be defensive.\n    if cd > cc + 2 and recent_opp_c <= 3:\n        return 'D'\n\n    # If opponent defected last round, retaliate, but forgive if they were mainly cooperative.\n    if last_op == 'D':\n        if opp_rate >= 0.75 and recent_opp_d <= 2:\n            if rng.random() < 0.6:\n                return 'C'\n            return 'D'\n        if opp_rate <= 0.35:\n            return 'D'\n        # Medium: tit-for-tat with some forgiveness.\n        if rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    if last_me == 'D':\n        # Return to cooperation to rebuild trust, unless they're an exploiter.\n        if opp_rate >= 0.4:\n            return 'C'\n        return 'D' if recent_opp_c <= 2 else 'C'\n\n    # Opponent is mostly cooperative recently: keep cooperating.\n    if recent_opp_c >= 6:\n        return 'C'\n\n    # If they have defected a lot recently, defect more.\n    if recent_opp_d >= 4:\n        return 'D' if rng.random() < 0.85 else 'C'\n\n    # Mixed: use tit-for-tat with a slight bias to cooperation.\n    return 'C' if rng.random() < 0.8 else 'D'"
  },
