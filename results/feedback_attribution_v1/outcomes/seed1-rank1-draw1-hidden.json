    "name": "seed1-rank1-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    remaining = 100 - n\n\n    # Endgame: exploit a likely cooperator, otherwise protect.\n    if remaining <= 1:\n        if opp_c > opp_d:\n            return 'D'\n        return 'D'\n    if remaining <= 3:\n        if opp_c * 2 > n:\n            return 'D'\n        return 'D'\n\n    # Count trailing streaks.\n    opp_d_streak = 0\n    for x in reversed(opp):\n        if x == 'D':\n            opp_d_streak += 1\n        else:\n            break\n    my_d_streak = 0\n    for x in reversed(my):\n        if x == 'D':\n            my_d_streak += 1\n        else:\n            break\n\n    last_my = my[-1]\n    last_opp = opp[-1]\n\n    # Mutual defection spiral - extend olive branch sometimes if opponent cooperative historically.\n    if last_my == 'D' and last_opp == 'D':\n        if opp_c * 2 >= n and rng.random() < 0.35:\n            return 'C'\n        if my_d_streak >= 4 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Very cooperative opponent: mostly cooperate, occasional probe far from endgame.\n    if opp_d <= max(0, n // 20):\n        if opp_d_streak >= 2:\n            return 'D'\n        if remaining > 20 and rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    # Mostly defective opponent: defend.\n    if opp_d * 2 > n:\n        # But try rare olive branch to invite cooperation.\n        if opp_d_streak >= 3 and my_d_streak >= 2 and rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    # Last opponent move related logic.\n    if last_opp == 'C':\n        # Reward opponent cooperation.\n        if last_my == 'D':\n            return 'C'\n        # Maintain cooperation, but occasionally probe when safe.\n        if remaining > 15 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Opponent defected last round.\n    if opp_d_streak >= 2:\n        # More punishment.\n        if opp_d_streak >= 4 and my_d_streak >= 4:\n            if rng.random() < 0.15:\n                return 'C'\n        return 'D'\n\n    # Single defection: retaliate once, with forgiveness chance if opponent mostly cooperative.\n    if opp_d_streak == 1:\n        # If opponent has been cooperative enough, forgive occasionally.\n        if opp_c * 3 >= n * 2 and rng.random() < 0.25:\n            return 'C'\n        # Otherwise, retaliate.\n        return 'D'\n\n    return 'C'"
  },
