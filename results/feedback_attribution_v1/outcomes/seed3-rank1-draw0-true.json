  "child": {
    "name": "seed3-rank1-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    def opp(i):\n        return history[i][1]\n\n    def me(i):\n        return history[i][0]\n\n    remaining = 100 - n\n\n    # Endgame: grab exploitation value when little time remains to be punished.\n    if remaining <= 1:\n        return 'D'\n\n    last_opp = opp(n - 1)\n    last_me = me(n - 1)\n\n    # Score-aware aggression: if we've been exploited more than we've exploited.\n    opp_c = 0\n    opp_d = 0\n    my_d = 0\n    for i in range(n):\n        if opp(i) == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if me(i) == 'D':\n            my_d += 1\n\n    # If opponent is nearly always cooperative, exploit but keep them around.\n    if opp_d == 0:\n        if remaining > 6 and n >= 3:\n            # Exploit occasionally, otherwise keep the CC stream going.\n            if rng.random() < 0.35 and my_d < n * 0.2:\n                return 'D'\n        return 'C'\n\n    # If opponent is essentially always defecting, minimize damage.\n    if opp_c == 0:\n        return 'D'\n\n    # Opponent just defected: retaliate, but offer occasional forgiveness.\n    if last_opp == 'D':\n        if n == 1:\n            return 'D'\n        if last_me == 'C':\n            # We were exploited. Retaliate; forgive rarely if opponent has been\n            # mostly cooperative overall and only recently deviated.\n            if opp_d <= 1 + n // 10 and rng.random() < 0.30:\n                return 'C'\n            return 'D'\n        # We already defected last round; check for mutual defection cycles.\n        run_d = 0\n        j = n - 1\n        while j >= 0 and opp(j) == 'D':\n            run_d += 1\n            j -= 1\n        # If long mutual defection, occasionally probe cooperation.\n        if run_d >= 3:\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent just cooperated.\n    if n == 1:\n        return 'C'\n\n    # If our last move was D and they cooperated, we may have exploited them.\n    # Decide whether to keep exploiting or repair.\n    if last_me == 'D':\n        # Exploit more if they seem very forgiving (cooperated right after our D).\n        # Track how often they cooperate after our defections.\n        forgive = 0\n        punish = 0\n        for i in range(1, n):\n            if me(i - 1) == 'D':\n                if opp(i) == 'C':\n                    forgive += 1\n                else:\n                    punish += 1\n        if forgive + punish >= 2:\n            forgiveness_rate = forgive / float(forgive + punish)\n        else:\n            forgiveness_rate = 0.5\n        if forgiveness_rate >= 0.6 and remaining > 4:\n            # Exploit a bit more, but don't burn them completely.\n            if rng.random() < 0.4:\n                return 'D'\n            return 'C'\n        # Otherwise repair by cooperating.\n        return 'C'\n\n    # Both cooperated last round. Keep cooperating, occasionally probe exploitable\n    # opponents, and avoid probing too close to end (punishment window small there\n    # but cooperation value still matters).\n    coop_rate = opp_c / float(n)\n\n    # Very cooperative opponent: rare probing to extract DC.\n    if coop_rate >= 0.9:\n        if remaining > 15 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Moderately cooperative: cooperate, but if we've been too nice recently,\n    # probe to discourage them from exploiting us in the future.\n    if coop_rate >= 0.55:\n        recent_my_d = 0\n        k = n if n < 8 else 8\n        for i in range(n - k, n):\n            if me(i) == 'D':\n                recent_my_d += 1\n        if recent_my_d == 0 and remaining > 10 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # Opponent is mixed/aggressive: be more cautious and retaliatory.\n    if coop_rate >= 0.35:\n        # Tit-for-tat-ish with occasional random defection to test.\n        recent_opp_c = 0\n        k = n if n < 6 else 6\n        for i in range(n - k, n):\n            if opp(i) == 'C':\n                recent_opp_c += 1\n        if recent_opp_c >= 4:\n            if rng.random() < 0.10:\n                return 'D'\n            return 'C'\n        if rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Low cooperation opponent: defect more to avoid being exploited.\n    if rng.random() < 0.8:\n        return 'D'\n    return 'C'"
  },
