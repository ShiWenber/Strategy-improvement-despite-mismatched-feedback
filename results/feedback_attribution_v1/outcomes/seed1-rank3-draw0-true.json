  "child": {
    "name": "seed1-rank3-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Gather opponent moves compactly.\n    opp = [h[1] for h in history]\n    mine = [h[0] for h in history]\n    last_opp = opp[-1]\n    last_me = mine[-1]\n    remaining = 100 - n\n\n    # Count patterns of opponent's response to our actions.\n    cc = cd = dc = dd = 0\n    for i in range(n):\n        m = mine[i]\n        o = opp[i]\n        if m == 'C':\n            if o == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if o == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    coop_rate = opp_c / n\n    coop_after_c = cc / (cc + cd) if (cc + cd) > 0 else 0.5\n    coop_after_d = dc / (dc + dd) if (dc + dd) > 0 else 0.5\n\n    # Endgame exploitation: defect on the last few rounds regardless.\n    if remaining <= 4:\n        return 'D'\n\n    # If opponent is basically always cooperating, exploit hard but not too early.\n    if opp_d == 0:\n        if remaining > 20:\n            # Occasional probe to test whether they punish.\n            if n >= 4 and rng.random() < 0.08:\n                return 'D'\n            return 'C'\n        # In the final stretch vs unconditional cooperator, defect a lot.\n        if remaining <= 12:\n            return 'D'\n        if rng.random() < 0.35:\n            return 'D'\n        return 'C'\n\n    # Opponent almost always defects: minimize losses with D.\n    if coop_rate < 0.2:\n        # Small chance to cooperate to test for hidden willingness.\n        if n < 50 and rng.random() < 0.04:\n            return 'C'\n        return 'D'\n\n    # Mutual cooperation streak handling.\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if mine[i] == 'C' and opp[i] == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Detect opponent defect streak.\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Our own defect streak.\n    me_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if mine[i] == 'D':\n            me_d_streak += 1\n        else:\n            break\n\n    # Strong cooperative opponent: reward, with rare probes.\n    if coop_rate >= 0.85:\n        if cc_streak >= 8:\n            # Occasional probe once in a long while to avoid being fully exploited-safe.\n            if n % 23 == 0 and remaining > 15:\n                return 'D'\n            return 'C'\n        if last_opp == 'D':\n            # Forgive rare defection if opponent has been very cooperative.\n            if coop_rate > 0.9 and opp_d_streak == 1 and rng.random() < 0.6:\n                return 'C'\n            return 'D'\n        return 'C'\n\n    # Highly retaliatory opponent (cooperates only after our C).\n    retaliatory = coop_after_c > 0.75 and coop_after_d < 0.25\n    forgiving = coop_after_d >= 0.5\n\n    # If opponent tends to punish our defections, keep cooperating once we\n    # are in mutual cooperation, unless it is safe to exploit late.\n    if retaliatory:\n        if last_opp == 'C':\n            if cc_streak >= 5 and remaining > 8:\n                # Rare probe only far from end.\n                if rng.random() < 0.02:\n                    return 'D'\n                return 'C'\n            return 'C'\n        # Opponent defected: defect back exactly once, then return to C.\n        if me_d_streak >= 1:\n            # We already retaliated; try to restore cooperation.\n            if coop_rate > 0.6 and rng.random() < 0.7:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Forgiving opponent: exploit it somewhat more aggressively but maintain\n    # mutual cooperation most of the time.\n    if forgiving and coop_rate > 0.5:\n        if cc_streak >= 6:\n            if remaining > 12 and rng.random() < 0.06:\n                return 'D'\n            return 'C'\n        if last_opp == 'D':\n            if opp_d_streak == 1 and rng.random() < 0.5:\n                return 'C'\n            return 'D'\n        if last_me == 'D' and last_opp == 'C':\n            return 'C'\n        return 'C'\n\n    # Mixed/unknown opponent: robust tit-for-tat with calibrated forgiveness\n    # and limited exploitation near the end.\n    if coop_rate > 0.65:\n        if last_opp == 'C':\n            if cc_streak >= 4 and remaining > 15 and rng.random() < 0.05:\n                return 'D'\n            return 'C'\n        # Opponent defected.\n        if opp_d_streak == 1 and coop_rate > 0.7 and rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    if coop_rate > 0.4:\n        if last_opp == 'C':\n            if cc_streak >= 3 and remaining > 20 and rng.random() < 0.08:\n                return 'D'\n            return 'C'\n        if opp_d_streak >= 3:\n            return 'D'\n        if opp_d_streak == 1 and rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Low-cooperation opponent: defect most of the time, occasional probe.\n    if n < 60 and rng.random() < 0.05:\n        return 'C'\n    return 'D'"
  },
