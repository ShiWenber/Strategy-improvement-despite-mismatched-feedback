  "child": {
    "name": "seed3-rank3-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    remaining = 100 - n\n\n    # Last few rounds: exploit heavily.\n    if remaining <= 2:\n        # Against an always-cooperator, take DC.\n        if opp.count('D') == 0:\n            return 'D'\n        return 'D'\n\n    # Always-defect opponent: defect.\n    if opp.count('C') == 0:\n        return 'D'\n\n    # Always-cooperate opponent: cooperate mostly, probe very rarely early.\n    if opp.count('D') == 0:\n        if remaining > 15 and n > 10 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Near end but still enough room: greed.\n    if remaining <= 5:\n        recent_opp = opp[-6:]\n        if recent_opp.count('D') == 0:\n            return 'D'\n        if recent_opp.count('C') >= 4:\n            return 'D'\n        return 'D'\n\n    # Track recent behavior.\n    k = n if n < 12 else 12\n    recent_opp = opp[-k:]\n    recent_my = my[-k:]\n    recent_opp_c = recent_opp.count('C')\n    recent_opp_d = k - recent_opp_c\n    recent_my_d = recent_my.count('D')\n\n    # Compute opponent's response to our defections: if they keep cooperating,\n    # we can exploit; if they punish, back off.\n    my_def_response_c = 0\n    my_def_response_n = 0\n    start = n - k\n    if start < 0:\n        start = 0\n    for i in range(1, n):\n        if my[i - 1] == 'D':\n            my_def_response_n += 1\n            if opp[i] == 'C':\n                my_def_response_c += 1\n\n    last_opp = opp[-1]\n    last_my = my[-1]\n\n    # If opponent just defected, retaliate, but be ready to forgive.\n    if last_opp == 'D':\n        # Count recent consecutive opponent defections.\n        consec_d = 0\n        for i in range(n - 1, -1, -1):\n            if opp[i] == 'D':\n                consec_d += 1\n            else:\n                break\n        # If opponent has been mostly cooperative, only punish briefly.\n        if recent_opp_c >= k - 2:\n            if consec_d <= 1:\n                return 'D'\n            if consec_d == 2:\n                return 'D' if rng.random() < 0.7 else 'C'\n            return 'C' if rng.random() < 0.4 else 'D'\n        # If opponent is defecting a lot, keep defecting.\n        return 'D'\n\n    # Opponent just cooperated.\n    # If we defected last round and they cooperated, they may be forgiving.\n    if last_my == 'D':\n        if my_def_response_n > 0:\n            forgiveness = my_def_response_c / my_def_response_n\n        else:\n            forgiveness = 0.0\n        # Exploit forgiving opponents.\n        if forgiveness >= 0.75 and remaining > 8:\n            if rng.random() < 0.55:\n                return 'D'\n        # Otherwise return to cooperation to rebuild trust.\n        return 'C'\n\n    # Both cooperated last round.\n    # Check if opponent looks exploitable: they cooperate after our defections.\n    if my_def_response_n >= 2:\n        forgiveness = my_def_response_c / my_def_response_n\n        if forgiveness >= 0.8 and remaining > 10:\n            if rng.random() < 0.25:\n                return 'D'\n        elif forgiveness <= 0.3:\n            # Opponent retaliates strongly; cooperate to keep CC going.\n            pass\n\n    # If opponent has been very cooperative recently, occasionally probe.\n    if recent_opp_d == 0:\n        if remaining > 15 and n >= 6 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # If opponent has been defecting a fair amount recently, be cautious.\n    if recent_opp_d >= 3:\n        # If we've also been defecting a lot, try a cooperation reset.\n        if recent_my_d >= 3 and rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    # Mild mixed state: mostly cooperate.\n    if rng.random() < 0.08 and remaining > 12:\n        return 'D'\n    return 'C'"
  },
