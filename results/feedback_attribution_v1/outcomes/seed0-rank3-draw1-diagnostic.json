  "child": {
    "name": "seed0-rank3-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    # Full cooperation: keep cooperating\n    if opp_d == 0:\n        return 'C'\n    # Mostly defecting: defect\n    if opp_d >= (n + 1) // 2:\n        return 'D'\n    # Long defection run: punish\n    run = 0\n    for a in reversed(opp):\n        if a == 'D':\n            run += 1\n        else:\n            break\n    if run >= 3:\n        return 'D'\n    last_opp = opp[-1]\n    last_my = my[-1]\n    if last_opp == 'C':\n        # If opponent just cooperated after a defection streak, reciprocate\n        if n >= 2 and opp[-2] == 'D':\n            # They're trying to restore cooperation; reciprocate but watch\n            if run == 0:\n                recent_d = opp[-5:].count('D')\n                if recent_d >= 3:\n                    return 'D' if rng.random() < 0.4 else 'C'\n                return 'C'\n        # Both cooperated - stay cooperative, but exploit rare pure cooperators late\n        if n >= 20 and opp_c == n and 30 < n < 90 and rng.random() < 0.1:\n            return 'D'\n        return 'C'\n    # last_opp == 'D'\n    if last_my == 'D':\n        # Mutual defection: try to recover cooperation periodically\n        if rng.random() < 0.4:\n            return 'C'\n        return 'D'\n    # Opponent defected while we cooperated: retaliate, but forgive if they're mostly nice\n    if opp_c > 2 * opp_d and n >= 5:\n        if rng.random() < 0.3:\n            return 'C'\n    return 'D'"
  },
