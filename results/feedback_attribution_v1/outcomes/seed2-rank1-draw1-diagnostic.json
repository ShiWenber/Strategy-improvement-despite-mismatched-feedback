    "name": "seed2-rank1-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n\n    coop = 0\n    defd = 0\n    for h in history:\n        if h[1] == 'C':\n            coop += 1\n        else:\n            defd += 1\n\n    tail = history[-min(5, n):]\n    tail_c = 0\n    tail_d = 0\n    for h in tail:\n        if h[1] == 'C':\n            tail_c += 1\n        else:\n            tail_d += 1\n\n    if defd >= 3 and defd * 2 > coop:\n        return 'D'\n\n    if coop >= 3 and coop * 2 >= defd * 3:\n        if n >= 90 and rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    if n > 0:\n        last_opp = history[-1][1]\n        if last_opp == 'D':\n            if tail_d <= 1 and coop >= 2 and rng.random() < 0.12:\n                return 'C'\n            return 'D'\n        else:\n            if n >= 85 and rng.random() < 0.06:\n                return 'D'\n            return 'C'\n\n    return 'C'"
  },
