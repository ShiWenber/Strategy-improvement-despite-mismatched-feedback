    "name": "seed1-rank3-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Initialize counts\n    cc = cd = dc = dd = 0\n    my_defects = 0\n    opp_defects = 0\n    for m, o in history:\n        if m == 'C':\n            if o == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            my_defects += 1\n            if o == 'C':\n                dc += 1\n            else:\n                dd += 1\n        if o == 'D':\n            opp_defects += 1\n\n    remaining = 100 - n\n    last_me, last_opp = history[-1]\n\n    # Detect mutual cooperation streak\n    cc_streak = 0\n    for m, o in reversed(history):\n        if m == 'C' and o == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Detect opponent defect streak\n    opp_d_streak = 0\n    for m, o in reversed(history):\n        if o == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Detect opponent cooperation streak\n    opp_c_streak = 0\n    for m, o in reversed(history):\n        if o == 'C':\n            opp_c_streak += 1\n        else:\n            break\n\n    opp_coop_rate = (cc + dc) / n\n    exploitable = opp_coop_rate > 0.85\n    punishing = False\n    if n >= 6:\n        # If opponent retaliates strongly to our defection\n        if dd + dc > 0:\n            coop_after_d = dc / (dc + dd)\n            if coop_after_d < 0.25 and dd >= 2:\n                punishing = True\n\n    # EARLY GAME: establish cooperation, but punish immediate defection\n    if n < 6:\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # ENDGAME: calibrated exploitation\n    if remaining <= 1:\n        return 'D'\n    if remaining <= 3:\n        if exploitable or opp_coop_rate > 0.6:\n            return 'D'\n        if opp_defects * 2 > n:\n            return 'D'\n        # If opponent just cooperated, exploit\n        if last_opp == 'C':\n            return 'D'\n        return 'C'\n    if remaining <= 6:\n        if last_opp == 'C':\n            return 'D'\n        if opp_coop_rate > 0.5:\n            return 'D'\n        return 'C'\n\n    # If opponent is almost always cooperating, cooperate but occasionally\n    # exploit while there's a long horizon\n    if exploitable and remaining > 15:\n        if remaining > 30 and cc_streak >= 5 and rng.random() < 0.08:\n            return 'D'\n        if cc_streak >= 8 and remaining > 20 and rng.random() < 0.12:\n            return 'D'\n        return 'C'\n\n    # If opponent is mostly defecting, defect\n    if opp_coop_rate < 0.25:\n        if remaining > 10 and rng.random() < 0.05:\n            return 'C'\n        return 'D'\n\n    # If opponent just defected:\n    if last_opp == 'D':\n        # Long defection streak: keep defecting\n        if opp_d_streak >= 3:\n            # But occasionally try to break spiral if they've shown cooperation\n            if opp_coop_rate > 0.4 and rng.random() < 0.1:\n                return 'C'\n            return 'D'\n        # If opponent is generally cooperative, forgive single defection\n        if opp_coop_rate > 0.7 and rng.random() < 0.5:\n            return 'C'\n        if opp_coop_rate > 0.5 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent just cooperated\n    if last_me == 'D':\n        # Return to cooperation unless opponent is highly exploitative\n        if opp_coop_rate > 0.35:\n            return 'C'\n        # Otherwise exploit a bit more\n        if rng.random() < 0.3:\n            return 'D'\n        return 'C'\n\n    # Both cooperated: maintain mutual cooperation\n    if cc_streak >= 4 and remaining > 10:\n        # Safe environment; occasionally probe for exploitation\n        if rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # If we've been defecting a lot, return to cooperation to restore relationship\n    if my_defects > (n * 2) // 3 and n > 15:\n        return 'C'\n\n    return 'C'"
  },
