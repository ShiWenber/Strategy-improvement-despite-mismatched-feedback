    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    opp_last = history[-1][1]\n    my_last = history[-1][0]\n    if n < 3:\n        return 'C'\n    if n >= 96:\n        opp_c_all = sum(1 for a, b in history if b == 'C')\n        if opp_c_all * 100 < n * 45:\n            return 'D'\n        return 'D'\n    opp_c = sum(1 for a, b in history if b == 'C')\n    my_c = sum(1 for a, b in history if a == 'C')\n    last8 = history[-8:]\n    opp_recent = sum(1 for a, b in last8 if b == 'C')\n    last4 = history[-4:]\n    opp4 = sum(1 for a, b in last4 if b == 'C')\n    r4 = rng.random()\n    if n >= 6:\n        if opp_last == 'D' and history[-2][1] == 'D':\n            if opp_recent <= 4:\n                return 'D'\n    if n >= 12 and opp_recent <= 2:\n        return 'D'\n    if n >= 25 and opp_c * 100 <= n * 30:\n        return 'D'\n    if n >= 40 and opp_c * 100 <= n * 45:\n        return 'D'\n    if n >= 60:\n        if opp_c * 100 <= n * 60:\n            if opp4 <= 2:\n                return 'D'\n    if n >= 30 and my_c * 100 < n * 20 and opp_recent >= 6:\n        return 'D'\n    if opp_last == 'C':\n        if opp_recent >= 6:\n            if r4 < 0.06 and n < 90:\n                return 'D'\n            return 'C'\n        if opp_recent >= 4:\n            return 'C'\n        if n >= 5 and history[-2][1] == 'C' and history[-3][1] == 'C':\n            return 'C'\n        if r4 < 0.2:\n            return 'C'\n        return 'D'\n    if n >= 5 and history[-2][1] == 'C' and history[-3][1] == 'C':\n        if opp_recent >= 4:\n            return 'C'\n    if r4 < 0.12:\n        return 'C'\n    return 'D'"
  },
