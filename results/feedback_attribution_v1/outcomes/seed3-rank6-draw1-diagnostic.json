  "child": {
    "name": "seed3-rank6-draw1-diagnostic",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    me = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    # Fast recent window stats\n    def def_rate(last_k):\n        k = last_k if n >= last_k else n\n        start = n - k\n        d = 0\n        for i in range(start, n):\n            if opp[i] == 'D':\n                d += 1\n        return d / float(k)\n\n    last_opp = opp[n - 1]\n    last_me = me[n - 1]\n\n    # Track consecutive opponent defections at the tail\n    opp_d_streak = 0\n    i = n - 1\n    while i >= 0 and opp[i] == 'D':\n        opp_d_streak += 1\n        i -= 1\n\n    # Endgame: grab DC=5 against likely cooperators, but only if they aren't\n    # currently punishing.  If opponent is in a defection streak, keep D.\n    remaining = 100 - n\n    if remaining <= 1:\n        return 'D'\n\n    # If opponent is heavily defective/short-memory punisher, stay in D.\n    r10 = def_rate(10)\n    r20 = def_rate(20)\n    if r20 >= 0.6:\n        # Rare cooperation to probe for a TFT that might ease off.\n        if opp_d_streak >= 5 and rng.random() < 0.03:\n            return 'C'\n        return 'D'\n\n    # Strong retaliation on immediate defection, but with calibrated forgiveness\n    # to escape DD traps against forgiving opponents like ALLC-after-4D and TFT.\n    if last_opp == 'D':\n        # One-shot punishment then possibly forgive if opponent is mostly nice.\n        if opp_d_streak >= 3:\n            # Long streak: mostly keep defecting, but occasionally test C to\n            # re-open cooperation with a forgiving opponent (cheap probe).\n            if rng.random() < 0.12:\n                return 'C'\n            return 'D'\n        # Short streak (1-2). If overall cooperation is decent, forgive soon.\n        if n >= 12 and r10 <= 0.25:\n            # Opponent mostly cooperative; offer C to allow recovery to CC.\n            if rng.random() < 0.7:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent just cooperated.\n    # If we defected last round, return to cooperation to avoid endless DD.\n    if last_me == 'D':\n        # Only keep exploiting if we sense a truly defenseless opponent.\n        if r20 <= 0.05 and n >= 20 and rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    # Both cooperated last round.\n    # Exploit very cooperative opponents slightly, but keep it rare so we\n    # don't disrupt mutual cooperation that yields 3/round.\n    if r10 <= 0.1:\n        if n > 25 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # Mixed opponent: TFT-like with a touch of forgiveness.\n    if r10 <= 0.35:\n        return 'C'\n    if r10 <= 0.55:\n        return 'D' if rng.random() < 0.45 else 'C'\n    return 'D'"
  },
