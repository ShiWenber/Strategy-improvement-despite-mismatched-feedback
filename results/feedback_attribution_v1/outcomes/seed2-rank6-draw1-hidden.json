  "child": {
    "name": "seed2-rank6-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    opp = [b for a, b in history]\n    me = [a for a, b in history]\n    opp_d = sum(1 for x in opp if x == 'D')\n    my_d = sum(1 for x in me if x == 'D')\n    last_op = opp[-1]\n    last_me = me[-1]\n    rounds_left = 100 - n\n\n    def opp_last_k_defects(k):\n        m = min(k, n)\n        return sum(1 for x in opp[-m:] if x == 'D')\n\n    def opp_run(action):\n        c = 0\n        for x in reversed(opp):\n            if x == action:\n                c += 1\n            else:\n                break\n        return c\n\n    def me_run(action):\n        c = 0\n        for x in reversed(me):\n            if x == action:\n                c += 1\n            else:\n                break\n        return c\n\n    if n == 1:\n        if last_op == 'D':\n            return 'D'\n        return 'C'\n\n    if n == 2:\n        if last_op == 'D':\n            return 'D'\n        return 'C'\n\n    if n < 5:\n        if last_op == 'D':\n            if opp_run('D') >= 2:\n                return 'D'\n            return 'D' if rng.random() < 0.8 else 'C'\n        return 'C'\n\n    # Terminal exploitation\n    if rounds_left <= 2:\n        if opp_d == 0 and my_d == 0:\n            return 'D'\n        if last_op == 'C':\n            return 'D'\n        return 'D' if rng.random() < 0.5 else 'C'\n\n    # Aggressive punish for chronic defectors\n    if opp_d >= 5 and opp_d * 2 > n:\n        if last_op == 'D' or rng.random() < 0.9:\n            return 'D'\n        return 'C'\n\n    # Detect opponent that never defects\n    if opp_d == 0:\n        if n >= 90:\n            return 'D'\n        if n >= 30 and my_d >= 2 and rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Detect mostly defecting opponent\n    if n >= 6 and opp_d * 5 > n * 3:\n        if rounds_left <= 15:\n            if last_op == 'C' and rng.random() < 0.6:\n                return 'D'\n            return 'D' if last_op == 'D' else 'C'\n        if last_op == 'D':\n            return 'D'\n        if last_me == 'D' and opp_run('C') >= 1:\n            return 'C'\n        return 'D' if rng.random() < 0.75 else 'C'\n\n    # Opponent mostly cooperative\n    if opp_d * 5 <= n:\n        # Occasionally test in later phase\n        if opp_run('C') >= 8 and n >= 20 and rng.random() < 0.12:\n            return 'D'\n        if last_op == 'D':\n            if opp_run('D') >= 2:\n                return 'D'\n            # forgive single defection\n            return 'C' if rng.random() < 0.55 else 'D'\n        return 'C'\n\n    # Mixed opponent: use responsive tit-for-tat with retaliation depth\n    if last_op == 'D':\n        if opp_run('D') >= 3:\n            return 'D'\n        if opp_last_k_defects(5) >= 3:\n            return 'D'\n        if last_me == 'C' and opp_run('D') == 1 and rng.random() < 0.3:\n            return 'C'\n        return 'D' if rng.random() < 0.85 else 'C'\n\n    # Opponent just cooperated\n    if last_me == 'D':\n        # Avoid endless mutual defection cycles\n        if opp_run('C') >= 1:\n            return 'C'\n        if my_d > opp_d + 1 and rng.random() < 0.5:\n            return 'C'\n        return 'C'\n    if opp_last_k_defects(4) >= 3:\n        return 'D'\n    if opp_last_k_defects(6) >= 2 and rng.random() < 0.25:\n        return 'D'\n    return 'C'"
  },
