  "child": {
    "name": "seed1-rank3-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    remaining = 100 - n\n    last_me, last_opp = history[-1]\n\n    # Tally conditional cooperation of the opponent.\n    cc = cd = dc = dd = 0\n    for me, opp in history:\n        if me == 'C':\n            if opp == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if opp == 'C':\n                dc += 1\n            else:\n                dd += 1\n    opp_c = cc + dc\n    opp_d = cd + dd\n    coop_rate = opp_c / n\n\n    # Endgame: calibrated defection only when opponent is likely exploitable.\n    if remaining <= 4:\n        # Cooperate only if opponent looks punitive (retaliates after our D).\n        if dc + dd > 0 and dc / (dc + dd) < 0.3:\n            return 'D'\n        return 'D'\n\n    # Very early: cooperate to signal, punish immediate D.\n    if n < 3:\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    coop_after_c = cc / (cc + cd) if (cc + cd) > 0 else 0.5\n    coop_after_d = dc / (dc + dd) if (dc + dd) > 0 else 0.5\n\n    # Opponent is a heavy defector: defend.\n    if coop_rate < 0.25 and n >= 5:\n        if coop_after_d > 0.5 and n % 5 == 4:\n            return 'C'\n        return 'D'\n\n    # Opponent almost always cooperates: exploit gently, keep them cooperating.\n    if coop_rate > 0.9 and n >= 6:\n        # Defect on a sparse pseudo-schedule, otherwise cooperate.\n        if n % 9 == 8 and remaining > 8:\n            return 'D'\n        return 'C'\n\n    # Opponent cooperative and highly forgiving: exploit more often.\n    if coop_after_d > 0.7 and coop_rate > 0.6 and n >= 10 and remaining > 12:\n        if n % 4 == 3:\n            return 'D'\n        return 'C'\n\n    # Opponent exploitative when we cooperate: stop giving them 5.\n    if coop_after_c < 0.25 and (cc + cd) >= 3:\n        return 'D'\n\n    # Mutual cooperation streak maintenance.\n    if last_me == 'C' and last_opp == 'C':\n        # Guard against long-run exploitation: if we've been too cooperative\n        # relative to what we get back, occasionally check.\n        if cd > cc and n >= 12:\n            return 'D'\n        if n % 11 == 10 and remaining > 10:\n            return 'D'\n        return 'C'\n\n    # We defected, opponent cooperated: reward generous opponent.\n    if last_me == 'D' and last_opp == 'C':\n        if coop_rate > 0.5:\n            return 'C'\n        if remaining > 6:\n            return 'C'\n        return 'D'\n\n    # We cooperated, opponent defected: retaliate, forgive isolated D if they're mostly good.\n    if last_me == 'C' and last_opp == 'D':\n        # Count trailing opponent defections.\n        streak = 0\n        for me, opp in reversed(history):\n            if opp == 'D':\n                streak += 1\n            else:\n                break\n        if streak >= 2:\n            return 'D'\n        if coop_rate > 0.6 and remaining > 8:\n            return 'C'\n        return 'D'\n\n    # Both defected: try to escape the spiral once, otherwise stay firm.\n    if last_me == 'D' and last_opp == 'D':\n        # Extend olive branch if opponent has shown cooperative tendencies.\n        if coop_rate > 0.5 and rng.random() < 0.35:\n            return 'C'\n        if coop_rate > 0.4 and rng.random() < 0.15:\n            return 'C'\n        return 'D'\n\n    return 'C'"
  },
