  "child": {
    "name": "seed4-rank6-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    # Efficiently count pair types (cc, cd, dc, dd) and opponent actions.\n    cc = 0\n    cd = 0\n    dc = 0\n    dd = 0\n    opp_c = 0\n    my_c = 0\n    for me, op in history:\n        if me == 'C':\n            my_c += 1\n            if op == 'C':\n                cc += 1\n                opp_c += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n                opp_c += 1\n            else:\n                dd += 1\n\n    opp_d = n - opp_c\n    my_last, opp_last = history[-1]\n\n    # Last few opponent actions\n    recent = history[-10:] if n >= 10 else history\n    recent_opp_c = sum(1 for _, op in recent if op == 'C')\n    recent_opp_d = len(recent) - recent_opp_c\n\n    # Consecutive opponent defections at end.\n    opp_d_streak = 0\n    for _, op in reversed(history):\n        if op == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Consecutive mutual cooperation at end.\n    cc_streak = 0\n    for me, op in reversed(history):\n        if me == 'C' and op == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    remaining = 100 - n\n\n    # ---- Endgame: last 2 rounds, defect if opponent is not a pure cooperator. ----\n    if remaining <= 2:\n        # Against a pure cooperator, mutual cooperation is already safe;\n        # defecting gives +2 on final round vs +3 if they also defect? Actually\n        # against pure C, defecting yields 5 vs 3, so defect.\n        if opp_d == 0:\n            return 'D'\n        # If opponent has defected at all, defect.\n        return 'D'\n\n    # ---- Pure cooperator detection: exploit lightly while keeping trust. ----\n    if opp_d == 0:\n        # Against someone who has never defected, defect every 4th round\n        # but return to C to avoid triggering them if they are contingent.\n        if n >= 4 and n % 4 == 0:\n            return 'D'\n        return 'C'\n\n    # ---- Persistent defector: punish, with rare probes. ----\n    if opp_d * 3 >= n * 2:  # opponent defects >= 2/3 of the time\n        # Punish hard; occasionally cooperate to test for change.\n        if n % 19 == 0:\n            return 'C'\n        return 'D'\n\n    # ---- Mostly cooperative opponent: maintain mutual cooperation. ----\n    if opp_c * 5 >= n * 4:  # opponent cooperates >= 80%\n        if opp_last == 'D':\n            # Retaliate once, but if they've clearly been generous overall,\n            # forgive after single defection to avoid losing mutual C.\n            if opp_d_streak >= 2:\n                return 'D'\n            # Single recent defection: forgive with high probability.\n            if recent_opp_c >= len(recent) - 1:\n                return 'C'\n            return 'D'\n        return 'C'\n\n    # ---- Contingent / tit-for-tat-like opponent detection. ----\n    # If opponent tends to mirror our previous move, play tit-for-tat with\n    # occasional forgiveness, and exploit at the very end.\n    if n >= 4:\n        mirror_hits = 0\n        mirror_total = 0\n        # Check last up to 20 transitions.\n        start = max(1, n - 20)\n        for i in range(start, n):\n            prev_me = history[i - 1][0]\n            cur_op = history[i][1]\n            mirror_total += 1\n            if cur_op == prev_me:\n                mirror_hits += 1\n        if mirror_total > 0 and mirror_hits * 4 >= mirror_total * 3:\n            # Strong mirror behavior. Play nice generally.\n            if remaining <= 4:\n                # Late-game: if they've mostly mirrored, defect in final rounds.\n                if opp_d_streak >= 1:\n                    return 'D'\n                return 'C'\n            if opp_last == 'C':\n                return 'C'\n            # They defected last. Forgive once to restore mutual C, else retaliate.\n            if cc_streak >= 1 or recent_opp_c >= len(recent) - 2:\n                return 'C'\n            return 'D'\n\n    # ---- General adaptive play: defend against exploitation, reward cooperation. ----\n    # If we've been exploited frequently, defect more.\n    exploited = cd  # our C, their D\n    if exploited >= 2 and exploited * 2 >= cc + 1:\n        if n >= 5 and rng.random() < 0.85:\n            return 'D'\n\n    # If mutual cooperation dominates recent history, stay cooperative.\n    if cc_streak >= 3:\n        # Small probe to catch non-punishing cooperators.\n        if n < 90 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Opponent just cooperated.\n    if opp_last == 'C':\n        # If opponent defected a lot earlier but recently cooperative, cautious.\n        if recent_opp_d >= 3:\n            if rng.random() < 0.3:\n                return 'D'\n        return 'C'\n\n    # Opponent just defected.\n    # If it's an isolated defection in a cooperative relationship, forgive.\n    if recent_opp_c >= len(recent) - 2 and n >= 8:\n        return 'C'\n    # If they have a streak of defections, retaliate.\n    if opp_d_streak >= 2:\n        return 'D'\n    # Single defection: retaliate but sometimes forgive to break cycles.\n    if rng.random() < 0.15:\n        return 'C'\n    return 'D'"
  },
