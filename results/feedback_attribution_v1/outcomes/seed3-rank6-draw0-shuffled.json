  "child": {
    "name": "seed3-rank6-draw0-shuffled",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    # Endgame exploitation: last round always defect.\n    remaining = 100 - n\n    if remaining <= 0:\n        return 'D'\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n\n    # Track runs of consecutive behavior for the opponent.\n    def tail_run(sym):\n        k = 0\n        for i in range(n - 1, -1, -1):\n            if opp[i] == sym:\n                k += 1\n            else:\n                break\n        return k\n\n    opp_c_run = tail_run('C')\n    opp_d_run = tail_run('D')\n    last_opp = opp[n - 1]\n\n    # Recent windows\n    def rate(sym, k):\n        start = n - k if n > k else 0\n        total = n - start\n        if total <= 0:\n            return 0.0\n        c = 0\n        for i in range(start, n):\n            if opp[i] == sym:\n                c += 1\n        return c / float(total)\n\n    r5_c = rate('C', 5)\n    r10_c = rate('C', 10)\n    r20_c = rate('C', 20)\n\n    # Fresh opponent: open cooperatively to seed mutual cooperation.\n    if n < 3:\n        return 'C'\n\n    # Early exploitation check: if opponent defected in first few rounds,\n    # be cautious but try one forgiveness probe.\n    if n < 10:\n        early_d = 0\n        for i in range(min(n, 6)):\n            if opp[i] == 'D':\n                early_d += 1\n        if early_d == 0:\n            return 'C'\n        # They defected early. Retaliate, but offer a cooperative probe midway.\n        if last_opp == 'D':\n            if n == 6 and rng.random() < 0.5:\n                return 'C'\n            return 'D'\n        return 'C' if rng.random() < 0.5 else 'D'\n\n    # If opponent has a long defection streak, just defect (defense).\n    if opp_d_run >= 3:\n        # Rare forgiveness probe to break DD lock-in, but only if earlier\n        # cooperation was substantial.\n        if opp_c_run == 0 and opp_c >= 4 and rng.random() < 0.05:\n            return 'C'\n        return 'D'\n\n    # If opponent extremely cooperative overall, mostly cooperate but\n    # occasionally probe to catch always-cooperators.\n    if r10_c >= 0.9 and opp_d <= 1:\n        # Late-game slight probe; small rate to preserve CC stream.\n        if n > 25 and rng.random() < 0.025:\n            return 'D'\n        return 'C'\n\n    # Pure exploiter: defected almost always.\n    if r20_c <= 0.15:\n        # Occasional random cooperation may destabilize all-D opponents.\n        if rng.random() < 0.04:\n            return 'C'\n        return 'D'\n\n    # Immediate retaliation plus forgiveness pattern.\n    if last_opp == 'D':\n        # If opponent usually cooperates, retaliate once then offer re-cooperation.\n        if r10_c >= 0.6:\n            # If we already retaliated last round, return to cooperation.\n            if my[n - 1] == 'D':\n                # Only if their last defection is isolated.\n                if n >= 2 and opp[n - 2] == 'C':\n                    return 'C'\n                return 'D'\n            return 'D'\n        # Otherwise punish harder.\n        return 'D'\n\n    # Opponent cooperated.\n    # If we just retaliated, return to cooperation.\n    if n >= 1 and my[n - 1] == 'D':\n        return 'C'\n\n    # Sustained cooperation from opponent: cooperate, with rare probing.\n    if r10_c >= 0.7:\n        # Rare probing with a deterministic-ish rhythm to avoid predictability.\n        if n > 30 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # Mixed / moderate cooperation environment.\n    if r5_c >= 0.6:\n        return 'C'\n    if r5_c <= 0.3:\n        return 'D'\n    # 50/50-ish: tit-for-tat with slight forgiveness.\n    return 'C' if rng.random() < 0.6 else 'D'"
  },
