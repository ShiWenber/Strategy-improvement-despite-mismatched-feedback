    "name": "seed3-rank6-draw0-diagnostic",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n    last_opp = opp[n - 1]\n\n    # Endgame: grab DC payoff in the last couple of rounds.\n    remaining = 100 - n\n    if remaining <= 0:\n        return 'D'\n\n    # Count opponent defections overall and recently.\n    opp_d_total = 0\n    for i in range(n):\n        if opp[i] == 'D':\n            opp_d_total += 1\n\n    def recent_d(k):\n        start = n - k\n        if start < 0:\n            start = 0\n        c = 0\n        for i in range(start, n):\n            if opp[i] == 'D':\n                c += 1\n        return c\n\n    last5_d = recent_d(5)\n    last10_d = recent_d(10)\n\n    # Strong opening: build cooperation for the first few rounds.\n    if n < 6:\n        return 'C'\n\n    # Endgame defection window.\n    if remaining <= 2:\n        return 'D'\n\n    # Opponent just defected: retaliate, but allow recovery when rare.\n    if last_opp == 'D':\n        # If opponent has been overwhelmingly cooperative, forgive quickly.\n        if opp_d_total <= 1 and n >= 8:\n            return 'C'\n        # If only a single recent defection in long cooperative stretch, forgive.\n        if last10_d <= 1 and n >= 12:\n            return 'C'\n        # Otherwise defect.\n        return 'D'\n\n    # Opponent just cooperated.\n    # If opponent is almost always defecting, just defect.\n    if n >= 12 and last10_d >= 7:\n        return 'D'\n\n    # If we just defected last round and opponent still cooperated, that's a\n    # probe — apologize by cooperating to rebuild mutual cooperation.\n    if me[n - 1] == 'D':\n        return 'C'\n\n    # Opponent is highly cooperative: sustain CC. Rare probes to catch\n    # pure always-cooperators, but keep them very infrequent to avoid collapse.\n    if opp_d_total * 4 <= n:\n        if n > 30 and remaining > 5 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # Moderate opponent defection rate: use generous tit-for-tat with\n    # occasional forgiveness to break DD traps.\n    if opp_d_total * 2 <= n:\n        # recent trend matters more\n        if last5_d == 0:\n            return 'C'\n        if last5_d >= 3:\n            return 'D'\n        # occasional forgiveness against sporadic defections\n        if rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Opponent mostly defects: defect.\n    return 'D'"
  },
