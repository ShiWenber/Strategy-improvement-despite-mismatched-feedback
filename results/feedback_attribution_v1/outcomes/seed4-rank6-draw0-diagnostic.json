  "child": {
    "name": "seed4-rank6-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Track actions compactly\n    my = [h[0] for h in history]\n    op = [h[1] for h in history]\n\n    opp_last = op[-1]\n    my_last = my[-1]\n\n    # Endgame: defect strongly in the last rounds, especially if opponent is exploitable.\n    if n >= 99:\n        return 'D'\n    if n >= 97:\n        # If opponent has been quite cooperative, grab value; otherwise avoid giving them value.\n        opp_c = op.count('C')\n        if opp_c >= n - 3:\n            return 'D'\n        if opp_last == 'D':\n            return 'D'\n        # Last two rounds against a still-cooperative or mixed opponent: defect.\n        return 'D'\n\n    # Compute behavioral stats\n    cc = sum(1 for a, b in history if a == 'C' and b == 'C')\n    cd = sum(1 for a, b in history if a == 'C' and b == 'D')\n    dc = sum(1 for a, b in history if a == 'D' and b == 'C')\n    dd = sum(1 for a, b in history if a == 'D' and b == 'D')\n    opp_c = cc + dc\n    opp_d = cd + dd\n\n    # Consecutive opponent defections\n    opp_d_streak = 0\n    for b in reversed(op):\n        if b == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Consecutive mutual cooperation\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if my[i] == 'C' and op[i] == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Recent window stats\n    k = min(10, n)\n    recent = history[-k:]\n    r_opp_c = sum(1 for a, b in recent if b == 'C')\n    r_opp_d = k - r_opp_c\n    r_mut_c = sum(1 for a, b in recent if a == 'C' and b == 'C')\n\n    # Highly cooperative opponent: maintain mutual cooperation, exploit only at end.\n    if opp_c >= n - 1:\n        return 'C' if n < 97 else 'D'\n\n    # Generally cooperative opponent: reciprocate, but do not be a sucker repeatedly.\n    if opp_c * 10 >= n * 7:\n        if opp_last == 'D':\n            # Punish short bursts, but forgive if they've mostly cooperated.\n            if opp_d_streak >= 2 and r_opp_d >= 3:\n                return 'D'\n            if rng.random() < 0.55:\n                return 'C'\n            return 'D'\n        # Exploit very slightly when opponent never retaliates against our D.\n        if dc >= 1 and opp_d <= 2 and n < 96:\n            if my_last == 'C' and rng.random() < 0.18:\n                return 'D'\n        return 'C'\n\n    # Mostly defecting opponent: defect almost always, occasional probe to detect shift.\n    if opp_d * 10 >= n * 7:\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # Mixed opponent: forgiving tit-for-tat with anti-exploitation.\n    # If we've been exploited more than cooperating mutually, lean defection.\n    if cd > cc + 1 and cd >= 3:\n        if opp_last == 'D':\n            return 'D'\n        if rng.random() < 0.35:\n            return 'D'\n        return 'C'\n\n    # If mutual cooperation is strong recently, keep cooperating to bank payoff.\n    if r_mut_c >= 6:\n        if opp_last == 'D' and opp_d_streak >= 2:\n            return 'D'\n        return 'C'\n\n    # Opponent just defected: retaliate but allow forgiveness to restore cooperation.\n    if opp_last == 'D':\n        if opp_d_streak >= 3:\n            # Defect unless they had a strong cooperative history before.\n            if cc >= n - opp_d_streak - 2 and cc >= 6:\n                return 'C'\n            return 'D'\n        if rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent just cooperated: cooperate, with rare probing defect.\n    if n < 96 and opp_d <= 3 and rng.random() < 0.04:\n        return 'D'\n    return 'C'"
  },
