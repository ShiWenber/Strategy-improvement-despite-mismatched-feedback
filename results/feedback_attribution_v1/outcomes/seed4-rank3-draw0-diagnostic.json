  "child": {
    "name": "seed4-rank3-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Extract opponent moves compactly\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    last_opp = opp[-1]\n    last_me = my[-1]\n\n    # Counts over the whole match\n    opp_d_total = 0\n    cc = 0\n    for i in range(n):\n        if opp[i] == 'D':\n            opp_d_total += 1\n        if my[i] == 'C' and opp[i] == 'C':\n            cc += 1\n\n    # Endgame: secure mutual cooperation unless opponent is clearly exploitative\n    if n >= 95:\n        if opp_d_total == 0:\n            return 'C'\n        if opp_d_total * 5 <= n:\n            return 'C'\n        return 'D'\n\n    # Early: cooperative opening\n    if n < 8:\n        return 'C'\n\n    # Trailing defection streak of opponent\n    opp_streak = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'D':\n            opp_streak += 1\n        else:\n            break\n\n    # Trailing cooperation streak of opponent\n    opp_c_streak = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'C':\n            opp_c_streak += 1\n        else:\n            break\n\n    # Recent window stats (last 10)\n    w = 10 if n >= 10 else n\n    start = n - w\n    recent_opp_d = 0\n    for i in range(start, n):\n        if opp[i] == 'D':\n            recent_opp_d += 1\n\n    # Detect mirror / TFT-like opponent: they tend to copy our previous move\n    mirror_hits = 0\n    mirror_total = 0\n    for i in range(1, n):\n        mirror_total += 1\n        if opp[i] == my[i - 1]:\n            mirror_hits += 1\n\n    tft_like = mirror_total > 0 and mirror_hits * 4 >= mirror_total * 3\n\n    if tft_like:\n        # Against TFT-family, reciprocate strongly. Cooperate if they cooperated last.\n        if last_opp == 'C':\n            return 'C'\n        # They defected: retaliate once, then return to C (classic TFT)\n        if last_me == 'D':\n            return 'C'\n        return 'D'\n\n    # Persistent heavy defector: punish, with rare probes\n    if n >= 12 and opp_d_total * 3 >= n * 2:\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # If opponent has been very cooperative overall, maintain cooperation\n    if opp_d_total * 4 <= n:\n        # If they just defected, retaliate briefly\n        if last_opp == 'D':\n            if opp_streak >= 2:\n                if opp_d_total * 6 <= n:\n                    return 'C'\n                return 'D'\n            return 'D'\n        return 'C'\n\n    # If we just defected and they cooperated, return to cooperation\n    if last_me == 'D' and last_opp == 'C':\n        return 'C'\n\n    # Opponent defected last\n    if last_opp == 'D':\n        # If they've been mostly cooperative but had recent defections, forgive once\n        if opp_streak == 1 and opp_d_total * 5 <= n:\n            return 'C'\n        # If long streak, keep punishing\n        if opp_streak >= 3:\n            return 'D'\n        # Medium defection levels: retaliate but occasionally forgive\n        if rng.random() < 0.2 and opp_d_total * 3 <= n:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last\n    # If generally cooperative, cooperate\n    if opp_d_total * 3 <= n:\n        return 'C'\n\n    # Mixed opponent: cautiously cooperate unless recently aggressive\n    if recent_opp_d >= 4:\n        return 'D'\n    if rng.random() < 0.1 and opp_d_total * 2 >= n:\n        return 'D'\n    return 'C'"
  },
