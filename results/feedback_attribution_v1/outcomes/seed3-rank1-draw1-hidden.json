    "name": "seed3-rank1-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    def opp_count(a, start, end):\n        c = 0\n        for i in range(start, end):\n            if opp[i] == a:\n                c += 1\n        return c\n\n    def me_count(a, start, end):\n        c = 0\n        for i in range(start, end):\n            if me[i] == a:\n                c += 1\n        return c\n\n    if n == 1:\n        return 'C'\n\n    remaining = 100 - n\n\n    total_opp_c = opp_count('C', 0, n)\n    total_opp_d = n - total_opp_c\n\n    k = 12 if n >= 12 else n\n    recent_opp_c = opp_count('C', n - k, n)\n    recent_opp_d = k - recent_opp_c\n\n    last_opp = opp[n - 1]\n    last_me = me[n - 1]\n\n    # Opponent never defects: cooperate until a late safe exploitation window.\n    if total_opp_d == 0:\n        if remaining <= 1:\n            return 'D'\n        return 'C'\n\n    # Opponent never cooperates: defect, with a rare fixed-probe to check change.\n    if total_opp_c == 0:\n        if remaining <= 1:\n            return 'D'\n        if n % 17 == 0:\n            return 'C'\n        return 'D'\n\n    # Near the very end, defect is weakly safest against unpredictable opponents,\n    # but keep cooperating vs a strongly cooperative recent opponent.\n    if remaining <= 1:\n        if recent_opp_d == 0 and total_opp_c * 4 >= n * 3:\n            return 'C'\n        return 'D'\n\n    # If our own last action was D and opponent still cooperated, we just exploited.\n    # Avoid over-exploiting a mostly cooperative opponent.\n    if last_me == 'D' and last_opp == 'C':\n        if recent_opp_d <= 1 and total_opp_c * 2 >= n:\n            return 'C'\n        return 'D' if total_opp_d * 2 >= n else 'C'\n\n    # Strong immediate retaliation after opponent defection.\n    if last_opp == 'D':\n        # If opponent was previously very cooperative, retaliate once then prepare to forgive.\n        if recent_opp_c >= k - 2 and total_opp_c * 3 >= n * 2:\n            return 'D'\n        # If recent opponent defection is heavy, continue defecting.\n        if recent_opp_d >= 3:\n            return 'D'\n        # Moderate punishment.\n        if n >= 3 and opp[n - 2] == 'D' and opp[n - 3] == 'D':\n            if n % 5 == 0:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last round.\n    # Maintain cooperation with highly cooperative opponents.\n    if recent_opp_d == 0:\n        # Rare deterministic probe late, only if there is enough room to recover.\n        if remaining > 15 and n % 23 == 0:\n            return 'D'\n        return 'C'\n\n    if recent_opp_d <= 1 and total_opp_c * 3 >= n * 2:\n        return 'C'\n\n    # If recent behavior is mixed, use a forgiving tit-for-tat bias to induce CC.\n    if recent_opp_c * 2 >= k:\n        # Mostly cooperative recent: cooperate, with occasional pressure.\n        if n % 11 == 0 and remaining > 10:\n            return 'D'\n        return 'C'\n\n    # Opponent has been largely defecting recently: defend, but periodically test.\n    if remaining > 2:\n        if n % 13 == 0:\n            return 'C'\n    return 'D'"
  },
