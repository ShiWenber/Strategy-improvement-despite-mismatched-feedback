    "name": "seed2-rank6-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    my_last, op_last = history[-1]\n    opp = [b for a, b in history]\n    dcount = opp.count('D')\n    ccount = n - dcount\n    # Windowed opponent defection stats\n    w = history[-8:] if n >= 8 else history\n    wd = sum(1 for a, b in w if b == 'D')\n    wn = len(w)\n    # my recent defections\n    me = [a for a, b in history]\n    my_d = me.count('D')\n    rounds_left = 100 - n\n\n    # Endgame: exploit known cooperators, else tit-for-tat\n    if rounds_left <= 2:\n        if dcount * 4 <= n:\n            return 'D'\n        return 'D' if op_last == 'C' else 'D'\n\n    # Hard detection: opponent defects a lot -> always defect\n    if dcount * 2 > n and dcount >= 3:\n        return 'D'\n\n    # Opponent almost pure cooperator -> exploit periodically but keep trust\n    if dcount == 0 and n >= 5:\n        # sprinkle in exploitation, but not so much it triggers retaliation\n        if n >= 90:\n            return 'D'\n        if my_d == 0 and n >= 12 and rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    # Defect-backs that are forgiving when opponent is mostly cooperative\n    if op_last == 'D':\n        # severe recent defection -> hard punish\n        if wd * 2 >= wn and n >= 4:\n            return 'D'\n        # otherwise return defection but forgive sometimes\n        if dcount * 3 < n:\n            if rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # op_last == 'C'\n    # If I defected last and they cooperated, don't chain exploitation too hard\n    if my_last == 'D':\n        if my_d * 2 > n and n >= 10:\n            return 'C'\n        # moderate exploit if they tolerate it\n        if dcount * 4 < n:\n            return 'D' if rng.random() < 0.5 else 'C'\n        return 'C'\n\n    # Both cooperated last\n    # punish lingering defections\n    if wd >= 2 and n >= 4:\n        return 'D'\n    # if opponent moderately defecting overall, cautious\n    if dcount * 5 > n * 2:\n        return 'D' if rng.random() < 0.35 else 'C'\n    # late-game probing when opponent is very cooperative\n    if n >= 88 and dcount * 5 <= n:\n        return 'D' if rng.random() < 0.35 else 'C'\n    return 'C'"
  },
