  "child": {
    "name": "seed3-rank6-draw0-true",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    def rate(window_start, window_end, seq):\n        cnt = 0\n        total = 0\n        for i in range(window_start, window_end):\n            total += 1\n            if seq[i] == 'C':\n                cnt += 1\n        if total == 0:\n            return 0.0\n        return cnt / float(total)\n\n    opp_coop = rate(0, n, opp)\n    last_opp = opp[n - 1]\n\n    # Endgame: last few rounds, exploit a cooperator.\n    remaining = 100 - n\n    if remaining <= 1:\n        return 'D'\n    if remaining <= 3 and opp_coop >= 0.6:\n        return 'D'\n\n    # Opening: cooperate.\n    if n < 3:\n        return 'C'\n\n    # Long-run opponent defection history.\n    recent_start = n - 10 if n > 10 else 0\n    recent_coop = rate(recent_start, n, opp)\n    last20_start = n - 20 if n > 20 else 0\n    coop20 = rate(last20_start, n, opp)\n\n    # If opponent is very cooperative, mostly cooperate, rare probe.\n    if coop20 >= 0.9:\n        if n > 15 and remaining > 6 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # If opponent rarely cooperates, defect.\n    if coop20 <= 0.2:\n        # Test once in a while for a possible cooperative revival.\n        if n > 10 and n % 15 == 0:\n            return 'C'\n        return 'D'\n\n    # Immediate retaliation with calibrated forgiveness.\n    if last_opp == 'D':\n        # Count how many consecutive D from opponent.\n        run_d = 0\n        i = n - 1\n        while i >= 0 and opp[i] == 'D':\n            run_d += 1\n            i -= 1\n        # Count how many consecutive C from opponent right before that.\n        run_c = 0\n        while i >= 0 and opp[i] == 'C':\n            run_c += 1\n            i -= 1\n        # If opponent has a strong history of cooperation, forgive once after\n        # a single defection.\n        if run_d == 1 and (run_c >= 3 or coop20 >= 0.65):\n            if remaining > 5 and rng.random() < 0.25:\n                return 'C'\n        # If opponent's last defection matches our last defection, we may be\n        # in a DD trap; try to escape by cooperating occasionally.\n        if n >= 2 and me[n - 1] == 'D' and opp[n - 2] == 'D':\n            if run_d >= 2 and rng.random() < 0.12:\n                return 'C'\n        return 'D'\n\n    # Opponent just cooperated.\n    # If our last action was D (we exploited), be ready to cooperate back\n    # unless opponent proves exploitable repeatedly.\n    if n >= 2 and me[n - 1] == 'D':\n        if rng.random() < 0.85:\n            return 'C'\n        return 'D'\n\n    # Both cooperated. Mostly stay cooperative, with a small steady probing\n    # rate that scales with how cooperative opponent has been.\n    if coop20 >= 0.7:\n        if remaining > 10 and rng.random() < 0.015:\n            return 'D'\n        return 'C'\n\n    # Middle ground: opponent's cooperation rate between 0.2 and 0.7.\n    if recent_coop >= 0.75:\n        if remaining > 8 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Recent cooperation is weaker; occasionally withhold cooperation to\n    # signal that we want more C from them.\n    if recent_coop <= 0.4:\n        if rng.random() < 0.5:\n            return 'C'\n        return 'D'\n\n    if rng.random() < 0.85:\n        return 'C'\n    return 'D'"
  },
