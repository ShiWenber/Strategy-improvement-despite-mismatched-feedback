  "child": {
    "name": "seed0-rank6-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n\n    # First few rounds: cooperate to establish trust\n    if n < 4:\n        if 'D' in opp:\n            return 'D'\n        return 'C'\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    my_d = my.count('D')\n\n    # Consecutive opponent actions from the end\n    consec_d = 0\n    for a in reversed(opp):\n        if a == 'D':\n            consec_d += 1\n        else:\n            break\n    consec_c = 0\n    for a in reversed(opp):\n        if a == 'C':\n            consec_c += 1\n        else:\n            break\n\n    # Recent window stats\n    w = 12 if n >= 12 else n\n    rec = opp[-w:]\n    rec_d = rec.count('D')\n    rec_c = w - rec_d\n\n    last_opp = opp[-1]\n    last_my = my[-1]\n\n    # If we are being constantly defected on with no cooperation, exploit back\n    if opp_d >= n - 1 and n >= 5:\n        return 'D'\n\n    # Opponent always cooperates: cooperate, tiny chance to test exploit late\n    if opp_d == 0:\n        if n > 60 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Heavy recent defection -> defect\n    if rec_d >= max(4, w * 2 // 3):\n        return 'D'\n\n    # Long mutual defection spiral: try to restore cooperation\n    if consec_d >= 3:\n        # If we've also been defecting, occasionally offer an olive branch\n        if last_my == 'D' and consec_d >= 4 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Endgame exploitation: if opponent has significant defections and we're near end\n    if n >= 90:\n        # If opponent cooperates reliably, keep cooperating for mutual 3s\n        if opp_c * 10 >= n * 95:\n            return 'C'\n        # Otherwise, defect to grab 5s when they likely cooperate\n        if last_opp == 'C':\n            return 'D'\n        return 'D'\n\n    # Late game tightening\n    if n >= 75:\n        if opp_c * 10 >= n * 9:\n            return 'C'\n        if rec_d >= 2:\n            return 'D'\n        return 'C'\n\n    # General TFT-ish with forgiveness\n    if last_opp == 'D':\n        # If opponent usually cooperates but just slipped, forgive sometimes\n        if opp_c * 10 >= n * 9 and consec_d == 1 and rng.random() < 0.6:\n            return 'C'\n        # If we defected too and it's mutual, try to reset\n        if last_my == 'D' and opp_c * 10 >= n * 5 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round\n    if last_my == 'D':\n        # We exploited; they may retaliate. Cooperate to repair unless clearly exploitative\n        if opp_c * 10 >= n * 7:\n            return 'C'\n        if rng.random() < 0.5:\n            return 'D'\n        return 'C'\n\n    # Both cooperated: chance to exploit a very cooperative opponent\n    if my_d == 0 and opp_c * 10 >= n * 9 and n > 25 and n < 85:\n        if rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # If opponent has moderate defection rate and we've been exploited, defend\n    if my_d * 10 >= n * 4 and opp_d * 10 >= n * 3 and rec_d >= 2:\n        return 'D'\n\n    return 'C'"
  },
