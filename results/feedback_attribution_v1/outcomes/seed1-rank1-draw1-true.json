  "child": {
    "name": "seed1-rank1-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n\n    last_opp = opp[-1]\n    last_my = my[-1]\n\n    remaining = 100 - n\n\n    # Endgame extraction: defect while there's still time to profit.\n    if remaining <= 4:\n        return 'D'\n\n    # Very early: cooperate to invite mutual cooperation.\n    if n < 6:\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Overwhelmingly cooperative opponent: farm cooperation, with rare\n    # calibrated exploitation only when there is plenty of time left.\n    if opp_d <= max(1, n // 12):\n        if remaining > 12 and rng.random() < 0.06:\n            return 'D'\n        # Punish back-to-back defections by the \"nice\" opponent.\n        if last_opp == 'D' and n >= 2 and opp[-2] == 'D':\n            return 'D'\n        return 'C'\n\n    # Mostly defecting opponent: protect ourselves, occasionally reset.\n    if opp_d * 3 > n * 2:\n        if last_opp == 'D' and last_my == 'D' and rng.random() < 0.08:\n            return 'C'\n        return 'D'\n\n    # Tit-for-tat with targeted forgiveness on isolated defections.\n    if last_opp == 'C':\n        # If we defected and opponent still cooperated, quickly return to C.\n        if last_my == 'D':\n            return 'C'\n        # Rare probe only when opponent looks robustly cooperative.\n        if remaining > 10 and opp_c * 4 >= n * 3 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Opponent just defected.\n    if n >= 3 and opp[-2] == 'D':\n        # Reinforce punishment against sustained defection.\n        return 'D'\n\n    # Single defection: mostly retaliate once, forgive occasionally.\n    if rng.random() < 0.20:\n        return 'C'\n    return 'D'"
  },
