  "child": {
    "name": "seed2-rank6-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    last_me, last_op = history[-1]\n\n    # Detect all-cooperate opponents and exploit only at the very end.\n    opp = [b for a, b in history]\n    if opp.count('D') == 0:\n        if n >= 99:\n            return 'D'\n        return 'C'\n\n    # Defect against opponents who defect frequently.\n    dcount = opp.count('D')\n    if dcount * 2 > n and dcount >= 3:\n        if n >= 99:\n            return 'D'\n        return 'D'\n\n    # Respond to immediate defection with strong retaliation,\n    # but avoid getting stuck against TFT-style punishers.\n    if last_op == 'D':\n        if n >= 2 and history[-2][1] == 'D':\n            return 'D'\n        # If opponent has mostly cooperated, occasionally forgive.\n        if dcount * 4 <= n and rng.random() < 0.25:\n            return 'D' if rng.random() < 0.3 else 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    # If we defected last round, return to cooperation to rebuild trust.\n    if last_me == 'D':\n        return 'C'\n\n    # Endgame: exploit against sufficiently cooperative opponents.\n    if n >= 98:\n        return 'D'\n\n    # Occasional probing but keep it rare to preserve mutual cooperation.\n    if n >= 10 and dcount * 10 <= n and rng.random() < 0.03:\n        return 'D'\n\n    return 'C'"
  },
