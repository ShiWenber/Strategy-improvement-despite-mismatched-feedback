  "child": {
    "name": "seed4-rank6-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Count outcomes\n    cc = cd = dc = dd = 0\n    for me, op in history:\n        if me == 'C':\n            if op == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    my_c = cc + cd\n    my_d = dc + dd\n\n    # Consecutive opponent defections at end\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Consecutive mutual cooperation streak\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][0] == 'C' and history[i][1] == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Consecutive mutual defection streak\n    dd_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][0] == 'D' and history[i][1] == 'D':\n            dd_streak += 1\n        else:\n            break\n\n    last_me, last_op = history[-1]\n\n    # Endgame: only last round greedily defect if opponent likely won't\n    if n >= 99:\n        # If opponent almost always cooperated, defect for +2\n        if opp_c >= n - 2:\n            return 'D'\n        # Otherwise if they defected a lot, defect is (weakly) fine\n        return 'D'\n\n    # Near endgame: if opponent very cooperative, secure cooperation till round 98\n    if n >= 95:\n        if opp_d <= 2 and cc_streak >= 3:\n            return 'C'\n        if opp_d_streak >= 2:\n            return 'D'\n        return 'C'\n\n    # Persistent defector: exploit-proof\n    if n >= 6 and opp_c * 4 < n:\n        # Rarely probe to test for change\n        if n % 19 == 0:\n            return 'C'\n        return 'D'\n\n    # Persistent cooperator: gentle exploitation\n    if n >= 10 and opp_d == 0:\n        # Periodic probe to gain a bit; keep them cooperating\n        if n % 7 == 0 and n < 90:\n            return 'D'\n        return 'C'\n\n    # If we've been mutually cooperating nicely, keep it going\n    if cc_streak >= 2:\n        return 'C'\n\n    # If opponent just defected\n    if last_op == 'D':\n        # Long defection streak -> punish\n        if opp_d_streak >= 3:\n            # Forgive only if historically cooperative and streak is fresh\n            if n >= 10 and (opp_d - opp_d_streak) <= 1:\n                return 'D'\n            if n >= 12 and opp_c * 3 >= n * 2 and opp_d_streak <= 3:\n                return 'C'\n            return 'D'\n        # Single recent defection: retaliate, but sometimes forgive if they are generally nice\n        if opp_c * 3 >= n * 2 and rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    # If we defected last, defect only if they punish; otherwise return to cooperation\n    if last_me == 'D':\n        # If they've been taking advantage, keep defecting sometimes\n        if dc >= 3 and cc <= dc:\n            return 'D' if rng.random() < 0.5 else 'C'\n        return 'C'\n\n    # Consider exploiting cooperative opponents mid-game carefully\n    if n >= 20 and opp_d <= 2 and cc >= n - 3:\n        # Very cooperative opponent: occasional planned defection\n        if n % 5 == 0:\n            return 'D'\n        return 'C'\n\n    # If we've been exploited a lot, be more defensive\n    if cd >= 4 and cd > dc:\n        if opp_c * 2 < n and rng.random() < 0.5:\n            return 'D'\n        return 'C'\n\n    # Default: cooperate (forgiving tit-for-tat)\n    return 'C'"
  },
