  "child": {
    "name": "seed2-rank3-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    my_last, opp_last = history[-1]\n    if n >= 2:\n        my_prev, opp_prev = history[-2]\n    else:\n        my_prev, opp_prev = None, None\n    opp_def = 0\n    my_def = 0\n    for m, o in history:\n        if o == 'D':\n            opp_def += 1\n        if m == 'D':\n            my_def += 1\n    opp_c = n - opp_def\n    my_c = n - my_def\n    rem = 100 - n\n    window = history[-8:] if n >= 8 else history\n    w_opp_d = 0\n    w_my_d = 0\n    for m, o in window:\n        if o == 'D':\n            w_opp_d += 1\n        if m == 'D':\n            w_my_d += 1\n    w_len = len(window)\n    w_opp_c = w_len - w_opp_d\n    # End game exploitation\n    if rem <= 1:\n        return 'D'\n    if rem <= 3:\n        if opp_def * 2 <= n:\n            return 'D'\n        if opp_last == 'D':\n            return 'D'\n        return 'C'\n    # Opponent near-always defecting: exploit-hard\n    if opp_def >= 4 and opp_c <= 1 and n >= 5:\n        if opp_last == 'D':\n            return 'D'\n        if rng.random() < 0.9:\n            return 'D'\n        return 'C'\n    if opp_def * 3 > n * 2 and n >= 6:\n        if opp_last == 'D':\n            return 'D'\n        if rng.random() < 0.7:\n            return 'D'\n        return 'C'\n    # Pure cooperator: exploit carefully, maintain CC baseline\n    if opp_def == 0:\n        if n < 6:\n            return 'C'\n        # test occasionally\n        if w_my_d == 0 and n >= 10:\n            if rng.random() < 0.06:\n                return 'D'\n            return 'C'\n        # recover after any defection\n        if my_last == 'D':\n            return 'C'\n        return 'C'\n    # Opponent mostly cooperative\n    if opp_def * 4 <= n:\n        if n >= 90:\n            if rng.random() < 0.5:\n                return 'D'\n            return 'C'\n        if opp_last == 'D':\n            # retaliate but forgive if isolated\n            if w_opp_d <= 1 and n >= 4:\n                if rng.random() < 0.35:\n                    return 'C'\n                return 'D'\n            return 'D'\n        if my_last == 'D':\n            return 'C'\n        if w_opp_d >= 2:\n            if rng.random() < 0.4:\n                return 'D'\n            return 'C'\n        return 'C'\n    # Mixed opponent: generous tit-for-tat with proportional response\n    if opp_last == 'D':\n        # if opponent cooperated after our defection, forgive\n        if my_prev == 'D' and opp_last == 'D' and rng.random() < 0.15:\n            return 'C'\n        if w_opp_d >= 3:\n            return 'D'\n        if opp_def * 2 < n:\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'D'\n    # opp_last == 'C'\n    if my_last == 'D':\n        # repair unless we can keep exploiting\n        if opp_def * 2 >= n and my_def >= 3:\n            if rng.random() < 0.25:\n                return 'D'\n            return 'C'\n        return 'C'\n    if w_opp_c >= w_len - 1:\n        if n >= 20 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n    if w_opp_d >= 2:\n        if rng.random() < 0.3:\n            return 'D'\n        return 'C'\n    return 'C'"
  },
