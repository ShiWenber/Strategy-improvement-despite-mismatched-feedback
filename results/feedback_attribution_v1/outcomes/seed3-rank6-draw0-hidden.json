  "child": {
    "name": "seed3-rank6-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Pull arrays once.\n    me = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    # Fast tallies.\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n\n    # --- Opening: cooperative but ready to punish. ---\n    if n < 3:\n        return 'C'\n\n    # --- Endgame: last round, always defect. ---\n    if n == 99:\n        return 'D'\n    # Second-to-last: defect unless opponent has been a hard defector\n    # (against pure defectors, defecting is still weakly better or equal).\n    if n == 98:\n        return 'D'\n\n    # --- Pure-strategy detection. ---\n    if opp_d == 0:\n        # Opponent always cooperates. Exploit nearly every round, but\n        # cooperate occasionally to avoid triggering a shift if they\n        # respond to defection partway through.\n        if n < 4:\n            return 'C'\n        if rng.random() < 0.92:\n            return 'D'\n        return 'C'\n\n    if opp_c == 0:\n        # Opponent always defects. Defect too, but probe once in a while\n        # to detect any shift (cheap insurance: expected cost is tiny).\n        if n % 25 == 0 and n < 90:\n            return 'C'\n        return 'D'\n\n    # --- Recent window analysis. ---\n    k = 12 if n >= 12 else n\n    recent_opp = opp[-k:]\n    recent_d = recent_opp.count('D')\n    recent_rate = recent_d / float(k)\n\n    # Track consecutive opponent cocooperations since last D.\n    run_c = 0\n    i = n - 1\n    while i >= 0 and opp[i] == 'C':\n        run_c += 1\n        i -= 1\n\n    # Long cooperative streaks: exploit cautiously, but keep building CC.\n    if run_c >= 6 and recent_rate <= 0.15:\n        if opp_c * 10 >= n * 8:\n            # Highly cooperative overall — mostly cooperate, occasionally\n            # squeeze in a defection. Expected value slightly favors C\n            # against forgiving partners, so keep probes rare.\n            if n > 20 and rng.random() < 0.06:\n                return 'D'\n            return 'C'\n        return 'C'\n\n    # --- Retaliation / forgiveness logic (Tit for Tat style). ---\n    last_opp = opp[n - 1]\n\n    if last_opp == 'D':\n        # If opponent has been mostly cooperative historically,\n        # forgive quickly to avoid DD traps.\n        if opp_c * 4 >= n * 3:\n            # Very cooperative but just defected — retaliate once only.\n            if me[n - 1] == 'D':\n                return 'C'\n            return 'D'\n        if opp_c * 2 >= n:\n            # Moderately cooperative: retaliate once, then forgive.\n            if me[n - 1] == 'D' and run_c >= 1:\n                return 'C'\n            return 'D'\n        # Mostly defective opponent: defect, with rare cooperation probes.\n        if n % 17 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated.\n    # If we defected last round (we were probing), return to cooperation\n    # unless opponent is a pushover we can keep exploiting.\n    if me[n - 1] == 'D':\n        if opp_c * 5 >= n * 4 and run_c >= 1:\n            # Very forgiving cooperator — keep exploiting with restraint.\n            if rng.random() < 0.55:\n                return 'D'\n            return 'C'\n        return 'C'\n\n    # Both cooperated last round.\n    # Sustained cooperation generally — cooperate.\n    if recent_rate <= 0.2:\n        return 'C'\n\n    # Mixed opponent — be cautious but still mostly cooperate.\n    if recent_rate <= 0.4:\n        if rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    # Opponent defecting a lot recently: defect until they show a\n    # sustained cooperative streak.\n    if run_c >= 3:\n        return 'C'\n    if rng.random() < 0.1:\n        return 'C'\n    return 'D'"
  },
