  "child": {
    "name": "seed2-rank1-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n\n    opp_c = 0\n    opp_d = 0\n    for h in history:\n        if h[1] == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n\n    # Last 6 opponent moves\n    m = min(6, n)\n    tail = history[-m:]\n    tail_d = 0\n    for h in tail:\n        if h[1] == 'D':\n            tail_d += 1\n\n    last_opp = history[-1][1]\n    rounds_left = 100 - n\n\n    # Hardcore defector: punish relentlessly, no forgiveness\n    if opp_d >= 4 and opp_d * 2 > opp_c and tail_d >= 3:\n        return 'D'\n\n    # Dominant defector\n    if opp_d >= 5 and opp_d * 3 >= n:\n        return 'D'\n\n    # Extremely cooperative: safe cooperation, small late probe\n    if opp_d == 0:\n        if rounds_left <= 2:\n            return 'D'\n        if n >= 95 and rng.random() < 0.10:\n            return 'D'\n        return 'C'\n\n    # Mostly cooperative: cooperate, exploit late\n    if opp_d * 4 <= n:\n        if rounds_left <= 3:\n            return 'D'\n        if n >= 92 and rng.random() < 0.07:\n            return 'D'\n        if last_opp == 'D':\n            if tail_d <= 1 and rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'C'\n\n    # Endgame: squeeze cooperators\n    if rounds_left <= 2:\n        return 'D'\n\n    # Basically tit-for-tat with mild forgiveness\n    if last_opp == 'D':\n        if tail_d <= 1 and opp_c >= 2 and rng.random() < 0.15:\n            return 'C'\n        return 'D'\n    # Opponent cooperated\n    if n >= 90 and rng.random() < 0.05:\n        return 'D'\n    if opp_d * 2 > n and rng.random() < 0.30:\n        return 'D'\n    return 'C'"
  },
