    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Track counts efficiently\n    opp_c = 0\n    opp_d = 0\n    my_d = 0\n    cd = 0\n    for me, op in history:\n        if op == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if me == 'D':\n            my_d += 1\n            if op == 'C':\n                cd += 1\n\n    # Endgame handling\n    remaining = 100 - n\n    if remaining <= 1:\n        # Final round: if opponent is exploitable (cooperates a lot), defect\n        if opp_c >= opp_d:\n            return 'D'\n        # If they defect a lot too, just take the safe 1 instead of 0 risk\n        return 'D'\n\n    if remaining <= 3:\n        if opp_d > opp_c * 0.5:\n            return 'D'\n        if opp_c >= n * 0.8:\n            return 'D'\n        return 'C'\n\n    opp_last = history[-1][1]\n    my_last = history[-1][0]\n\n    # Early: cooperate to establish mutual cooperation, but probe hard defectors\n    if n < 6:\n        # If opponent opened with D on our C, retaliate immediately\n        if opp_last == 'D' and my_last == 'C':\n            return 'D'\n        return 'C'\n\n    opp_rate = opp_c / n\n\n    # Detect pure/near-pure cooperator: exploit but keep them cooperating\n    if opp_d == 0:\n        # Defect every 3rd round after establishing cooperation\n        if n % 3 == 0:\n            return 'D'\n        return 'C'\n\n    # Detect near-pure cooperator (0 or 1 defection)\n    if opp_d <= 1 and n >= 10:\n        if n % 3 == 2:\n            return 'D'\n        return 'C'\n\n    # Detect persistent defector: punish, with occasional test\n    if opp_rate <= 0.15 and n >= 8:\n        if n % 7 == 0:\n            return 'C'\n        return 'D'\n\n    # Detect mostly defector\n    if opp_rate <= 0.3 and n >= 6:\n        if n % 11 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent mostly cooperative: use forgiving tit-for-tat with exploitation\n    if opp_rate >= 0.75:\n        if opp_last == 'D':\n            # Retaliate but forgive quickly if rare\n            if opp_d <= 2:\n                return 'C'\n            # Count recent consecutive opponent defections\n            k = 0\n            for i in range(n - 1, -1, -1):\n                if history[i][1] == 'D':\n                    k += 1\n                else:\n                    break\n            if k >= 2:\n                return 'D'\n            return 'D'\n        # Opponent cooperated: exploit occasionally if we've been nice\n        if n >= 12 and my_d < cd + 1 and n % 5 == 0 and rng.random() < 0.5:\n            return 'D'\n        return 'C'\n\n    # Mid-range opponent (~30-75% cooperation): reciprocate with memory\n    # Count recent opponent behavior (last 10)\n    start = n - 10\n    if start < 0:\n        start = 0\n    rec_c = 0\n    rec_n = n - start\n    for i in range(start, n):\n        if history[i][1] == 'C':\n            rec_c += 1\n    rec_rate = rec_c / rec_n if rec_n > 0 else 0.5\n\n    if opp_last == 'D':\n        # If they've been cooperative recently, forgive once\n        if rec_rate >= 0.6:\n            return 'C'\n        # Two defections in a row: punish\n        if n >= 2 and history[-2][1] == 'D' and history[-2][0] == 'C':\n            # They defected twice while we cooperated at least once\n            if rng.random() < 0.15:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last\n    if rec_rate >= 0.7:\n        # Maintain cooperation, occasional probe\n        if n >= 15 and my_d < cd + 1 and n % 6 == 0 and rng.random() < 0.4:\n            return 'D'\n        return 'C'\n    if rec_rate <= 0.3:\n        # They're deceptive: defect often but sprinkle cooperation to reset\n        if rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Balanced recent behavior: cooperate with some retaliation memory\n    if my_last == 'D' and opp_last == 'C':\n        return 'C'\n    return 'C' if rng.random() < 0.85 else 'D'"
