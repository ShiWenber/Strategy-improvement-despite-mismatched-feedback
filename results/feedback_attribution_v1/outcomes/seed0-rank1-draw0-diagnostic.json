  "child": {
    "name": "seed0-rank1-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n    opp_last = history[-1][1]\n    opp_c = sum(1 for a, b in history if b == 'C')\n    if n < 4:\n        return 'C'\n    last10 = history[-10:]\n    opp_recent = sum(1 for a, b in last10 if b == 'C')\n    ten = last10 if n >= 10 else history\n    opp_ten = sum(1 for a, b in ten if b == 'C')\n    if n >= 8 and opp_recent <= 1:\n        return 'D'\n    if n >= 3 and history[-1][1] == 'D' and history[-2][1] == 'D':\n        if n >= 6 and opp_recent <= 3:\n            return 'D'\n        if rng.random() < 0.85:\n            return 'D'\n        return 'C'\n    if n >= 20 and opp_c * 100 <= n * 25:\n        return 'D'\n    if n >= 50:\n        if opp_c * 100 <= n * 55:\n            return 'D'\n    if n >= 10:\n        if opp_recent <= 4 and opp_last == 'D':\n            return 'D'\n    if n >= 20:\n        window = 10\n        opp_d = window - opp_recent\n        if opp_d >= 4 and opp_last == 'D':\n            return 'D'\n    if opp_last == 'C':\n        if n >= 3 and history[-2][1] == 'D' and history[-3][1] == 'D':\n            if rng.random() < 0.6:\n                return 'D'\n        if n >= 20 and opp_ten * 10 <= len(ten) * 4:\n            return 'D'\n        return 'C'\n    if n >= 5:\n        if history[-2][1] == 'C' and history[-3][1] == 'C':\n            return 'C'\n    if n >= 2:\n        if history[-1][1] == 'D' and history[-2][1] == 'C':\n            if opp_c * 100 >= n * 70:\n                return 'C' if rng.random() < 0.5 else 'D'\n            return 'D'\n    if rng.random() < 0.15:\n        return 'C'\n    return 'D'"
  },
