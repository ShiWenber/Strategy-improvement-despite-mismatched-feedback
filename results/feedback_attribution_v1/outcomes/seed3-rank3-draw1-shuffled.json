    "name": "seed3-rank3-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n    remaining = 100 - n\n\n    # Final round: always defect.\n    if remaining <= 1:\n        return 'D'\n\n    # Last few rounds: defect more aggressively against any non-trustworthy opponent.\n    if remaining <= 3:\n        recent = opp[-6:]\n        if recent.count('C') >= 4 and n > 10:\n            return 'D'\n        return 'D'\n\n    coop = opp.count('C')\n    rate = coop / n\n\n    # Long consecutive cooperation streak tracking.\n    run_c = 0\n    for a in reversed(opp):\n        if a == 'C':\n            run_c += 1\n        else:\n            break\n\n    # Long consecutive defection streak.\n    run_d = 0\n    for a in reversed(opp):\n        if a == 'D':\n            run_d += 1\n        else:\n            break\n\n    # Against a highly cooperative opponent, cooperate to keep CC=3.\n    if rate >= 0.9:\n        # Rarely probe, only if opponent is not obviously always-cooperative.\n        if remaining > 15 and n >= 8 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # If opponent cooperated for a long streak, cooperate.\n    if run_c >= 5 and rate >= 0.7:\n        return 'C'\n\n    # Against very defective opponents, defect.\n    if rate <= 0.25 or run_d >= 4:\n        # Occasionally test cooperation to escape mutual-defect traps.\n        if run_d >= 8 and rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    last_opp = opp[-1]\n    last_me = me[-1]\n\n    # Retaliation logic: if opponent defected last round, mostly defect.\n    if last_opp == 'D':\n        # If opponent has been mostly cooperative overall, forgive sometimes.\n        if rate >= 0.65 and rng.random() < 0.35:\n            return 'C'\n        if run_d >= 2 and rate < 0.5:\n            return 'D'\n        # Count forgiveness events: how often did opponent return to C after D?\n        returns = 0\n        for i in range(1, n):\n            if opp[i - 1] == 'D' and opp[i] == 'C':\n                returns += 1\n        if returns >= 2 and rng.random() < 0.3:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    # If we defected last round and they still cooperated, exploit a bit more.\n    if last_me == 'D':\n        if n < 90 and rng.random() < 0.5:\n            return 'D'\n        return 'C'\n\n    # Both cooperated. Consider occasional probing based on opponent profile.\n    # If opponent has been very cooperative and rarely retaliates, probe.\n    if n >= 10 and rate >= 0.8:\n        # Count how often opponent retaliated after our D.\n        retaliation = 0\n        chances = 0\n        for i in range(1, n):\n            if me[i - 1] == 'D':\n                chances += 1\n                if opp[i] == 'D':\n                    retaliation += 1\n        if chances >= 2 and retaliation * 2 < chances:\n            if remaining > 10 and rng.random() < 0.08:\n                return 'D'\n\n    # Moderate probing against mild opponents.\n    if n >= 20 and rate >= 0.55 and remaining > 10:\n        if rng.random() < 0.03:\n            return 'D'\n\n    # If opponent seems to alternate, exploit.\n    if n >= 6:\n        alt = True\n        for i in range(1, 6):\n            if opp[-i] == opp[-i - 1]:\n                alt = False\n                break\n        if alt and last_opp == 'C':\n            return 'D'\n\n    return 'C'"
  },
