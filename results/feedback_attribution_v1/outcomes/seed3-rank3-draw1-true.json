  "child": {
    "name": "seed3-rank3-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    remaining = 100 - n\n\n    # Endgame: defect firmly in the last 2 rounds to grab value.\n    if remaining <= 1:\n        return 'D'\n    if remaining <= 2 and opp.count('C') >= n * 0.7:\n        return 'D'\n\n    coop = opp.count('C')\n    rate = coop / n\n\n    # Opponent has never defected: keep cooperating, but probe once in a while.\n    if rate == 1.0:\n        if n >= 15 and remaining > 5 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # Opponent is almost never cooperating: defect.\n    if rate <= 0.2:\n        if remaining > 6 and n >= 8 and rng.random() < 0.05:\n            return 'C'\n        return 'D'\n\n    # Last 10 opponent moves help identify current mode.\n    recent_opp = opp[-10:]\n    recent_coop = recent_opp.count('C')\n    recent_rate = recent_coop / len(recent_opp)\n\n    last_my, last_opp = my[-1], opp[-1]\n\n    # If opponent is highly cooperative, sustain CC but exploit cautiously.\n    if recent_rate >= 0.9:\n        if last_opp == 'D':\n            return 'D'\n        if remaining > 6 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # If opponent is mostly defecting recently, defend.\n    if recent_rate <= 0.2:\n        return 'D'\n\n    # Immediate retaliation but with forgiveness after sustained cooperation.\n    if last_opp == 'D':\n        # Count consecutive opponent Ds at the end.\n        d_run = 0\n        for a in reversed(opp):\n            if a == 'D':\n                d_run += 1\n            else:\n                break\n        # Long defection streak: keep defecting.\n        if d_run >= 3:\n            return 'D'\n        # Single defection after long cooperation: retaliate once.\n        if recent_rate >= 0.7:\n            if last_my == 'D':\n                return 'C'\n            return 'D'\n        # Mixed opponent: mostly defect with occasional forgiveness.\n        if rng.random() < 0.18:\n            return 'C'\n        return 'D'\n\n    # Opponent just cooperated.\n    # If we defected last round and they still cooperated, exploit once more rarely.\n    if last_my == 'D':\n        if recent_rate >= 0.75:\n            return 'C'\n        if rng.random() < 0.3:\n            return 'D'\n        return 'C'\n\n    # Both cooperated. Mostly cooperate, occasionally probe.\n    if recent_rate >= 0.6:\n        if remaining > 10 and n > 20 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # Moderate cooperation rate: tit-for-tat with slight optimism.\n    if rng.random() < 0.75:\n        return 'C'\n    return 'D'"
  },
