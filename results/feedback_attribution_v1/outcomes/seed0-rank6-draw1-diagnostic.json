  "child": {
    "name": "seed0-rank6-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_last = opp[-1]\n    my_last = my[-1]\n\n    # Detect mutual defection runs and try to restore cooperation\n    if n >= 3 and opp[-3:] == ['D', 'D', 'D']:\n        if rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Recent window statistics\n    w = 8\n    recent_opp = opp[-w:]\n    recent_my = my[-w:]\n    ro_c = recent_opp.count('C')\n    ro_d = len(recent_opp) - ro_c\n    rm_d = recent_my.count('D')\n\n    # Opponent mostly cooperating -> cooperate, with light opportunistic probing\n    if ro_c >= len(recent_opp) - 1:\n        if n >= 40 and ro_c == len(recent_opp) and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # Opponent mostly defecting -> defect\n    if ro_d >= len(recent_opp) - 1:\n        if rng.random() < 0.06:\n            return 'C'\n        return 'D'\n\n    # Tit-for-tat core with forgiveness\n    if opp_last == 'C':\n        # If we have been defecting a lot but they still cooperate, be nice\n        if rm_d >= len(recent_my) - 1:\n            return 'C'\n        # Light exploit against highly cooperative opponents mid-game\n        if n >= 25 and n < 90 and ro_c >= len(recent_opp) - 1 and rng.random() < 0.1:\n            return 'D'\n        return 'C'\n\n    # Opponent defected last round\n    # Forgiveness: if opponent has been mostly cooperative overall, cooperate to reset\n    total_c = opp.count('C')\n    if n >= 8 and total_c * 4 >= n * 3:\n        if rng.random() < 0.5:\n            return 'C'\n    # Otherwise retaliate\n    return 'D'"
  },
