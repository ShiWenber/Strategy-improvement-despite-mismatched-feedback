  "child": {
    "name": "seed2-rank6-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n\n    opp = [b for a, b in history]\n    me = [a for a, b in history]\n    opp_def = opp.count('D')\n    my_def = me.count('D')\n    opp_coop = n - opp_def\n    last_me = me[-1]\n    last_op = opp[-1]\n    rounds_left = 100 - n\n\n    recent_len = min(8, n)\n    recent_opp = opp[-recent_len:]\n    recent_opp_def = recent_opp.count('D')\n    recent_me_def = me[-recent_len:].count('D')\n\n    # Endgame: opportunistic exploitation with awareness.\n    if rounds_left <= 1:\n        return 'D'\n    if rounds_left <= 4:\n        if opp_def == 0:\n            return 'D'\n        if last_op == 'D':\n            return 'D'\n        if opp_def * 10 < n:\n            return 'D' if rng.random() < 0.7 else 'C'\n        return 'C'\n    if rounds_left <= 10:\n        if opp_def == 0:\n            return 'D'\n        if recent_opp_def >= 2 or last_op == 'D':\n            return 'D'\n        if opp_def * 5 < n:\n            return 'D' if rng.random() < 0.45 else 'C'\n        return 'C'\n\n    # Always-defector detection: heavy punishment.\n    if n >= 4 and opp_def >= n - 1:\n        return 'D'\n    if n >= 6 and opp_def * 3 >= n * 2:\n        return 'D' if last_op == 'D' or rng.random() < 0.8 else 'C'\n\n    # Very cooperative opponent: stay cooperative, rare probes only later.\n    if opp_def == 0:\n        if n >= 25 and rounds_left > 12 and rng.random() < 0.035:\n            return 'D'\n        return 'C'\n\n    # Opponent defected last move.\n    if last_op == 'D':\n        # If opponent is mostly cooperative, occasional forgiveness helps recover.\n        if opp_def * 6 <= n:\n            if recent_opp_def <= 1 and rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        # If opponent is mostly defective, punish hard.\n        if opp_def * 2 >= n:\n            return 'D'\n        # Mixed: retaliate, but forgive if recent pattern is mild.\n        if recent_opp_def >= 3:\n            return 'D'\n        if rng.random() < 0.15:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last move.\n    if last_me == 'D':\n        # After our defection, return to cooperation unless they're exploitable.\n        if opp_def == 0 and n >= 30 and rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Both cooperated last round.\n    # Punish sustained recent defection even if last move was C.\n    if recent_opp_def >= 3:\n        return 'D' if rng.random() < 0.7 else 'C'\n    if recent_opp_def >= 2:\n        return 'D' if rng.random() < 0.35 else 'C'\n\n    # Mixed opponent: cautious cooperation with occasional probing.\n    if opp_def * 4 > n:\n        return 'D' if rng.random() < 0.55 else 'C'\n    if opp_def * 10 > n * 3:\n        if rng.random() < 0.2:\n            return 'D'\n        return 'C'\n\n    # Mostly cooperative opponent: occasionally probe, but rarely.\n    if n >= 30 and rng.random() < 0.03:\n        return 'D'\n    return 'C'"
  },
