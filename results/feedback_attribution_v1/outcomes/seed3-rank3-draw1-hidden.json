  "child": {
    "name": "seed3-rank3-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n    last_my, last_opp = my[-1], opp[-1]\n    remaining = 100 - n\n\n    # Count how often the opponent has cooperated overall and recently.\n    opp_c = opp.count('C')\n    rate = opp_c / n\n    recent = opp[-10:]\n    recent_c = recent.count('C')\n    recent_rate = recent_c / len(recent)\n\n    # Detect opponents who almost always cooperate and exploit them heavily.\n    # Against pure cooperators, defecting all game yields 5 per round.\n    if opp_c == n and n >= 4:\n        # Probe occasionally to confirm, otherwise defect.\n        if remaining <= 1:\n            return 'D'\n        return 'D'\n\n    if rate >= 0.93 and n >= 6:\n        # Very likely a cooperator / forgiving type. Exploit.\n        if remaining <= 1:\n            return 'D'\n        # Small chance to cooperate to avoid triggering revenge.\n        if rng.random() < 0.08:\n            return 'C'\n        return 'D'\n\n    # If opponent has been mostly defecting, ensure we get 1 rather than 0.\n    if rate <= 0.25:\n        # Rarely probe for a cooperator, but mostly defect.\n        if n > 20 and rng.random() < 0.02:\n            return 'C'\n        return 'D'\n\n    # Endgame: exploit if opponent seems cooperative, otherwise defect.\n    if remaining <= 1:\n        if recent_rate >= 0.5:\n            return 'D'\n        return 'D'\n    if remaining <= 3:\n        if recent_rate >= 0.4:\n            return 'D'\n        return 'D'\n\n    # Default: reciprocal with forgiveness, tuned to sustain CC=3 with\n    # cooperative partners while punishing defectors.\n    if last_opp == 'D':\n        # Opponent defected. Retaliate, but avoid getting stuck in DD.\n        if recent_rate >= 0.7 and rng.random() < 0.25:\n            return 'C'\n        # If we just defected back and they were mostly cooperating,\n        # try to return to cooperation soon.\n        if last_my == 'D' and recent_rate >= 0.6:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated. Mostly cooperate, with rare probing.\n    if recent_rate >= 0.8:\n        # Against reliable cooperators, probe rarely only if far from end.\n        if remaining > 15 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    if recent_rate >= 0.5:\n        if rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    # Opponent mixes, lean toward cooperation to encourage CC.\n    if rng.random() < 0.6:\n        return 'C'\n    return 'D'"
  },
