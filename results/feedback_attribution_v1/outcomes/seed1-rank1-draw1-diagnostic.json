  "child": {
    "name": "seed1-rank1-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    my_c = my.count('C')\n\n    last_my = my[-1]\n    last_opp = opp[-1]\n\n    # Endgame exploitation.\n    rounds_left = 100 - n\n    if rounds_left <= 1:\n        return 'D'\n    if rounds_left <= 3 and opp_d * 3 <= n:\n        return 'D'\n\n    # Very cooperative opponent: maintain CC but probe rarely to exploit.\n    if opp_d <= max(1, n // 12):\n        # Avoid getting stuck in mutual cooperation forever with no gain:\n        # occasionally defect against an obvious always-cooperator.\n        if n >= 20 and opp_d == 0:\n            if n % 13 == 12:\n                return 'D'\n            return 'C'\n        if last_opp == 'D' and n >= 2 and opp[-2] == 'D':\n            return 'D'\n        return 'C'\n\n    # Mostly defecting opponent: protect.\n    if opp_d * 2 > n:\n        # Periodic olive branch to detect responsiveness.\n        if opp_d >= 3 and n % 9 == 8:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    if last_opp == 'C':\n        # If we defected and they still cooperated, return to cooperation.\n        if last_my == 'D':\n            return 'C'\n        # Rarely probe to gather information / exploit.\n        if n < 90 and rng.random() < 0.045:\n            return 'D'\n        return 'C'\n\n    # Opponent just defected.\n    # Check consecutive defections at the tail.\n    consec_d = 0\n    for m, o in reversed(history):\n        if o == 'D':\n            consec_d += 1\n        else:\n            break\n\n    # Long punishment after sustained defection.\n    if consec_d >= 3:\n        # Break mutual-defection deadlock occasionally.\n        if consec_d >= 4 and rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    # Single/few defections: retaliate, but consider forgiveness\n    # if the opponent has been generally cooperative.\n    if opp_c * 3 >= n * 2:\n        # Opponent is fairly cooperative; forgive most isolated defections.\n        if rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    return 'D'"
  },
