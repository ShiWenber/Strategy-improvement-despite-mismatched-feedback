    "name": "seed2-rank6-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [b for a, b in history]\n    me = [a for a, b in history]\n    opp_d = opp.count('D')\n    my_d = me.count('D')\n    last_me = me[-1]\n    last_op = opp[-1]\n    rounds_left = 100 - n\n\n    # Immediate retaliation for a fresh defection, with quick forgiveness.\n    if last_op == 'D':\n        # Opponent has been mostly cooperative: retaliate once, then forgive.\n        if opp_d * 5 <= n and n >= 3:\n            if last_me == 'D':\n                return 'C'\n            return 'D'\n        # Heavy defector: stay in defection.\n        if opp_d * 2 >= n:\n            return 'D'\n        # Moderate: defect back, but sometimes try to restore cooperation.\n        if last_me == 'D' and n >= 2 and opp[-2] == 'D':\n            return 'D'\n        return 'D' if rng.random() < 0.7 else 'C'\n\n    # Opponent cooperated last.\n    # If we defected last, usually return to cooperation unless exploiting a pure cooperator.\n    if last_me == 'D':\n        if opp_d == 0 and n >= 20 and n < 90:\n            return 'D' if rng.random() < 0.35 else 'C'\n        return 'C'\n\n    # Detect pure cooperators and exploit mildly late, while keeping mutual C otherwise.\n    if opp_d == 0:\n        if n >= 96:\n            return 'D'\n        if n >= 88 and rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Opponent mixes defections. Maintain cooperation when safe.\n    if opp_d * 4 <= n:\n        # Occasional probing to avoid being a total sucker late.\n        if n >= 90 and rng.random() < 0.3:\n            return 'D'\n        if n >= 20 and rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # Opponent defects frequently: punish, but allow recovery when they cooperate.\n    if opp_d * 2 >= n:\n        # If they just cooperated after a run of D, test with C sometimes.\n        if n >= 3 and opp[-2] == 'D' and opp[-3] == 'D' if n >= 3 else False:\n            return 'C' if rng.random() < 0.2 else 'D'\n        return 'D'\n\n    # Intermediate: forgiving tit-for-tat with endgame squeeze.\n    if rounds_left <= 3:\n        return 'D' if opp_d > 0 else 'C'\n    if rounds_left <= 8:\n        if opp_d * 3 >= n:\n            return 'D'\n        return 'C'\n    # If recent opponent defects cluster, punish.\n    recent_d = sum(1 for x in opp[-4:] if x == 'D')\n    if recent_d >= 2:\n        return 'D' if rng.random() < 0.8 else 'C'\n    if n >= 90 and rng.random() < 0.2:\n        return 'D'\n    return 'C'"
  },
