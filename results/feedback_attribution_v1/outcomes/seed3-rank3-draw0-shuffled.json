    "name": "seed3-rank3-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    remaining = 100 - n\n    if remaining <= 2:\n        return 'D'\n\n    coop = opp.count('C')\n    rate = coop / n\n\n    recent_opp = opp[-14:] if n >= 14 else opp\n    recent_rate = recent_opp.count('C') / len(recent_opp)\n\n    recent_my = my[-6:] if n >= 6 else my\n    my_def_recent = recent_my.count('D')\n\n    last_my = my[-1]\n    last_opp = opp[-1]\n\n    if rate >= 0.92:\n        if remaining > 8 and my_def_recent == 0 and rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    if rate <= 0.2 and recent_rate <= 0.25:\n        if remaining > 10 and last_opp == 'C' and rng.random() < 0.06:\n            return 'C'\n        return 'D'\n\n    if last_opp == 'D':\n        if recent_rate >= 0.7 and rate >= 0.55:\n            if last_my == 'D' and rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        if recent_rate >= 0.45 and remaining > 15 and rng.random() < 0.18:\n            return 'C'\n        return 'D'\n\n    if rate >= 0.75:\n        if remaining > 12 and my_def_recent <= 1 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    if recent_rate >= 0.55:\n        if remaining > 20 and my_def_recent == 0 and rng.random() < 0.12:\n            return 'D'\n        return 'C'\n\n    if recent_rate <= 0.35:\n        if rate >= 0.45 and remaining > 15 and rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    if last_my == 'D' and last_opp == 'C':\n        return 'C' if rng.random() < 0.75 else 'D'\n\n    return 'C' if rng.random() < 0.7 else 'D'"
  },
