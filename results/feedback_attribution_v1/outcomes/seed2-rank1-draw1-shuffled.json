  "child": {
    "name": "seed2-rank1-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n\n    # Aggregate counts\n    coop = 0\n    defd = 0\n    my_coop = 0\n    my_def = 0\n    for h in history:\n        if h[1] == 'C':\n            coop += 1\n        else:\n            defd += 1\n        if h[0] == 'C':\n            my_coop += 1\n        else:\n            my_def += 1\n\n    # Recent window behavior (last 8 rounds)\n    w = min(8, n)\n    recent = history[-w:]\n    r_opp_d = 0\n    r_opp_c = 0\n    r_my_d = 0\n    for h in recent:\n        if h[1] == 'D':\n            r_opp_d += 1\n        else:\n            r_opp_c += 1\n        if h[0] == 'D':\n            r_my_d += 1\n\n    # Last two opponent moves\n    last_opp = history[-1][1]\n    last_me = history[-1][0]\n    if n >= 2:\n        opp_prev = history[-2][1]\n    else:\n        opp_prev = None\n\n    rounds_left = 100 - n\n\n    # ---- Endgame: exploit hard when opponent appears cooperative ----\n    if rounds_left <= 2:\n        return 'D'\n    if rounds_left <= 5:\n        # If they've been mostly cooperative, defect every remaining round\n        if coop >= defd:\n            return 'D'\n        # If they retaliate, match them\n        if last_opp == 'D':\n            return 'D'\n        # Slight preference to defect\n        if rng.random() < 0.7:\n            return 'D'\n        return 'C'\n    if rounds_left <= 12:\n        # Adaptive endgame\n        if coop >= defd * 2:\n            # Highly cooperative: defect more\n            if rng.random() < 0.8:\n                return 'D'\n            return 'C'\n        if last_opp == 'D':\n            if rng.random() < 0.85:\n                return 'D'\n            return 'C'\n        if coop >= defd:\n            if rng.random() < 0.5:\n                return 'D'\n            return 'C'\n        return 'D' if rng.random() < 0.6 else 'C'\n\n    # ---- Pure/near-pure cooperator: keep cooperating, do not spoil ----\n    # Defecting against a pure cooperator yields 5 vs 3, but often the\n    # cooperator may react; safer to preserve mutual coop.\n    if defd == 0:\n        # very rarely, probe to potentially gain, otherwise stay C\n        if n >= 30 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n    if defd * 6 <= n:\n        # opponent almost always cooperates\n        if last_opp == 'D':\n            # rare betrayal - retaliate once then restore\n            return 'D'\n        if n >= 50 and rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # ---- Pure/near-pure defector: defect ----\n    if defd >= 3 and defd * 3 > coop * 2:\n        # Highly defective opponent\n        if rng.random() < 0.92:\n            return 'D'\n        return 'C'\n\n    # ---- Mostly defective in recent window ----\n    if r_opp_d >= 4:\n        return 'D' if rng.random() < 0.9 else 'C'\n\n    # ---- Tit-for-Tat with generous but bounded forgiveness ----\n    if last_opp == 'D':\n        # Opponent defected last round. Assess whether it's a one-off.\n        if last_me == 'D':\n            # mutual defection: try to break out occasionally\n            if coop >= defd and rng.random() < 0.2:\n                return 'C'\n            return 'D'\n        # We cooperated, they defected. Retaliate unless clearly rare.\n        # Forgiveness threshold tighter if they've defected before.\n        if defd <= 1 and rng.random() < 0.3:\n            return 'C'\n        if last_opp == 'D' and opp_prev == 'C' and defd * 4 < n and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    if last_me == 'D':\n        # Repair: cooperate, but if opponent is clearly exploitable stay defecting\n        if op_exploitable_marker := (coop >= defd * 3 and n >= 20):\n            if rng.random() < 0.25:\n                return 'D'\n            return 'C'\n        return 'C'\n\n    # Both cooperated last round.\n    if r_opp_d >= 2 and n >= 10:\n        # recent defections from a mostly-cooperative opponent\n        if rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    return 'C'"
  },
