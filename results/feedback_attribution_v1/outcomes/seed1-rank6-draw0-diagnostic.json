    "name": "seed1-rank6-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my_last, opp_last = history[-1]\n    remaining = 100 - n\n\n    opp_c = 0\n    for _, o in history:\n        if o == 'C':\n            opp_c += 1\n    opp_d = n - opp_c\n    coop_rate = opp_c / n\n\n    # Endgame: extract value when safe.\n    if remaining <= 1:\n        return 'D'\n    if remaining <= 3 and coop_rate > 0.5:\n        return 'D'\n\n    # Early rounds: cooperate to establish mutual cooperation.\n    if n < 4:\n        return 'C'\n\n    # Opponent is overwhelmingly cooperative: exploit gently, then cooperate.\n    if opp_d == 0:\n        if remaining <= 6:\n            return 'D'\n        if rng.random() < 0.06 and n >= 15:\n            return 'D'\n        return 'C'\n\n    # Opponent never cooperates: defect.\n    if opp_c == 0:\n        return 'D'\n\n    # Consecutive opponent defections at the tail.\n    consec_d = 0\n    for m, o in reversed(history):\n        if o == 'D':\n            consec_d += 1\n        else:\n            break\n\n    # Consecutive mutual cooperation streak.\n    cc_streak = 0\n    for m, o in reversed(history):\n        if m == 'C' and o == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Highly defective opponent: protect ourselves.\n    if coop_rate < 0.3:\n        return 'D'\n\n    # Strong mutual cooperation: preserve it, with rare probing.\n    if cc_streak >= 4 and coop_rate > 0.6:\n        if rng.random() < 0.03 and remaining > 10:\n            return 'D'\n        return 'C'\n\n    # Opponent just defected.\n    if opp_last == 'D':\n        # Long pure defection streak: punish.\n        if consec_d >= 3:\n            if coop_rate > 0.55 and rng.random() < 0.2:\n                return 'C'\n            return 'D'\n        # Isolated defection by a mostly cooperative opponent: forgive often.\n        if coop_rate > 0.7 and rng.random() < 0.65:\n            return 'C'\n        if coop_rate > 0.5 and rng.random() < 0.4:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    if my_last == 'D':\n        # Return to cooperation after our defection.\n        return 'C'\n\n    # Both cooperated: maintain cooperation with occasional quiet probe.\n    if coop_rate > 0.75:\n        return 'C'\n    if rng.random() < 0.04 and remaining > 8:\n        return 'D'\n    return 'C'"
  },
