  "child": {
    "name": "seed2-rank6-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    last_me, last_op = history[-1]\n    prev_me, prev_op = history[-2]\n    opp = [b for a, b in history]\n    dcount = sum(1 for x in opp if x == 'D')\n    cc = 0\n    for i in range(1, n):\n        if opp[i] == 'C' and opp[i - 1] == 'C':\n            cc += 1\n    if dcount == 0:\n        if n >= 98:\n            return 'D'\n        return 'C'\n    if n >= 3:\n        _, o2 = history[-3]\n    else:\n        o2 = 'C'\n    if last_op == 'D' and prev_op == 'D':\n        return 'D'\n    if last_op == 'D':\n        if dcount * 4 > n * 3:\n            return 'D'\n        if n >= 5:\n            recent_d = sum(1 for x in opp[-5:] if x == 'D')\n            if recent_d >= 3:\n                return 'D'\n        if o2 == 'D':\n            return 'D'\n        if n < 10:\n            return 'D'\n        if rng.random() < 0.65:\n            return 'D'\n        return 'C'\n    if n >= 98:\n        return 'D'\n    if dcount * 4 > n * 3:\n        return 'D' if rng.random() < 0.55 else 'C'\n    if n >= 6 and last_op == 'C' and prev_op == 'C' and o2 == 'D':\n        if rng.random() < 0.35:\n            return 'D'\n        return 'C'\n    if n >= 20 and dcount * 6 < n:\n        if rng.random() < 0.04:\n            return 'D'\n    if cc >= 90 and n < 95:\n        return 'D' if rng.random() < 0.06 else 'C'\n    return 'C'"
  },
