  "child": {
    "name": "seed0-rank6-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    opp_coop_rate = opp_c / n\n\n    # Endgame exploitation: if opponent has any defection history,\n    # defect in the last few rounds to grab DC payoffs.\n    if n >= 96:\n        if opp_coop_rate > 0.75 and opp_d <= 2:\n            # mostly cooperative opponent: still defect to exploit\n            return 'D'\n        return 'D'\n\n    # If opponent has been completely cooperative, cooperate\n    if opp_d == 0:\n        return 'C'\n\n    # If opponent is mostly defecting, defect but occasionally test\n    if opp_coop_rate < 0.3:\n        if n >= 15 and rng.random() < 0.05:\n            return 'C'\n        return 'D'\n\n    # Recent window analysis\n    window = opp[-12:]\n    recent_d = window.count('D')\n    recent_c = len(window) - recent_d\n\n    # Consecutive opponent moves from the end\n    consec_d = 0\n    for a in reversed(opp):\n        if a == 'D':\n            consec_d += 1\n        else:\n            break\n\n    consec_c = 0\n    for a in reversed(opp):\n        if a == 'C':\n            consec_c += 1\n        else:\n            break\n\n    last_opp = opp[-1]\n    last_my = my[-1]\n\n    # Check mutual defection trap and try to escape\n    if consec_d >= 3 and last_my == 'D':\n        # Try cooperation to break out\n        if rng.random() < 0.5:\n            return 'C'\n        return 'D'\n\n    # Long defection streak: punish\n    if consec_d >= 2:\n        return 'D'\n\n    # Opponent mostly cooperative overall: cooperate, with rare probes\n    if opp_coop_rate >= 0.8:\n        # Occasionally defect to test/gain\n        if n >= 20 and n < 90 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # If opponent recently defected a lot, defect\n    if recent_d >= 5:\n        return 'D'\n\n    # Opponent defected last round\n    if last_opp == 'D':\n        # If our last move was D too (mutual), try to reconcile\n        if last_my == 'D':\n            if opp_coop_rate > 0.5 and rng.random() < 0.4:\n                return 'C'\n            return 'D'\n        # Opponent defected while we cooperated: retaliate\n        # but forgiving if opponent is generally cooperative\n        if opp_coop_rate > 0.65:\n            return 'C' if rng.random() < 0.5 else 'D'\n        return 'D'\n\n    # Opponent cooperated last round\n    if last_my == 'D':\n        # They forgave our defection: cooperate back but be wary\n        if opp_coop_rate > 0.7 and recent_d <= 1:\n            return 'C'\n        return 'C'\n\n    # Both cooperated. Generally cooperate, with controlled exploitation\n    if opp_coop_rate > 0.6:\n        # Exploit the occasional forgiving cooperator\n        if n >= 20 and n < 85 and recent_d == 0 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # Moderately cooperative opponent; cooperate more often than not\n    if rng.random() < opp_coop_rate:\n        return 'C'\n    return 'D'"
  },
