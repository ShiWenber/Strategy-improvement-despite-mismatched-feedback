    "name": "seed1-rank3-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Gather counts and recent behavior.\n    cc = 0\n    cd = 0\n    dc = 0\n    dd = 0\n    for i in range(n):\n        mine, opp = history[i]\n        if mine == 'C':\n            if opp == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if opp == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    last_me, last_opp = history[-1]\n    remaining = 100 - n\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    coop_rate = opp_c / n if n > 0 else 0.5\n\n    # Fast forgiveness after a single defection, especially against TFT-like\n    # or ALLC-like opponents. This keeps mutual cooperation high.\n    if last_opp == 'D':\n        if n >= 2:\n            prev_opp = history[-2][1]\n        else:\n            prev_opp = 'C'\n        if prev_opp == 'C':\n            # Single recent defection: usually forgive immediately to restore CC.\n            if coop_rate >= 0.4 or n < 15:\n                if remaining > 3:\n                    return 'C'\n\n    # Hard endgame: exploit cooperators, protect against defectors.\n    if remaining <= 4:\n        if coop_rate > 0.5 and last_opp == 'C':\n            return 'D'\n        if coop_rate < 0.3:\n            return 'D'\n        if coop_rate > 0.5:\n            return 'D'\n        return 'C'\n\n    # Detect long opponent defect streak.\n    opp_d_streak = 0\n    for i in reversed(range(n)):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    my_d_streak = 0\n    for i in reversed(range(n)):\n        if history[i][0] == 'D':\n            my_d_streak += 1\n        else:\n            break\n\n    # If we are trapped in DD spiral, extend an olive branch occasionally.\n    if opp_d_streak >= 2 and my_d_streak >= 2:\n        # Against highly cooperative history, try to restart cooperation.\n        if coop_rate >= 0.6 and rng.random() < 0.35 and remaining > 8:\n            return 'C'\n        # Against moderate opponents, occasional repair.\n        if coop_rate >= 0.4 and rng.random() < 0.15 and remaining > 8:\n            return 'C'\n        return 'D'\n\n    # Strongly exploitative opponents: defect.\n    if coop_rate < 0.25:\n        return 'D'\n\n    # Conditional cooperation estimates.\n    coop_after_c = cc / (cc + cd) if (cc + cd) > 0 else 0.5\n    coop_after_d = dc / (dc + dd) if (dc + dd) > 0 else 0.5\n\n    # Opponent very cooperative overall: keep cooperating, with rare probe.\n    if coop_rate >= 0.85:\n        if remaining <= 6:\n            return 'D'\n        if n >= 20 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Opponent who cooperates even after we defect is a candidate to exploit,\n    # but only cautiously so we do not destroy a good relationship.\n    if coop_after_d > 0.65 and coop_rate > 0.55:\n        if remaining > 15 and n > 10:\n            # Occasionally take advantage when opponent just cooperated.\n            if last_opp == 'C' and rng.random() < 0.18:\n                return 'D'\n        return 'C'\n\n    # Exploitative conditional cooperator: punish.\n    if coop_after_c < 0.35:\n        return 'D'\n\n    # React to last opponent move using a forgiving TFT-like rule.\n    if last_opp == 'C':\n        if last_me == 'D':\n            return 'C'\n        return 'C'\n\n    # last_opp == 'D'\n    if last_me == 'C':\n        if coop_rate > 0.6 and remaining > 10 and rng.random() < 0.4:\n            return 'C'\n        return 'D'\n    return 'D'"
  },
