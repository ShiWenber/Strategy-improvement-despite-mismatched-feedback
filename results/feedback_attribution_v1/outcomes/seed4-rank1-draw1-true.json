  "child": {
    "name": "seed4-rank1-draw1-true",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Count outcomes\n    cc = cd = dc = dd = 0\n    for me, op in history:\n        if me == 'C':\n            if op == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    opp_c_rate = opp_c / n\n\n    last_me, last_op = history[-1]\n\n    # Defect on the last round against cooperative opponents to grab +5.\n    if n == 99:\n        if opp_c_rate > 0.5:\n            return 'D'\n        if last_op == 'C':\n            return 'D'\n        return 'C'\n\n    # Detect persistent defector.\n    if n >= 8 and opp_c_rate <= 0.1:\n        if n % 19 == 0:\n            return 'C'\n        return 'D'\n\n    # Detect pure cooperator: exploit heavily but occasionally keep them alive.\n    if n >= 10 and opp_c >= n - 1:\n        if n % 7 == 0:\n            return 'C'\n        return 'D'\n\n    # Detect mostly cooperative opponent.\n    if opp_c_rate >= 0.85 and n >= 5:\n        if last_op == 'D':\n            # Brief retaliation then return to cooperation.\n            if n >= 2 and history[-2][1] == 'D':\n                return 'D'\n            return 'D'\n        # Occasional probing exploit.\n        if rng.random() < 0.04 and n < 90:\n            return 'D'\n        return 'C'\n\n    # Detect tit-for-tat-ish mirror opponent.\n    if n >= 6:\n        mirror_hits = 0\n        for i in range(1, n):\n            if history[i][1] == history[i - 1][0]:\n                mirror_hits += 1\n        if mirror_hits * 4 >= (n - 1) * 3:\n            if last_op == 'C':\n                if rng.random() < 0.05 and n < 90:\n                    return 'D'\n                return 'C'\n            if rng.random() < 0.08:\n                return 'C'\n            return 'D'\n\n    # Recent behavior window.\n    win = history[-12:]\n    r_opp_c = sum(1 for a, b in win if b == 'C')\n    rn = len(win)\n    r_rate = r_opp_c / rn\n\n    # Count consecutive opponent defections.\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Persistent defection streak: punish.\n    if opp_d_streak >= 3:\n        if opp_c_rate < 0.3:\n            return 'D'\n        if opp_d_streak >= 5:\n            return 'D'\n\n    # If recently mostly cooperative, cooperate but retaliate to a defection.\n    if r_rate >= 0.75:\n        if last_op == 'D':\n            if opp_d_streak >= 2:\n                return 'D'\n            if rng.random() < 0.3:\n                return 'C'\n            return 'D'\n        return 'C'\n\n    # If recently mostly defecting, defect hard.\n    if r_rate <= 0.25:\n        if rng.random() < 0.92:\n            return 'D'\n        return 'C'\n\n    # Mid-range: imitate last opponent action, with slight forgiveness.\n    if last_op == 'C':\n        return 'C'\n    if rng.random() < 0.2:\n        return 'C'\n    return 'D'"
  },
