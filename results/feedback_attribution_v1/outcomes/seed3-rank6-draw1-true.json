  "child": {
    "name": "seed3-rank6-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    remaining = 100 - n\n\n    # Endgame: exploit near the end.\n    if remaining <= 1:\n        return 'D'\n    if remaining == 2:\n        # If opponent has been very cooperative, defect to grab DC.\n        opp_c = sum(1 for o in opp if o == 'C')\n        if opp_c >= n * 0.7:\n            return 'D'\n        return 'C'\n    if remaining == 3:\n        opp_c = sum(1 for o in opp if o == 'C')\n        if opp_c >= n * 0.8:\n            return 'D'\n        return 'C'\n\n    # Opening: cooperate a few rounds to establish CC.\n    if n < 4:\n        return 'C'\n\n    opp_c = 0\n    for o in opp:\n        if o == 'C':\n            opp_c += 1\n    opp_d = n - opp_c\n    rate = opp_c / float(n)\n\n    last_opp = opp[n - 1]\n    last_me = me[n - 1]\n\n    # Count recent defections.\n    recent_start = n - 6 if n > 6 else 0\n    recent_d = 0\n    for i in range(recent_start, n):\n        if opp[i] == 'D':\n            recent_d += 1\n    recent_len = n - recent_start\n    recent_def_rate = recent_d / float(recent_len)\n\n    # Against an always-cooperative opponent, alternate cooperation with rare exploitation.\n    if opp_d == 0:\n        if n < 8:\n            return 'C'\n        # Moderate exploitation: about 1 in 6.\n        if rng.random() < 0.17:\n            return 'D'\n        return 'C'\n\n    # Opponent never cooperates: defect, with rare cooperation probes.\n    if opp_c == 0:\n        if n % 9 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent highly defective overall: mostly defect.\n    if rate <= 0.25:\n        if n % 5 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent highly cooperative: cooperate but exploit occasionally.\n    if rate >= 0.85:\n        if recent_def_rate > 0.3:\n            # Recent defections mean be more cautious.\n            return 'D' if last_opp == 'D' else 'C'\n        if rng.random() < 0.1:\n            return 'D'\n        return 'C'\n\n    # Retaliate against a defection.\n    if last_opp == 'D':\n        # If we cooperated last round and got defected, quick retaliation.\n        if last_me == 'C':\n            return 'D'\n        # If we both defected, try occasional cooperation to escape DD.\n        if n % 3 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    if last_me == 'D':\n        # We defected and they cooperated; reward them with cooperation.\n        if rate >= 0.4:\n            return 'C'\n        return 'D'\n\n    # Both cooperated. Consider probing.\n    if rate >= 0.6:\n        if recent_def_rate == 0.0:\n            if rng.random() < 0.06:\n                return 'D'\n            return 'C'\n        return 'C'\n    if rate >= 0.4:\n        if recent_def_rate > 0.4:\n            return 'D'\n        return 'C'\n\n    # Mixed/low cooperation opponent. Tit-for-tat with slight forgiveness.\n    if recent_def_rate >= 0.5:\n        return 'D'\n    return 'C'"
  },
