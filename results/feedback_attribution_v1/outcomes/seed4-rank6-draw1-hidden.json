  "child": {
    "name": "seed4-rank6-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Quick tallies\n    cc = cd = dc = dd = 0\n    for me, op in history:\n        if me == 'C':\n            if op == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_C = cc + dc\n    opp_D = cd + dd\n    my_C = cc + cd\n    my_D = dc + dd\n\n    # Very short matches: cooperate, but respond to immediate defection.\n    if n < 3:\n        return 'C'\n\n    # Fit a mirror model: does opponent copy our previous move?\n    mirror_hits = 0\n    mirror_total = 0\n    for i in range(1, n):\n        if history[i][1] == history[i - 1][0]:\n            mirror_hits += 1\n        mirror_total += 1\n    mirror_rate = mirror_hits / mirror_total if mirror_total else 0.0\n\n    # Last few opponent moves\n    opp_last = history[-1][1]\n    opp_prev = history[-2][1]\n\n    # Count recent behavior\n    window = history[-12:]\n    r_cc = r_cd = r_dc = r_dd = 0\n    for me, op in window:\n        if me == 'C':\n            if op == 'C':\n                r_cc += 1\n            else:\n                r_cd += 1\n        else:\n            if op == 'C':\n                r_dc += 1\n            else:\n                r_dd += 1\n    rn = len(window)\n    r_opp_C = (r_cc + r_dc) / rn\n    r_opp_D = 1.0 - r_opp_C\n\n    # Ending phase: exploit known defectors, secure cooperation otherwise.\n    remaining = 100 - n\n    if remaining <= 2:\n        if opp_C * 3 >= opp_D * 2:\n            return 'C'\n        return 'D'\n\n    # Detect constant cooperator and exploit on selected rounds only.\n    if opp_C >= n - 1 and n >= 6:\n        # Avoid triggering retaliation; mostly cooperate, defect sparingly.\n        if my_D == 0 and n < 96:\n            if n % 7 == 3:\n                return 'D'\n        return 'C'\n\n    # Detect relentless defector.\n    if opp_D >= n - 1 and n >= 4:\n        if opp_D * 4 >= n * 3:\n            # Punish, but occasionally test for a converted opponent.\n            if n % 11 == 0:\n                return 'C'\n            return 'D'\n\n    # If opponent is extremely cooperative recently, stay cooperative.\n    if r_opp_C >= 0.9 and n >= 8:\n        if opp_last == 'D':\n            # Single punishment, then revert unless repeated.\n            if opp_prev == 'D':\n                return 'D'\n            return 'D'\n        return 'C'\n\n    # If opponent is mostly defecting recently, defect.\n    if r_opp_D >= 0.8 and n >= 8:\n        if n % 9 == 0:\n            return 'C'\n        return 'D'\n\n    # Mirror-model opponents: match their cooperation, punish defection.\n    if mirror_rate >= 0.7 and n >= 6:\n        if opp_last == 'C':\n            return 'C'\n        # They defected, likely reacting to us. Occasionally both reset.\n        if opp_prev == 'D' and r_opp_C >= 0.4 and rng.random() < 0.4:\n            return 'C'\n        return 'D'\n\n    # Balanced regime: cooperate while opponent is decent, retaliate on runs.\n    # Count current opponent defection streak.\n    op_streak_d = 0\n    for me, op in reversed(history):\n        if op == 'D':\n            op_streak_d += 1\n        else:\n            break\n\n    op_streak_c = 0\n    for me, op in reversed(history):\n        if op == 'C':\n            op_streak_c += 1\n        else:\n            break\n\n    # Long defection streak: punish harder, but avoid permanent lock-in.\n    if op_streak_d >= 3:\n        if op_streak_d >= 6 and opp_C * 2 >= n:\n            # They may be testing; try resetting occasionally.\n            if rng.random() < 0.25:\n                return 'C'\n        return 'D'\n\n    # Long cooperation streak: keep cooperating, rare probe.\n    if op_streak_c >= 4:\n        if my_D > 0 and n > 20 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Tit-for-tat with forgiveness tuned to opponent's reliability.\n    if opp_last == 'D':\n        if rng.random() < 0.12:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated.\n    # If we have been exploiting a lot, be careful of provoking them.\n    if my_D >= 3 and dc >= 2:\n        return 'C'\n\n    # Occasional probe when opponent seems very cooperative but not perfect.\n    if n >= 10 and r_opp_C >= 0.75 and opp_D <= 4 and n < 95:\n        if my_D == 0 and rng.random() < 0.07:\n            return 'D'\n\n    return 'C'"
  },
