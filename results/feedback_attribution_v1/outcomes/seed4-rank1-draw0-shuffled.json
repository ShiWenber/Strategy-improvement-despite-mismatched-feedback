  "child": {
    "name": "seed4-rank1-draw0-shuffled",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    cc = cd = dc = dd = 0\n    for a, b in history:\n        if a == 'C':\n            if b == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if b == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    my_c = cc + cd\n    my_d = dc + dd\n    last_opp = opp[-1]\n    last_me = me[-1]\n    remaining = 100 - n\n\n    # Detect notable opponent types.\n    pure_coop = opp_d == 0\n    pure_defect = opp_c == 0\n    opp_rate = opp_c / n\n\n    # Endgame: exploit known cooperators; defect against defectors.\n    if remaining <= 2:\n        if opp_rate >= 0.7:\n            return 'D'\n        if opp_rate <= 0.35:\n            return 'D'\n        return 'C'\n\n    # Against pure cooperators, exploit in the last part but keep them around.\n    if pure_coop:\n        if remaining <= 20:\n            return 'D'\n        if n % 7 == 0:\n            return 'D'\n        return 'C'\n\n    # Against pure defectors, defect (no point cooperating).\n    if pure_defect:\n        if remaining <= 5 and rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    # Compute streaks.\n    opp_c_streak = 0\n    for a in reversed(opp):\n        if a == 'C':\n            opp_c_streak += 1\n        else:\n            break\n\n    opp_d_streak = 0\n    for a in reversed(opp):\n        if a == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    my_d_streak = 0\n    for a in reversed(me):\n        if a == 'D':\n            my_d_streak += 1\n        else:\n            break\n\n    # Recent window analysis.\n    w = min(n, 12)\n    recent_opp = opp[-w:]\n    recent_c = recent_opp.count('C')\n    recent_d = w - recent_c\n\n    # Very cooperative opponent: mostly cooperate, occasional small probe.\n    if opp_rate >= 0.85 and opp_c_streak >= 3:\n        return 'C'\n\n    # If opponent was just caught defecting after long cooperation:\n    # retaliate briefly but don't spiral.\n    if last_opp == 'D' and opp_c_streak == 0:\n        if opp_d_streak >= 3:\n            return 'D'\n        if recent_c >= 6:\n            return 'C'\n        return 'D' if rng.random() < 0.85 else 'C'\n\n    # Opponent just cooperated.\n    if last_opp == 'C':\n        # If we are currently retaliating and they cooperated, reciprocate.\n        if last_me == 'D':\n            return 'C'\n        # If opponent has been moderately cooperative, cooperate.\n        if opp_rate >= 0.5:\n            return 'C'\n        # Low overall cooperation but decent recent: cooperate cautiously.\n        if recent_c >= 6:\n            return 'C'\n        # Exploit a bit if they've been very nice but we've had many DC opportunities.\n        if dc >= 3 and opp_rate >= 0.6 and remaining > 15:\n            if rng.random() < 0.15:\n                return 'D'\n        return 'C' if rng.random() < 0.7 else 'D'\n\n    # Default fallback: tit-for-tat with slight forgiveness.\n    if last_opp == 'C':\n        return 'C'\n    if recent_d >= 5 and my_d_streak >= 2:\n        return 'D'\n    return 'D' if rng.random() < 0.85 else 'C'"
  },
