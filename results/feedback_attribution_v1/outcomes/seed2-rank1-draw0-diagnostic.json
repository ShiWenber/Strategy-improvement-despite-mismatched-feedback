  "child": {
    "name": "seed2-rank1-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n\n    # Tally opponent behaviour\n    coop = 0\n    defd = 0\n    for h in history:\n        if h[1] == 'C':\n            coop += 1\n        else:\n            defd += 1\n\n    # Recent opponent window (last 8) for responsiveness\n    tail = history[-min(8, n):]\n    tail_c = 0\n    tail_d = 0\n    for h in tail:\n        if h[1] == 'C':\n            tail_c += 1\n        else:\n            tail_d += 1\n\n    last_opp = history[-1][1]\n    last_me = history[-1][0]\n\n    # Strong detected defector: punish decisively\n    if defd >= 3 and defd * 2 > coop:\n        # but exploit endgame harder\n        if n >= 95:\n            return 'D'\n        return 'D'\n\n    # Opponent essentially cooperative: stay cooperative, mild end probing\n    if coop >= 3 and coop * 2 >= defd * 3:\n        if n >= 92 and rng.random() < 0.10:\n            return 'D'\n        return 'C'\n\n    # Handle the perturbation / recovery zone robustly.\n    # If opponent defected only once recently and has a cooperative history, forgive promptly.\n    if last_opp == 'D':\n        if tail_d <= 1 and coop >= 3:\n            # quick forgiveness to restore CC\n            return 'C'\n        if tail_d <= 2 and coop >= 5 and defd * 3 < n:\n            if rng.random() < 0.5:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last\n    if last_me == 'D':\n        return 'C'\n    if n >= 85 and rng.random() < 0.07:\n        return 'D'\n    return 'C'"
  },
