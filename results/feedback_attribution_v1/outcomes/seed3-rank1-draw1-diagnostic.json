  "child": {
    "name": "seed3-rank1-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n    last_opp = opp[-1]\n\n    opp_c = 0\n    for x in opp:\n        if x == 'C':\n            opp_c += 1\n    opp_defects = n - opp_c\n\n    remaining = 100 - n\n\n    if remaining <= 1:\n        return 'D'\n\n    if opp_defects == 0:\n        if remaining <= 8:\n            if remaining <= 3:\n                return 'D'\n            if rng.random() < 0.5:\n                return 'D'\n        return 'C'\n\n    k = 10\n    if n < k:\n        k = n\n    recent_opp_c = 0\n    i = n - k\n    while i < n:\n        if opp[i] == 'C':\n            recent_opp_c += 1\n        i += 1\n    recent_rate = recent_opp_c / float(k)\n\n    if last_opp == 'C':\n        if recent_rate >= 0.7:\n            if remaining <= 4 and rng.random() < 0.4:\n                return 'D'\n            return 'C'\n        if recent_rate >= 0.4:\n            if opp_defects * 3 < n:\n                return 'C'\n            if rng.random() < 0.7:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    if me[-1] == 'C':\n        if recent_rate >= 0.6:\n            return 'D'\n        if opp_defects * 2 < n:\n            return 'D'\n        return 'D'\n\n    run_c = 0\n    j = n - 1\n    while j >= 0 and opp[j] == 'C':\n        run_c += 1\n        j -= 1\n\n    if run_c >= 3:\n        if rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    if run_c >= 1 and recent_rate >= 0.5:\n        if n % 5 == 0:\n            return 'C'\n        return 'D'\n\n    if n % 4 == 0:\n        return 'C'\n    return 'D'"
  },
