  "child": {
    "name": "seed1-rank3-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    remaining = 100 - n\n\n    # Tally conditional cooperation stats and overall counts.\n    cc = cd = dc = dd = 0\n    my_d = 0\n    last_opp = history[-1][1]\n    last_me = history[-1][0]\n\n    for i in range(n):\n        mine, opp = history[i]\n        if mine == 'C':\n            if opp == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            my_d += 1\n            if opp == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    coop_rate = opp_c / n\n\n    coop_after_c = cc / (cc + cd) if (cc + cd) > 0 else 0.5\n    coop_after_d = dc / (dc + dd) if (dc + dd) > 0 else 0.5\n\n    # Detect streaks at the tail.\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    opp_c_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'C':\n            opp_c_streak += 1\n        else:\n            break\n\n    # Identify a persistently cooperative/unresponsive opponent.\n    very_coop = coop_rate > 0.85 and n >= 8\n    mostly_coop = coop_rate > 0.65\n    exploiter = coop_after_c < 0.35 and (cc + cd) >= 4\n    retaliator = coop_after_d < 0.35 and (dc + dd) >= 3\n    forgiving = coop_after_d > 0.6 and (dc + dd) >= 3\n\n    # Endgame: be more aggressive, but avoid provoking retaliators into\n    # a costly DD tail; exploit cooperators.\n    if remaining == 0:\n        return 'D'\n    if remaining <= 2:\n        if coop_rate > 0.5 or (last_opp == 'C' and not retaliator):\n            return 'D'\n        return 'D'\n    if remaining <= 6:\n        if very_coop or (not retaliator and coop_rate > 0.55):\n            return 'D'\n        if last_opp == 'C' and coop_after_d < 0.4:\n            # Punitive opponent; avoid unprovoked D hurting future rounds\n            return 'C' if remaining > 3 else 'D'\n        if last_opp == 'D' and not forgiving:\n            return 'D'\n        return 'C'\n\n    # Early game: open cooperatively, punish immediate defection once.\n    if n < 3:\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Against a relentless defector, cut losses.\n    if coop_rate < 0.15 and n >= 6:\n        # Occasional probe in case they respond to cooperation.\n        if n % 11 == 0:\n            return 'C'\n        return 'D'\n\n    # Exploit a very cooperative opponent sparingly, preserving mutual CC.\n    if very_coop and remaining > 12:\n        # Don't defect if we already defected recently (avoid rebuilding cost).\n        if opp_d_streak == 0 and last_me == 'C':\n            if n % 5 == 4:\n                return 'D'\n        return 'C'\n\n    # If opponent just defected:\n    if last_opp == 'D':\n        # Two or more consecutive D -> retaliate.\n        if opp_d_streak >= 2:\n            # But if opponent is genuinely forgiving and cooperative overall,\n            # try to repair after a long enough punishment.\n            if forgiving and coop_rate > 0.6 and opp_d_streak <= 2 and remaining > 15 and n % 3 == 0:\n                return 'C'\n            return 'D'\n        # Single defection: retaliate, but occasionally forgive to restore CC.\n        if forgiving and coop_rate > 0.6 and remaining > 12:\n            if rng.random() < 0.35:\n                return 'C'\n        # Against an exploitative opponent, always punish.\n        if exploiter:\n            return 'D'\n        # Default TFT-like retaliation.\n        return 'D'\n\n    # Opponent just cooperated.\n    if last_me == 'D':\n        # We defected and they still cooperated -> they are being generous;\n        # return to cooperation to keep harvesting their generosity.\n        return 'C'\n\n    # Mutual cooperation (or our first C). Sustain it, but probe occasionally\n    # only against non-retaliatory opponents.\n    if retaliator and coop_rate > 0.5:\n        return 'C'\n\n    if coop_rate > 0.7 and not retaliator and remaining > 15:\n        # Rare probing defection; avoid if opponent retaliates strongly.\n        if coop_after_d > 0.5 or coop_after_c > 0.5:\n            if n % 9 == 8:\n                return 'D'\n\n    return 'C'"
  },
