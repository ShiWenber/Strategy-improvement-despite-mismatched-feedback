  "child": {
    "name": "seed1-rank3-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Counts of opponent responses conditional on our previous action.\n    cc = cd = dc = dd = 0\n    for mine, opp in history:\n        if mine == 'C':\n            if opp == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if opp == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    total = n\n    coop_rate = opp_c / total if total else 0.5\n    # P(opp cooperates | our last action was C/D)\n    p_c_after_c = cc / (cc + cd) if (cc + cd) > 0 else 0.5\n    p_c_after_d = dc / (dc + dd) if (dc + dd) > 0 else 0.5\n\n    last_me, last_opp = history[-1]\n    remaining = 100 - n\n\n    # Endgame: defect aggressively in the last few rounds against\n    # opponents who are not strongly retaliatory.\n    if remaining <= 3:\n        return 'D'\n    if remaining <= 6:\n        if coop_rate > 0.55 and p_c_after_d > 0.35:\n            return 'D'\n        if last_opp == 'C':\n            return 'D'\n\n    # Early game: cooperative opening, but punish immediate double defection.\n    if n < 3:\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Opponent defect streak detection.\n    opp_d_streak = 0\n    for _, o in reversed(history):\n        if o == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    my_d_streak = 0\n    for m, _ in reversed(history):\n        if m == 'D':\n            my_d_streak += 1\n        else:\n            break\n\n    # Strong mutual-defection escape: cooperate if we're both stuck.\n    if my_d_streak >= 3 and opp_d_streak >= 3:\n        return 'C'\n\n    # Detecting a forgiving / cooperative opponent:\n    # They often cooperate even right after our defections.\n    forgiving = p_c_after_d > 0.55\n    retaliatory = p_c_after_d < 0.3\n    exploitable = coop_rate > 0.75 and retaliatory == False\n\n    # If opponent is highly cooperative overall, mostly cooperate\n    # but add occasional probationary defection to keep them honest.\n    if coop_rate > 0.85:\n        if n < 60 and (n % 17 == 16) and p_c_after_d > 0.5:\n            return 'D'\n        return 'C'\n\n    # If opponent is mostly defecting, defect (protect score).\n    if coop_rate < 0.25:\n        if n < 90 and (n % 15 == 14):\n            return 'C'  # rare olive branch\n        return 'D'\n\n    # After an opponent defection:\n    if last_opp == 'D':\n        if opp_d_streak >= 3:\n            return 'D'\n        # Forgiving response after a single D if opponent recovers well.\n        if opp_d_streak == 1:\n            if forgiving and coop_rate > 0.55 and remaining > 8:\n                return 'C'\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last round.\n    # If we defected last round and they still cooperated, reward (unless endgame).\n    if last_me == 'D' and last_opp == 'C':\n        if remaining > 6:\n            return 'C'\n        return 'D'\n\n    # Both cooperated.\n    if last_me == 'C' and last_opp == 'C':\n        # If opponent is easily exploited, probe occasionally.\n        if exploitable and n > 8 and rng.random() < 0.12:\n            return 'D'\n        # If opponent rarely cooperates after our C, be cautious.\n        if p_c_after_c < 0.35:\n            if rng.random() < 0.5:\n                return 'D'\n        return 'C'\n\n    # Fallback tit-for-tat with slight forgiveness.\n    if last_opp == 'C':\n        return 'C'\n    if rng.random() < 0.2:\n        return 'C'\n    return 'D'"
  },
