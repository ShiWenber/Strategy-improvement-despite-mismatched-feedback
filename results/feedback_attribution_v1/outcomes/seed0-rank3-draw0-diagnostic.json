  "child": {
    "name": "seed0-rank3-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C' if history[0][1] == 'C' else 'D'\n\n    my = [h[0] for h in history]\n    op = [h[1] for h in history]\n    last_me = my[-1]\n    last_op = op[-1]\n    opp_c = op.count('C')\n    opp_d = n - opp_c\n    my_d = my.count('D')\n\n    # Consecutive opponent defections from the end\n    run_d = 0\n    for a in reversed(op):\n        if a == 'D':\n            run_d += 1\n        else:\n            break\n\n    # Consecutive opponent cooperations from the end\n    run_c = 0\n    for a in reversed(op):\n        if a == 'C':\n            run_c += 1\n        else:\n            break\n\n    if n >= 10:\n        rec = op[-10:]\n        rec_c = rec.count('C')\n        rec_d = 10 - rec_c\n    else:\n        rec_c = opp_c\n        rec_d = opp_d\n\n    if n >= 20:\n        w = op[-20:]\n        w_d = w.count('D')\n        w_c = 20 - w_d\n    else:\n        w_d = opp_d\n        w_c = opp_c\n\n    # Opponent is pure defector\n    if opp_d == n and n >= 3:\n        # Defect but occasionally test cooperation to allow recovery\n        if n < 90 and rng.random() < 0.03:\n            return 'C'\n        return 'D'\n\n    # Opponent has never defected - pure cooperator\n    if opp_d == 0:\n        # Exploit near the end, but maintain mutual cooperation most of the time\n        if n >= 94:\n            return 'D'\n        # Occasional probe for exploitation\n        if n >= 20 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Strong defection streak: punish hard\n    if run_d >= 3:\n        return 'D'\n\n    # Recent high defection rate\n    if n >= 8 and rec_d >= 6:\n        return 'D'\n\n    # Long-run high defection window\n    if n >= 20 and w_d >= 12:\n        # Mostly defect, tiny chance to reset\n        if rng.random() < 0.04:\n            return 'C'\n        return 'D'\n\n    # Opponent just defected\n    if last_op == 'D':\n        # If opponent is mostly cooperative overall, be forgiving to keep mutual cooperation\n        if opp_c >= 4 * opp_d and n >= 6:\n            # Forgive often when the defection is isolated\n            if run_d == 1 and rec_c >= 5:\n                if rng.random() < 0.7:\n                    return 'C'\n                return 'D'\n            # If we defected recently too, try to reset\n            if last_me == 'D' and rng.random() < 0.4:\n                return 'C'\n            return 'D'\n        # We defected last round and opponent is retaliating: try to reset sometimes\n        if last_me == 'D':\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last round\n    # If we defected last round, return to cooperation (avoid escalating)\n    if last_me == 'D':\n        # If opponent still mostly cooperates, cooperate to restore mutual\n        if opp_c >= 2 * opp_d:\n            return 'C'\n        if rng.random() < 0.6:\n            return 'C'\n        return 'D'\n\n    # Both cooperated\n    # If opponent is very cooperative and long-run stable, keep cooperating\n    if opp_d <= max(1, n // 12) and n <= 90:\n        if n >= 25 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Opponent moderately cooperative - return to C to build mutual cooperation\n    if rec_c >= 3 and n >= 5:\n        return 'C'\n\n    # Mixed opponent - use forgiving tit-for-tat\n    if opp_c > opp_d:\n        return 'C'\n\n    # Mostly defecting opponent\n    if n >= 90:\n        # Endgame: exploit if opponent historically cooperated a lot\n        if opp_c > 2 * opp_d and run_d == 0:\n            return 'D'\n        return 'D'\n    if rng.random() < 0.15:\n        return 'C'\n    return 'D'"
  },
