    "name": "seed1-rank6-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Tally opponent behavior.\n    opp_c = 0\n    for _, o in history:\n        if o == 'C':\n            opp_c += 1\n    opp_d = n - opp_c\n    remaining = 100 - n\n\n    # Endgame: exploit a cooperative opponent, protect against a defector.\n    if remaining <= 0:\n        return 'C'\n    if remaining <= 2:\n        if opp_c >= opp_d:\n            return 'D'\n        return 'D'\n\n    last_me, last_opp = history[-1]\n    if n >= 2:\n        prev_opp = history[-2][1]\n    else:\n        prev_opp = 'C'\n\n    # Current opponent cooperation streak.\n    opp_c_streak = 0\n    for _, o in reversed(history):\n        if o == 'C':\n            opp_c_streak += 1\n        else:\n            break\n\n    opp_d_streak = 0\n    for _, o in reversed(history):\n        if o == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    my_d_streak = 0\n    for m, _ in reversed(history):\n        if m == 'D':\n            my_d_streak += 1\n        else:\n            break\n\n    # Opening: cooperate to build trust, punish immediate defection.\n    if n < 4:\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Opponent has never defected: mostly cooperate, small calibrated probes.\n    if opp_d == 0:\n        # Probe occasionally before endgame to test receptiveness.\n        if n >= 10 and remaining > 10:\n            if n % 13 == 5:\n                return 'D'\n        return 'C'\n\n    # Opponent almost always defects: protect self.\n    if opp_d * 4 > n * 3:\n        # Rare olive branch to check for a switch.\n        if opp_d_streak >= 4 and rng.random() < 0.08:\n            return 'C'\n        return 'D'\n\n    # Opponent just defected after a long cooperative stretch - likely a\n    # noise/probe; forgive once, punish a repeat.\n    if last_opp == 'D':\n        if last_me == 'C':\n            if opp_d_streak == 1 and opp_c >= 3 and remaining > 5:\n                # Forgive an isolated defection.\n                return 'C'\n            return 'D'\n        # Both defected: try to break the DD spiral with a repair C.\n        if my_d_streak >= 2 and opp_d_streak >= 2:\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent just cooperated.\n    # If we defected last round, return to cooperation to rebuild.\n    if last_me == 'D':\n        # If opponent's overall cooperation is low, keep pressing.\n        if opp_c * 2 < n:\n            return 'D'\n        return 'C'\n\n    # Both cooperated: maintain mutual cooperation, with rare probes when\n    # the opponent seems tolerant (high cooperation overall).\n    if opp_c * 10 >= n * 9:\n        if remaining > 15 and n % 17 == 9:\n            return 'D'\n        return 'C'\n\n    # Opponent moderately cooperative: stay cooperative but retaliate fast.\n    if opp_c * 3 >= n * 2:\n        return 'C'\n\n    # Opponent is unreliable: mix cooperation/defection pushed toward C\n    # to avoid mutual-destruction spirals, but punish runs.\n    if opp_d_streak >= 2:\n        return 'D'\n    if prev_opp == 'D' and last_opp == 'C':\n        # One defection then cooperation: accept the apology.\n        return 'C'\n    return 'C'"
  },
