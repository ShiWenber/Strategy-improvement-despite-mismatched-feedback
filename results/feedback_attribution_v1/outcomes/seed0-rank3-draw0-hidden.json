  "child": {
    "name": "seed0-rank3-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    # If opponent has never defected, cooperate almost always\n    if opp_d == 0:\n        if n >= 90 and rng.random() < 0.3:\n            return 'D'\n        return 'C'\n    # If opponent has defected almost always, defect\n    if opp_d >= n - 1 and n >= 3:\n        return 'D'\n    # Count consecutive opponent defections at tail\n    run = 0\n    for a in reversed(opp):\n        if a == 'D':\n            run += 1\n        else:\n            break\n    # Long defection run: punish\n    if run >= 4:\n        return 'D'\n    # Recent window stats\n    recent = opp[-10:]\n    recent_d = recent.count('D')\n    last_opp = opp[-1]\n    last_my = my[-1]\n    # Endgame exploitation\n    if n >= 95:\n        if opp_c * 2 > n:\n            return 'C'\n        return 'D'\n    # Mostly cooperating opponent: cooperate, occasional probe\n    if opp_d * 6 <= n:\n        if n > 25 and n < 85 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n    # Mostly defecting opponent\n    if opp_d * 2 >= n:\n        if rng.random() < 0.05:\n            return 'C'\n        return 'D'\n    # Mixed: tit-for-tat with forgiveness\n    if last_opp == 'D':\n        if last_my == 'D':\n            if rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        if recent_d >= 4:\n            return 'D'\n        if rng.random() < 0.8:\n            return 'D'\n        return 'C'\n    # last_opp == 'C'\n    if last_my == 'D':\n        return 'C'\n    if recent_d >= 3:\n        return 'D'\n    return 'C'"
  },
