  "child": {
    "name": "seed4-rank6-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    op = [h[1] for h in history]\n    my = [h[0] for h in history]\n\n    # Tail exploitation: defect last 2 rounds against non-pure-cooperators,\n    # but only defect final round vs pure cooperators to preserve long-run gains.\n    if n == 99:\n        return 'D'\n    if n == 98:\n        opp_c_so_far = op.count('C')\n        if opp_c_so_far >= n - 2:\n            return 'C'\n        return 'D'\n\n    # Detect pure cooperator: opponent has never defected.\n    opp_defects = n - op.count('C')\n    if opp_defects == 0:\n        # Exploit mildly in late midgame while preserving cooperation.\n        if n >= 60 and n < 96:\n            if n % 5 == 0:\n                return 'D'\n        return 'C'\n\n    # Detect pure/hard defector: opponent almost never cooperates.\n    opp_c = n - opp_defects\n    if n >= 8 and opp_c * 4 <= n:\n        # Punish, but occasionally test cooperation to escape mutual-DD.\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # Count consecutive opponent defections and cooperations at tail.\n    opp_d_streak = 0\n    for a in reversed(op):\n        if a == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][0] == 'C' and history[i][1] == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    last_me, last_op = history[-1]\n\n    # Score-tracking for strategic decisions.\n    exploitations = 0\n    mutual_c = 0\n    my_d_on_c = 0\n    for i in range(n):\n        m = my[i]\n        o = op[i]\n        if m == 'C' and o == 'D':\n            exploitations += 1\n        elif m == 'C' and o == 'C':\n            mutual_c += 1\n        elif m == 'D' and o == 'C':\n            my_d_on_c += 1\n\n    # Late game: if we are getting exploited heavily, harden.\n    if n >= 85:\n        if exploitations >= 4 and mutual_c < exploitations:\n            return 'D'\n        if opp_defects >= n // 3:\n            return 'D'\n        if last_op == 'D' and opp_d_streak >= 2:\n            return 'D'\n        return 'C'\n\n    # If opponent just defected: retaliate, but forgive if they have been\n    # mostly cooperative and we haven't been repeatedly punished.\n    if last_op == 'D':\n        if opp_d_streak >= 3:\n            # Sustained defection: punish hard, with rare cooperation test.\n            if rng.random() < 0.05:\n                return 'C'\n            return 'D'\n        if opp_defects * 4 <= n:\n            # Isolated defection from a mostly-cooperative opponent.\n            # Forgive frequently to maintain mutual cooperation.\n            if rng.random() < 0.55:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent just cooperated.\n    # If we just defected and they still cooperated, they are exploitable.\n    if last_me == 'D' and last_op == 'C':\n        # Avoid over-exploiting: sometimes return to cooperation.\n        if my_d_on_c >= 2 and rng.random() < 0.55:\n            return 'C'\n        if rng.random() < 0.6:\n            return 'D'\n        return 'C'\n\n    # Strong mutual cooperation: keep cooperating.\n    if cc_streak >= 3:\n        return 'C'\n\n    # Mid-game probing: if opponent is very cooperative and rarely punishes,\n    # occasionally defect for extra points.\n    if n >= 25 and opp_defects <= max(2, n // 25):\n        if rng.random() < 0.10:\n            return 'D'\n\n    # If we have been cooperating a lot against a defector, become defensive.\n    if exploitations >= 3 and exploitations > mutual_c:\n        if rng.random() < 0.10:\n            return 'C'\n        return 'D'\n\n    # Default: cooperate to sustain mutual cooperation.\n    return 'C'"
  },
