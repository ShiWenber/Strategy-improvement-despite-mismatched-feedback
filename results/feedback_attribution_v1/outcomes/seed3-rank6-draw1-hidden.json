    "name": "seed3-rank6-draw1-hidden",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    # --- openings ---\n    if n < 8:\n        return 'C'\n\n    last_opp = opp[n - 1]\n\n    # --- strong retaliation with limited forgiveness ---\n    if last_opp == 'D':\n        # count consecutive opponent defections at tail\n        run_d = 0\n        i = n - 1\n        while i >= 0 and opp[i] == 'D':\n            run_d += 1\n            i -= 1\n        # count recent opponent cooperation\n        k = n if n < 10 else 10\n        recent_c = 0\n        for j in range(n - k, n):\n            if opp[j] == 'C':\n                recent_c += 1\n        # if they've been mostly cooperative, retaliate once then forgive\n        if recent_c >= k - 2:\n            return 'D'\n        # if they've been mostly defecting, keep defecting\n        return 'D'\n\n    # opponent cooperated last round\n    # count overall cooperation\n    opp_c = 0\n    for x in opp:\n        if x == 'C':\n            opp_c += 1\n    opp_d = n - opp_c\n\n    # never let exploiters off easy: if many defections overall\n    if opp_d >= n * 0.5 and n >= 10:\n        # mix: mostly defect to avoid being milked\n        if rng.random() < 0.85:\n            return 'D'\n        return 'C'\n\n    # pure defector detection\n    if opp_d >= n - 1 and n >= 10:\n        return 'D'\n\n    # cooperative spectrum\n    recent_k = n if n < 12 else 12\n    recent_opp_d = 0\n    for j in range(n - recent_k, n):\n        if opp[j] == 'D':\n            recent_opp_d += 1\n\n    # if recently clean, cooperate but rarely probe\n    if recent_opp_d == 0:\n        # rare exploitation probe against very cooperative opponents\n        if n > 25 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # if moderately clean, cooperate\n    if recent_opp_d <= 2:\n        return 'C'\n\n    # mixed: tit-for-tat flavor with occasional forgiveness\n    # count consecutive opponent cooperations at tail\n    run_c = 0\n    i = n - 1\n    while i >= 0 and opp[i] == 'C':\n        run_c += 1\n        i -= 1\n\n    if run_c >= 3:\n        return 'C'\n\n    # if last two opponent moves are D, punish\n    if n >= 2 and opp[n - 1] == 'D':\n        return 'D'\n\n    # adaptive: if our last was D they may retaliate; restore cooperation\n    return 'C'"
  },
