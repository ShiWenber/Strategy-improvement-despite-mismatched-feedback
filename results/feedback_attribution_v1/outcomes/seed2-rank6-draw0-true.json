  "child": {
    "name": "seed2-rank6-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 99:\n        return 'D'\n    opp = [b for a, b in history]\n    me = [a for a, b in history]\n    opp_last = opp[-1]\n    my_last = me[-1]\n    opp_d = sum(1 for x in opp if x == 'D')\n    my_d = sum(1 for x in me if x == 'D')\n\n    # Detect always-defector / heavy defector\n    if opp_d >= 5 and opp_d * 3 > n * 2:\n        return 'D'\n\n    # Pure cooperator: exploit late but stay cooperative otherwise.\n    if opp_d == 0:\n        if n >= 95:\n            return 'D'\n        return 'C'\n\n    # Very cooperative opponent (rare defections)\n    if opp_d * 6 <= n:\n        # Exploit late\n        if n >= 92:\n            return 'D'\n        # Retaliate briefly against recent defections\n        if opp_last == 'D':\n            return 'D' if n < 96 and rng.random() < 0.85 else 'C'\n        # Rare probe\n        if n >= 20 and n < 90 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Mixed / moderately defective opponent: tit-for-tat with forgiveness.\n    if opp_last == 'D':\n        # Count consecutive recent defections\n        run = 0\n        for x in reversed(opp):\n            if x == 'D':\n                run += 1\n            else:\n                break\n        if run >= 2:\n            return 'D'\n        # Single defection: retaliate, occasionally forgive to restore cooperation.\n        if opp_d * 2 < n and rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last.\n    if my_last == 'D':\n        # We defected; return to cooperation unless opponent is bad.\n        if opp_d * 2 > n:\n            return 'D' if rng.random() < 0.7 else 'C'\n        return 'C'\n    # Both cooperated; occasional late probe\n    if n >= 85 and opp_d * 4 < n and rng.random() < 0.15:\n        return 'D'\n    if n >= 20 and rng.random() < 0.03:\n        return 'D'\n    return 'C'"
  },
