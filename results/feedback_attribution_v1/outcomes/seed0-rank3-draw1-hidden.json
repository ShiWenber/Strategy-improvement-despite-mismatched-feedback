  "child": {
    "name": "seed0-rank3-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    my_d = my.count('D')\n\n    if opp_d == 0:\n        if n >= 90:\n            return 'C'\n        if n >= 40 and my_d == 0:\n            return 'C'\n        if n >= 5 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    if opp_d >= n - 1 and n >= 3:\n        return 'D'\n\n    run = 0\n    for a in reversed(opp):\n        if a == 'D':\n            run += 1\n        else:\n            break\n    if run >= 4:\n        return 'D'\n\n    recent = opp[-8:] if n >= 8 else opp\n    rdef = recent.count('D')\n    rlen = len(recent)\n\n    if rdef * 2 >= rlen and n >= 6:\n        if rng.random() < 0.12:\n            return 'C'\n        return 'D'\n\n    if n >= 20:\n        last20 = opp[-20:]\n        d20 = last20.count('D')\n        if d20 >= 14:\n            return 'D'\n        if d20 <= 2:\n            if n >= 85:\n                return 'C'\n            if rng.random() < 0.05:\n                return 'D'\n            return 'C'\n\n    last_opp = opp[-1]\n    last_my = my[-1]\n\n    if last_opp == 'D':\n        if n >= 3 and opp[-2] == 'C' and opp[-3] == 'C':\n            if rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        if last_my == 'D':\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        if rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    if last_my == 'D' and last_opp == 'C':\n        if n < 90 and opp_d * 5 <= n and rng.random() < 0.35:\n            return 'D'\n        return 'C'\n\n    if n >= 95:\n        if opp_d * 2 <= n:\n            return 'C'\n        return 'D'\n\n    if n >= 60 and rdef >= 2:\n        return 'D'\n\n    if opp_d <= max(1, n // 8) and n < 88 and rng.random() < 0.05:\n        return 'D'\n\n    return 'C'"
  },
