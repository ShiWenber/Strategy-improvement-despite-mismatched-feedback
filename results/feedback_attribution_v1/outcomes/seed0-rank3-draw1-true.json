  "child": {
    "name": "seed0-rank3-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    opp_recent = [h[1] for h in history[-10:]]\n    my_recent = [h[0] for h in history[-10:]]\n    opp_last = opp_recent[-1]\n    my_last = my_recent[-1]\n\n    opp_d_total = sum(1 for h in history if h[1] == 'D')\n    my_d_total = sum(1 for h in history if h[0] == 'D')\n    opp_c_total = n - opp_d_total\n\n    # Consecutive defections from opponent at end\n    consec_d = 0\n    for h in reversed(history):\n        if h[1] == 'D':\n            consec_d += 1\n        else:\n            break\n\n    # Consecutive cooperations from opponent at end\n    consec_c = 0\n    for h in reversed(history):\n        if h[1] == 'C':\n            consec_c += 1\n        else:\n            break\n\n    # Very cooperative opponent: lock in, occasional cheap exploit near end\n    if opp_c_total >= n - 1:\n        if n >= 96:\n            return 'D'\n        return 'C'\n\n    # Opponent never cooperates: defect\n    if opp_c_total == 0:\n        return 'D'\n\n    # Detect mutual defection spiral\n    if len(history) >= 4:\n        last4 = history[-4:]\n        dd = sum(1 for m, o in last4 if m == 'D' and o == 'D')\n        if dd >= 3:\n            # Try to break out unless we're near the end\n            if n < 93:\n                return 'C'\n            return 'D'\n\n    # Opponent defected last round\n    if opp_last == 'D':\n        # Long defection streak: keep defecting\n        if consec_d >= 2:\n            return 'D'\n        # Opponent has been mostly cooperative overall: forgive sometimes\n        if opp_c_total * 4 >= n * 3 and n < 90:\n            if rng.random() < 0.55:\n                return 'C'\n        # Near the end, don't forgive cheap\n        if n >= 92:\n            return 'D'\n        # Retaliate, with slight forgiveness while we're ahead\n        if my_d_total < opp_d_total and rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round\n    # If we've been defecting while they cooperated, they might be a pushover or punishing soon\n    if my_last == 'D' and opp_last == 'C':\n        if n < 90:\n            return 'C'\n        return 'D'\n\n    # Both cooperated\n    # Long cooperative streak, mostly stay\n    if consec_c >= 3:\n        # Occasional opportunistic probe against cooperative opponents\n        if n < 90 and opp_c_total * 8 >= n * 7 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Opponent has moderate defection rate: mirror with slight forgiveness\n    opp_def_recent = opp_recent.count('D')\n    if opp_def_recent >= 4:\n        return 'D'\n    if opp_def_recent >= 2:\n        if rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Late game with mostly cooperative opponent: cooperate\n    if n >= 90:\n        if opp_c_total * 2 >= n:\n            return 'C'\n        return 'D'\n\n    return 'C'"
  },
