  "child": {
    "name": "seed1-rank6-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Compute helper statistics\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n\n    opp_c = 0\n    for x in opp:\n        if x == 'C':\n            opp_c += 1\n    opp_d = n - opp_c\n\n    my_c = 0\n    for x in my:\n        if x == 'C':\n            my_c += 1\n\n    last_me = my[-1]\n    last_opp = opp[-1]\n\n    remaining = 100 - n\n\n    # Count runs at the end of opponent history\n    def trailing_run(sym):\n        c = 0\n        for i in range(n - 1, -1, -1):\n            if opp[i] == sym:\n                c += 1\n            else:\n                break\n        return c\n\n    def trailing_run_my(sym):\n        c = 0\n        for i in range(n - 1, -1, -1):\n            if my[i] == sym:\n                c += 1\n            else:\n                break\n        return c\n\n    # Very early: cooperate to establish mutual cooperation\n    if n < 3:\n        return 'C'\n\n    opp_coop_rate = opp_c / n\n    my_coop_rate = my_c / n\n\n    # Endgame exploitation.  If opponent has been mostly cooperative, defect\n    # to grab the 5 payoff, but be careful not to trigger a long punishment\n    # spiral too far from the end.\n    if remaining == 0:\n        # final round\n        return 'D' if opp_coop_rate >= 0.35 else 'D'\n\n    if remaining <= 2:\n        # Near end, defecting is nearly always at least as good unless the\n        # opponent is very retaliatory.  Use last opponent action as signal.\n        if opp_coop_rate > 0.45:\n            return 'D'\n        if last_opp == 'C':\n            return 'D'\n        # If opponent is almost always defecting, a C might catch a stray C,\n        # but D guarantees at least 1.  Defect.\n        return 'D'\n\n    # If opponent has been almost entirely cooperative, keep cooperating but\n    # occasionally exploit to boost score.  Use small probe rate so we don't\n    # destroy cooperation.\n    if opp_d == 0:\n        if n >= 12 and remaining > 5:\n            if rng.random() < 0.12:\n                return 'D'\n        return 'C'\n\n    # If opponent is very defective, defect.\n    if opp_coop_rate < 0.30:\n        # But occasionally cooperate to try to restart mutual cooperation if\n        # there is enough time left.\n        if remaining > 20 and rng.random() < 0.06:\n            return 'C'\n        return 'D'\n\n    # Detect long streaks of mutual cooperation and protect them.\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if my[i] == 'C' and opp[i] == 'C':\n            cc_streak += 1\n        else:\n            break\n    if cc_streak >= 5:\n        # In a good CC streak, only defect rarely and not near beginning\n        if remaining > 3 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # Detect opponent defection streak.\n    opp_d_streak = trailing_run('D')\n    my_d_streak = trailing_run_my('D')\n\n    # If both are stuck in DD, try to break out with occasional C.\n    if last_opp == 'D' and last_me == 'D':\n        if opp_coop_rate > 0.4 and remaining > 10:\n            if rng.random() < 0.20:\n                return 'C'\n        return 'D'\n\n    # If we just defected while opponent cooperated, return to cooperation\n    # (reward their continued cooperation) unless they seem exploitable.\n    if last_me == 'D' and last_opp == 'C':\n        if opp_coop_rate > 0.5:\n            return 'C'\n        # If opponent is moderately defective, keep pressing?  Better to\n        # return to C to avoid long DD.\n        return 'C'\n\n    # If opponent just defected on our cooperation, retaliate once, then\n    # consider forgiving if they have generally been cooperative.\n    if last_me == 'C' and last_opp == 'D':\n        # If opponent has had very few defections, forgive quickly.\n        if opp_d <= max(1, n // 12) and remaining > 8:\n            # single defection from a mostly cooperative opponent: forgive\n            if rng.random() < 0.65:\n                return 'C'\n            return 'D'\n        # If they defected twice in a row, punish harder.\n        if opp_d_streak >= 2:\n            return 'D'\n        # Otherwise retaliate but with some forgiveness.\n        if rng.random() < 0.25 and opp_coop_rate > 0.55:\n            return 'C'\n        return 'D'\n\n    # Both cooperated last round: maintain cooperation with very small probe\n    # rate only when opponent is not obviously punitive.\n    if last_me == 'C' and last_opp == 'C':\n        # If opponent has never/rarely defected, occasional probing is fine.\n        if opp_d <= 2 and n > 15 and remaining > 5:\n            if rng.random() < 0.04:\n                return 'D'\n        return 'C'\n\n    # Fallback: copy opponent's last action.\n    return last_opp"
  },
