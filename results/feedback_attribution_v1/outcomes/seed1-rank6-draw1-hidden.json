    "name": "seed1-rank6-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n\n    me = [h[0] for h in history]\n    opp = [h[1] for h in history]\n    my_last = me[-1]\n    opp_last = opp[-1]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    coop_rate = opp_c / n\n\n    remaining = 100 - n\n\n    # Detect consecutive opponent defections at the tail\n    consec_d = 0\n    for o in reversed(opp):\n        if o == 'D':\n            consec_d += 1\n        else:\n            break\n\n    # Detect mutual cooperation streak\n    cc_streak = 0\n    for m, o in reversed(history):\n        if m == 'C' and o == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Detect cycles in opponent behavior (period 1-4)\n    cycle_pred = None\n    if n >= 8:\n        for p in range(1, 5):\n            if n >= 2 * p:\n                matches = True\n                for i in range(p):\n                    if opp[n - 1 - i] != opp[n - 1 - i - p]:\n                        matches = False\n                        break\n                if matches:\n                    cycle_pred = opp[n - p]\n                    break\n\n    # Endgame: exploit cooperators, protect against defectors\n    if remaining <= 3:\n        if coop_rate > 0.5:\n            return 'D'\n        return 'D'\n\n    # Strong retaliation against sustained defection\n    if consec_d >= 3:\n        if rng.random() < 0.08:\n            return 'C'\n        return 'D'\n\n    # If opponent is overwhelmingly defective, protect\n    if coop_rate < 0.25 and n >= 6:\n        if rng.random() < 0.05:\n            return 'C'\n        return 'D'\n\n    # Exploit a fully cooperative opponent with calibrated probing\n    if opp_d == 0 and n >= 15:\n        if remaining > 8 and rng.random() < 0.12:\n            return 'D'\n        return 'C'\n\n    # If we detect opponent's next move from a cycle, defect (5 > 3)\n    if cycle_pred is not None and remaining > 3:\n        if cycle_pred == 'C' and coop_rate > 0.4:\n            return 'D'\n        if cycle_pred == 'D':\n            return 'D'\n\n    # Reward cooperation after our defection (restore trust quickly)\n    if opp_last == 'C' and my_last == 'D':\n        return 'C'\n\n    # Opponent cooperated last round\n    if opp_last == 'C':\n        # Long mutual cooperation streak: stay stable, rare probe\n        if cc_streak >= 5:\n            if rng.random() < 0.02 and remaining > 10:\n                return 'D'\n            return 'C'\n        # Opponent mostly cooperative: occasional faint probe\n        if coop_rate > 0.85 and remaining > 12 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Opponent defected last round, isolated defection\n    if opp_last == 'D':\n        # Forgive an isolated defection if opponent is generally cooperative\n        if consec_d == 1 and coop_rate > 0.7 and rng.random() < 0.45:\n            return 'C'\n        # Defect back otherwise\n        return 'D'\n\n    return 'C'"
  },
