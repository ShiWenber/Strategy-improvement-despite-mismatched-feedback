    "name": "seed2-rank3-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Track scores to decide late-game behavior\n    my_score = 0\n    opp_score = 0\n    opp_def = 0\n    for m, o in history:\n        if o == 'D':\n            opp_def += 1\n        if m == 'C':\n            if o == 'C':\n                my_score += 3\n                opp_score += 3\n            else:\n                opp_score += 5\n        else:\n            if o == 'C':\n                my_score += 5\n            else:\n                my_score += 1\n                opp_score += 1\n\n    # Recent window of 8\n    w = min(8, n)\n    recent = history[-w:]\n    recent_opp_d = 0\n    for _, o in recent:\n        if o == 'D':\n            recent_opp_d += 1\n    recent_my_d = 0\n    for m, _ in recent:\n        if m == 'D':\n            recent_my_d += 1\n\n    last_me = history[-1][0]\n    last_opp = history[-1][1]\n\n    # Defect on very last round always (never worth cooperating)\n    if n >= 99:\n        return 'D'\n\n    # Identify likely always-defect opponents; exploit-free zone\n    if opp_def >= 3 and opp_def * 2 > n:\n        # Defect, but occasionally test cooperation to see if they soften\n        if recent_opp_d >= 4:\n            return 'D'\n        if rng.random() < 0.9:\n            return 'D'\n        return 'C'\n\n    # Highly cooperative opponent: maintain mutual cooperation\n    # Only defect in endgame or occasional rare probe\n    if opp_def == 0 and n >= 5:\n        # Near endgame, defect to grab extra payoff while they still cooperate\n        if n >= 94:\n            return 'D'\n        # Rare probe to test for naive cooperator (small risk)\n        if n >= 15 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Opponent cooperated heavily, low defection rate\n    if opp_def * 5 <= n:\n        # Mostly cooperative: retaliate once if they defect, then forgive\n        if last_opp == 'D':\n            if recent_opp_d >= 2:\n                return 'D'\n            # forgive quickly to restore mutual C\n            if rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        # Last opp cooperated\n        if last_me == 'D':\n            return 'C'\n        if n >= 94:\n            return 'D'\n        if rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # Medium defection rate: stricter tit-for-tat with forgiveness\n    if opp_def * 3 <= n * 2:\n        if last_opp == 'D':\n            # If we've been defecting a lot, try to break the cycle\n            if recent_my_d >= 3 and rng.random() < 0.25:\n                return 'C'\n            if recent_opp_d >= 3:\n                return 'D'\n            if rng.random() < 0.15:\n                return 'C'\n            return 'D'\n        else:\n            if last_me == 'D':\n                return 'C'\n            if n >= 92:\n                # Endgame: if ahead or close, defect to exploit cooperator\n                if my_score >= opp_score - 3:\n                    return 'D'\n            return 'C'\n\n    # High defection rate: defect hard\n    if last_opp == 'D':\n        return 'D'\n    # Opponent cooperated but has a high defect rate; occasionally defect\n    if rng.random() < 0.6:\n        return 'D'\n    return 'C'"
  },
