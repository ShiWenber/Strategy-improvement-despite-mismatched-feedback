  "child": {
    "name": "seed0-rank3-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_last = opp[-1]\n    my_last = my[-1]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    window = 10 if n >= 10 else n\n    recent_opp = opp[-window:]\n    recent_d = recent_opp.count('D')\n    recent_c = window - recent_d\n    # Exploit pure cooperators carefully, especially late\n    if opp_d == 0:\n        if n >= 80:\n            if rng.random() < 0.5:\n                return 'D'\n            return 'C'\n        if n >= 30 and rng.random() < 0.14:\n            return 'D'\n        return 'C'\n    # Never cooperate against pure defectors\n    if opp_c == 0:\n        return 'D'\n    # Detect long defection runs and stay in defection\n    run = 0\n    for a in reversed(opp):\n        if a == 'D':\n            run += 1\n        else:\n            break\n    if run >= 2:\n        return 'D'\n    # Count my previous defections where opponent still cooperated (exploitation)\n    exploit_count = 0\n    for i in range(1, n):\n        if my[i - 1] == 'D' and opp[i] == 'C':\n            exploit_count += 1\n    # If we've been exploiting an overly forgiving opponent, continue\n    if exploit_count >= 2 and opp_d <= n * 0.4:\n        if n < 85:\n            if rng.random() < 0.7:\n                return 'D'\n        else:\n            if rng.random() < 0.85:\n                return 'D'\n    # Opponent cooperated last round\n    if opp_last == 'C':\n        # If we defected last round and they still cooperated, exploit again sometimes\n        if my_last == 'D':\n            if opp_d <= 1:\n                return 'D'\n            if rng.random() < 0.55:\n                return 'D'\n            return 'C'\n        # Check if opponent is mostly cooperative\n        if recent_c >= window - 1:\n            # Very cooperative: occasional probe\n            if n < 90 and rng.random() < 0.06:\n                return 'D'\n            return 'C'\n        if recent_d >= 1:\n            # Opponent mixes: use more cautious tit-for-tat\n            if recent_d <= 2:\n                return 'C'\n            return 'C' if rng.random() < 0.4 else 'D'\n        return 'C'\n    # Opponent defected last round\n    if my_last == 'D':\n        # mutual defection - try to break out with cooperation sometimes\n        if run >= 4:\n            return 'D'\n        if rng.random() < 0.25:\n            return 'C'\n        return 'D'\n    # Opponent defected while we cooperated\n    if opp_d * 3 > n * 2:\n        return 'D'\n    if recent_d >= 3:\n        return 'D'\n    # Forgiving but retaliatory\n    if recent_c >= 6 and opp_c > opp_d:\n        if rng.random() < 0.35:\n            return 'C'\n        return 'D'\n    return 'D'"
  },
