    "name": "seed3-rank3-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    last_opp = opp[-1]\n\n    remaining = 100 - n\n\n    # Endgame: defect in final rounds to avoid being exploited.\n    if remaining <= 1:\n        return 'D'\n\n    opp_c = opp.count('C')\n    rate = opp_c / n\n\n    recent_opp = opp[-8:]\n    recent_c = recent_opp.count('C')\n    recent_rate = recent_c / len(recent_opp)\n\n    # Against always-cooperators, mostly cooperate with rare probes.\n    if opp_c == n:\n        if remaining > 6 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Against always-defectors, defect.\n    if opp_c == 0:\n        return 'D'\n\n    # Opponent just defected: retaliate but allow recovery if they\n    # show sustained cooperation.\n    if last_opp == 'D':\n        # Count consecutive opponent D's at end.\n        run_d = 0\n        for a in reversed(opp):\n            if a == 'D':\n                run_d += 1\n            else:\n                break\n        # Escalating punishment for long D streaks.\n        if run_d >= 4:\n            return 'D'\n        # After a single defection in an otherwise cooperative match,\n        # retaliate once then forgive.\n        if run_d == 1 and rate >= 0.5:\n            return 'D'\n        if rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated. Check recent defection history.\n    recent_d = len(recent_opp) - recent_c\n\n    # If opponent is highly cooperative and not defecting recently,\n    # cooperate to sustain CC=3, with a light probe.\n    if recent_d == 0:\n        if remaining > 8 and rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # Moderate recent defections: cooperate if overall rate is decent,\n    # otherwise defect defensively.\n    if recent_d <= 2 and rate >= 0.6:\n        return 'C'\n\n    if rate >= 0.75:\n        if rng.random() < 0.1:\n            return 'D'\n        return 'C'\n\n    if rate >= 0.5:\n        if rng.random() < 0.2:\n            return 'D'\n        return 'C'\n\n    if rate >= 0.3:\n        if rng.random() < 0.5:\n            return 'C'\n        return 'D'\n\n    return 'D'"
  },
