  "child": {
    "name": "seed3-rank3-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    remaining = 100 - n\n    if remaining <= 1:\n        return 'D'\n\n    opp_c = opp.count('C')\n    rate = opp_c / n\n\n    # Pure cooperators: exploit moderately but mostly keep the 3s flowing.\n    # Avoid over-greed that turns ALLC into retaliation.\n    if rate >= 0.95 and n >= 10:\n        if remaining > 8 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Very cooperative opponent: cooperate, rare gentle probe.\n    if rate >= 0.85:\n        if remaining > 6 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Mostly-defecting opponent: defend hard.\n    if rate <= 0.25:\n        # Occasionally test for late reformation far from the end.\n        if remaining > 15 and n >= 15 and rng.random() < 0.05:\n            return 'C'\n        return 'D'\n\n    last_opp = opp[-1]\n\n    if last_opp == 'C':\n        # Opponent just cooperated. Sustaining mutual cooperation is usually best.\n        recent = opp[-8:]\n        recent_c = recent.count('C')\n        if recent_c >= 6:\n            # Stable cooperation: only probe rarely and not near end.\n            if remaining > 12 and rng.random() < 0.03:\n                return 'D'\n            return 'C'\n        # Mixed recent behavior: cooperate but be a bit more probing.\n        if remaining > 10 and rng.random() < 0.07:\n            return 'D'\n        return 'C'\n\n    # Opponent just defected. Decide how long to punish / when to forgive.\n    # Count consecutive opponent defections at the end.\n    run_d = 0\n    for x in reversed(opp):\n        if x == 'D':\n            run_d += 1\n        else:\n            break\n\n    recent5 = opp[-5:]\n    recent5_d = recent5.count('D')\n\n    # Long defection streak: keep defecting, but periodically probe for\n    # reformation (esp. vs. TFT-like opponents who may already be punishing).\n    if run_d >= 3 or recent5_d >= 4:\n        if remaining > 20 and n % 5 == 0 and rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    # Single or double defection: retaliate once, then forgivingly return.\n    # This is critical vs. TFT-like opponents after a one-D shock.\n    if run_d == 1:\n        # If we already retaliated last round, return to cooperation.\n        if my[-1] == 'D':\n            return 'C'\n        return 'D'\n\n    # run_d == 2: retaliate, but set up quick recovery.\n    # If we already defected once after their first D, cooperate now.\n    if my[-1] == 'D' and n >= 2 and opp[-2] == 'D':\n        # We punished once; return to C to avoid DD lock-in.\n        if remaining > 3 and rng.random() < 0.85:\n            return 'C'\n        return 'D'\n\n    return 'D'"
  },
