    "name": "seed4-rank3-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n < 3:\n        return 'C'\n\n    # Tally outcomes and behaviors\n    cc = cd = dc = dd = 0\n    for me, op in history:\n        if me == 'C':\n            if op == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    my_c = cc + cd\n    my_d = dc + dd\n\n    last_me, last_op = history[-1]\n\n    # Endgame: last round, defect only if opponent has shown willingness to defect\n    if n >= 99:\n        if opp_d == 0:\n            return 'C'\n        return 'D'\n\n    # Detect exploitation: we cooperated, they defected repeatedly\n    exploitations = cd\n\n    # Determine recent windows\n    w = 10 if n >= 10 else n\n    recent_start = n - w\n    r_opp_c = 0\n    r_opp_d = 0\n    r_my_c = 0\n    r_exploit = 0\n    for i in range(recent_start, n):\n        me, op = history[i]\n        if op == 'C':\n            r_opp_c += 1\n        else:\n            r_opp_d += 1\n        if me == 'C':\n            r_my_c += 1\n        if me == 'C' and op == 'D':\n            r_exploit += 1\n\n    # Pure/dominant cooperators: exploit mildly but keep them cooperating\n    if opp_d == 0:\n        # They have never defected. Start probing after a while.\n        if n >= 8:\n            # Probing rhythm: defect occasionally, then cooperate to restore\n            if last_me == 'D':\n                return 'C'\n            if n % 7 == 3:\n                return 'D'\n        return 'C'\n\n    # Persistent defectors: minimize losses, punish, but avoid death spiral\n    if opp_d >= n * 3 // 4 and n >= 6:\n        if n % 11 == 0:\n            return 'C'\n        return 'D'\n\n    # Mostly defecting opponents\n    if opp_c * 3 <= n:\n        if last_op == 'C' and rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Strong mutual cooperation: stay cooperative, retaliate briefly on defection\n    if cc >= n * 2 // 3 and last_op == 'C':\n        return 'C'\n\n    # Strong cooperative tendency but with recent defections: forgiving tit-for-tat\n    if opp_c * 10 >= n * 7:\n        if last_op == 'C':\n            return 'C'\n        # Opponent defected last round\n        if last_me == 'D':\n            # We were already retaliating; return to cooperation if their defect looks isolated\n            if r_opp_d <= max(1, w // 4):\n                return 'C'\n            return 'D'\n        # We cooperated and got defected\n        if r_opp_d >= 3:\n            return 'D'\n        # Forgive sometimes to break cycles\n        if rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    # Mixed opponents: adaptive based on recent behavior\n    if r_opp_d >= 5:\n        return 'D'\n    if r_exploit >= 2 and exploitations >= 3:\n        return 'D'\n\n    if last_op == 'D':\n        # If opponent has been defecting a lot recently, keep retaliating\n        if opp_d * 2 >= n:\n            return 'D'\n        # Otherwise forgive with decent probability\n        if r_opp_c * 2 >= w:\n            if rng.random() < 0.3:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated\n    if last_me == 'D':\n        return 'C'\n    # Keep cooperating with occasional probe if we've been fully exploited rarely\n    if exploitations >= 2 and cc >= cd and n > 30 and n % 23 == 5:\n        return 'D'\n    return 'C'"
  },
