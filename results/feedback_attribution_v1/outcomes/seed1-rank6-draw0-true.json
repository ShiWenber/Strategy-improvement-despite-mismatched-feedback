    "name": "seed1-rank6-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n    last_me, last_opp = history[-1]\n    remaining = 100 - n\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    coop_rate = opp_c / n\n\n    # Consecutive opponent defections at end\n    consec_d = 0\n    for o in reversed(opp):\n        if o == 'D':\n            consec_d += 1\n        else:\n            break\n\n    # Consecutive mutual cooperation at end\n    cc_streak = 0\n    for m, o in reversed(history):\n        if m == 'C' and o == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Detect short periodic opponent patterns\n    predicted = None\n    if n >= 6:\n        for p in (1, 2, 3, 4):\n            if n >= 2 * p:\n                ok = True\n                for i in range(p):\n                    if opp[n - 1 - i] != opp[n - 1 - i - p]:\n                        ok = False\n                        break\n                if ok:\n                    predicted = opp[n - p]\n                    break\n\n    # Endgame exploitation\n    if remaining <= 1:\n        return 'D'\n    if remaining <= 3:\n        if coop_rate > 0.5 and consec_d == 0:\n            return 'D'\n        if last_opp == 'C':\n            return 'D'\n        return 'D'\n    if remaining <= 5 and coop_rate > 0.6 and consec_d == 0:\n        return 'D'\n\n    # Exploit confirmed highly cooperative opponent during middle game\n    if coop_rate >= 0.9 and consec_d == 0 and n >= 15 and remaining > 6:\n        if rng.random() < 0.12:\n            return 'D'\n        return 'C'\n\n    # Opponent mostly cooperative: cooperate\n    if coop_rate > 0.8:\n        if last_opp == 'D':\n            if consec_d >= 2:\n                return 'D'\n            if rng.random() < 0.5:\n                return 'C'\n            return 'D'\n        return 'C'\n\n    # Hard defectors: defect\n    if coop_rate < 0.3:\n        return 'D'\n\n    # Opponent defected last round\n    if last_opp == 'D':\n        if consec_d >= 3:\n            return 'D'\n        # If we've been mutually cooperating till recently, forgive single D\n        if consec_d == 1 and cc_streak >= 3:\n            return 'C'\n        if consec_d == 1 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round\n    if last_me == 'D':\n        # Return to cooperation, but avoid being repeatedly exploited\n        if coop_rate > 0.5:\n            return 'C'\n        return 'D'\n\n    # Both cooperated\n    if predicted is not None:\n        # If opponent is in a pattern, exploit predictable defection timing\n        if predicted == 'D':\n            return 'D'\n        if coop_rate > 0.7 and remaining > 6:\n            return 'C'\n        return 'C'\n\n    # Mild probing only when safe\n    if cc_streak >= 5 and coop_rate > 0.7 and remaining > 8:\n        if rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    if rng.random() < 0.02 and remaining > 5:\n        return 'D'\n    return 'C'"
  },
