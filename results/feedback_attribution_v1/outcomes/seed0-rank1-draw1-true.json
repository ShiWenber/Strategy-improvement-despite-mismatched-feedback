    "name": "seed0-rank1-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n    opp_last = history[-1][1]\n    my_last = history[-1][0]\n\n    opp_c = sum(1 for a, b in history if b == 'C')\n    my_c = sum(1 for a, b in history if a == 'C')\n\n    if n < 4:\n        return 'C'\n\n    last10 = history[-10:]\n    opp_recent_c = sum(1 for a, b in last10 if b == 'C')\n\n    # Detect long opponent cooperation run for exploitation in midgame\n    opp_run_c = 0\n    for a, b in reversed(history):\n        if b == 'C':\n            opp_run_c += 1\n        else:\n            break\n\n    opp_run_d = 0\n    for a, b in reversed(history):\n        if b == 'D':\n            opp_run_d += 1\n        else:\n            break\n\n    # Endgame: strong exploitation of known cooperators, defense vs defectors\n    if n >= 95:\n        if opp_c * 100 > n * 80 and opp_run_d == 0:\n            return 'D'\n        if opp_c * 100 < n * 40 or opp_run_d >= 1:\n            return 'D'\n        if opp_recent_c >= 5:\n            return 'D'\n        return 'C'\n\n    # If opponent never defects and we've built cooperation, exploit late-mid\n    if n >= 40 and opp_c == n:\n        if n >= 60:\n            return 'D' if rng.random() < 0.7 else 'C'\n        return 'D' if rng.random() < 0.25 else 'C'\n\n    # Punish long defection streaks\n    if opp_run_d >= 3:\n        return 'D'\n\n    # Very low recent cooperation: defect\n    if n >= 8 and opp_recent_c <= 1:\n        return 'D'\n\n    # After opponent defect: retaliate, but forgive if recent coop high\n    if opp_last == 'D':\n        if n >= 6 and opp_recent_c <= 3:\n            return 'D'\n        if n >= 3 and history[-2][1] == 'D':\n            return 'D'\n        if opp_recent_c >= 6 and n < 95:\n            return 'D' if rng.random() < 0.3 else 'C'\n        return 'D' if rng.random() < 0.8 else 'C'\n\n    # Opponent cooperated last\n    if n >= 3 and history[-2][1] == 'C' and history[-3][1] == 'D':\n        return 'C'\n\n    # Exploit long cooperation runs occasionally in midgame\n    if n >= 20 and opp_run_c >= 6 and n < 90:\n        if rng.random() < 0.12:\n            return 'D'\n\n    # Rate-based checks\n    if n >= 20 and opp_c * 100 <= n * 25:\n        return 'D'\n    if n >= 50 and opp_c * 100 <= n * 55:\n        return 'D'\n    if n >= 50 and my_c * 100 < n * 20 and opp_c * 100 > n * 75:\n        return 'D'\n    if n >= 10 and opp_recent_c <= 4 and opp_last == 'D':\n        return 'D'\n\n    return 'C'"
  },
