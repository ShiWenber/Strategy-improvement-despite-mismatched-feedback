  "child": {
    "name": "seed2-rank6-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 97:\n        return 'D'\n    last_me, last_op = history[-1]\n    opp = [b for a, b in history]\n    dcount = 0\n    for x in opp:\n        if x == 'D':\n            dcount += 1\n    ccount = n - dcount\n    recent = opp[-6:] if n >= 6 else opp\n    rcount = len(recent)\n    rd = 0\n    for x in recent:\n        if x == 'D':\n            rd += 1\n    rc = rcount - rd\n    my_d = 0\n    for a, b in history:\n        if a == 'D':\n            my_d += 1\n    if n == 1:\n        return 'C'\n    if dcount == 0:\n        if n >= 20 and my_d == 0:\n            if rng.random() < 0.06:\n                return 'D'\n        return 'C'\n    if last_op == 'D':\n        if rd >= 3:\n            return 'D'\n        if dcount * 3 > n * 2:\n            return 'D'\n        if dcount * 4 > n and rng.random() < 0.8:\n            return 'D'\n        if rc >= rd + 3 and rng.random() < 0.5:\n            return 'C'\n        return 'D'\n    if rd >= 3:\n        return 'D' if rng.random() < 0.7 else 'C'\n    if last_me == 'D':\n        if my_d > dcount + 2:\n            return 'C'\n        return 'C'\n    if dcount * 4 > n * 3 and rng.random() < 0.5:\n        return 'D'\n    if n >= 6:\n        if opp[-2] == 'D' and opp[-3] == 'D' and last_op == 'C':\n            return 'D' if rng.random() < 0.4 else 'C'\n    if n % 19 == 0 and rng.random() < 0.12:\n        return 'D'\n    return 'C'"
  },
