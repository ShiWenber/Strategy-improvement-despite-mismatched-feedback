  "child": {
    "name": "seed4-rank3-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    opp_defects = 0\n    my_defects = 0\n    cc = 0\n    cd = 0\n    dc = 0\n    dd = 0\n    for me, opp in history:\n        if opp == 'D':\n            opp_defects += 1\n        if me == 'D':\n            my_defects += 1\n        if me == 'C' and opp == 'C':\n            cc += 1\n        elif me == 'C' and opp == 'D':\n            cd += 1\n        elif me == 'D' and opp == 'C':\n            dc += 1\n        else:\n            dd += 1\n\n    last_me, last_opp = history[-1]\n    remaining = 100 - n\n\n    recent = history[-12:]\n    r_opp_d = 0\n    r_opp_c = 0\n    for me, opp in recent:\n        if opp == 'D':\n            r_opp_d += 1\n        else:\n            r_opp_c += 1\n    rn = len(recent)\n    recent_def_rate = r_opp_d / rn\n\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][0] == 'C' and history[i][1] == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    coop_rate = (n - opp_defects) / n\n\n    if opp_defects == 0:\n        if remaining == 1:\n            return 'D'\n        if remaining == 2:\n            return 'C'\n        return 'C'\n\n    if remaining <= 2:\n        if coop_rate >= 0.5:\n            return 'D'\n        return 'D'\n\n    if coop_rate < 0.15 and n >= 6:\n        if remaining <= 6:\n            return 'D'\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    if recent_def_rate >= 0.7 and n >= 6:\n        if cc_streak >= 2:\n            return 'C'\n        return 'D'\n\n    if opp_d_streak >= 3:\n        if coop_rate >= 0.6 and cc_streak == 0 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    if last_opp == 'D':\n        if coop_rate >= 0.7 and opp_defects <= 3:\n            return 'C'\n        if recent_def_rate <= 0.25:\n            return 'C'\n        if rng.random() < 0.12:\n            return 'C'\n        return 'D'\n\n    if last_me == 'D' and coop_rate >= 0.5:\n        return 'C'\n\n    if coop_rate >= 0.85 and n >= 10 and cd <= 1:\n        if rng.random() < 0.06 and remaining > 5:\n            return 'D'\n        return 'C'\n\n    if opp_defects >= 4 and coop_rate < 0.5:\n        if rng.random() < 0.8:\n            return 'D'\n        return 'C'\n\n    return 'C'"
  },
