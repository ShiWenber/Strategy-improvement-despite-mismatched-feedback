  "child": {
    "name": "seed0-rank6-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'D' if history[0][1] == 'D' else 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    my_d = my.count('D')\n\n    # Detect mutual defection streak - try to break out\n    if n >= 5:\n        dd = sum(1 for i in range(n - 5, n) if my[i] == 'D' and opp[i] == 'D')\n        if dd >= 4:\n            return 'C'\n\n    # Pure cooperator: exploit near end, otherwise cooperate mostly\n    if opp_d == 0:\n        if n >= 95:\n            return 'D'\n        if n >= 20 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # Pure defector: defect (with rare probes early)\n    if opp_c == 0:\n        if n < 10 and rng.random() < 0.15:\n            return 'C'\n        return 'D'\n\n    # Opponent defection rate overall\n    opp_rate = opp_d / n\n\n    # Recent window\n    w = opp[-12:]\n    recent_d = w.count('D')\n    recent_c = len(w) - recent_d\n\n    # Heavy recent defection\n    if recent_d >= 8:\n        return 'D'\n    # Strong recent cooperation\n    if recent_d <= 1 and n >= 12:\n        if n >= 95:\n            return 'D'\n        if rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    last_op = opp[-1]\n    last_my = my[-1]\n\n    # Endgame: punish uncooperative, cooperate with cooperative\n    if n >= 92:\n        if opp_rate < 0.5:\n            return 'D'\n        if opp_rate > 0.85:\n            return 'C'\n        if recent_d > recent_c:\n            return 'D'\n        return 'C'\n\n    # If opponent defected last round\n    if last_op == 'D':\n        if last_my == 'D':\n            # Mutual defection: try forgiveness sometimes\n            if opp_rate < 0.5:\n                return 'D'\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        else:\n            # Opponent defected while we cooperated\n            if opp_rate > 0.75:\n                # Mostly cooperative: forgive once in a while\n                if rng.random() < 0.15:\n                    return 'C'\n                return 'D'\n            return 'D'\n\n    # Opponent cooperated last round\n    if last_my == 'D':\n        # We defected, they cooperated: be nice now to keep them cooperative\n        return 'C'\n\n    # Both cooperated\n    if opp_rate > 0.6:\n        # Reward cooperation, rare probe defection in middle game\n        if 15 <= n <= 85 and opp_rate > 0.85 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Mixed opponent: tit-for-tat-like with cautious cooperation\n    if recent_d >= 4:\n        return 'D'\n    if recent_c >= 6:\n        return 'C'\n    return 'C'"
  },
