    "name": "seed3-rank1-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    def opp(i):\n        return history[i][1]\n\n    def me(i):\n        return history[i][0]\n\n    # Endgame: last round, take the exploitation payoff if opponent likely cooperates.\n    if n >= 99:\n        return 'D'\n\n    # First move cooperate.\n    if n == 1:\n        return 'C'\n\n    last_opp = opp(n - 1)\n    last_me = me(n - 1)\n\n    # Compute recent opponent cooperation over several windows.\n    def coop_count(k):\n        start = n - k\n        if start < 0:\n            start = 0\n        total = 0\n        for i in range(start, n):\n            if opp(i) == 'C':\n                total += 1\n        return total\n\n    # Overall stats\n    overall_c = 0\n    for i in range(n):\n        if opp(i) == 'C':\n            overall_c += 1\n    overall_rate = overall_c / float(n)\n\n    recent10_c = coop_count(10)\n    recent10_n = 10 if n >= 10 else n\n    recent10_rate = recent10_c / float(recent10_n)\n\n    recent5_c = coop_count(5)\n    recent5_n = 5 if n >= 5 else n\n    recent5_rate = recent5_c / float(recent5_n)\n\n    # Count consecutive opponent cooperations at the tail.\n    run_c = 0\n    for i in range(n - 1, -1, -1):\n        if opp(i) == 'C':\n            run_c += 1\n        else:\n            break\n\n    # Count consecutive opponent defections at the tail.\n    run_d = 0\n    for i in range(n - 1, -1, -1):\n        if opp(i) == 'D':\n            run_d += 1\n        else:\n            break\n\n    # Pure/very cooperative opponent: keep cooperating, but start taking\n    # advantage in the final stretch to boost score against naive cooperators.\n    if overall_rate >= 0.95 and n >= 20:\n        # In the last 20 rounds, defect more often against a pure cooperator.\n        if n >= 80:\n            return 'D'\n        if n >= 60 and (n % 2 == 0):\n            return 'D'\n        # Occasional probe to test exploitability, but rare early.\n        if n >= 30 and rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # Pure defector: always defect.\n    if overall_rate <= 0.05 and n >= 6:\n        return 'D'\n\n    # Opponent just defected.\n    if last_opp == 'D':\n        # If we have a long cooperative history but a sudden defection,\n        # retaliate once then try to restore cooperation.\n        if overall_rate >= 0.7 and run_d <= 2:\n            if last_me == 'C':\n                return 'D'\n            # We already retaliated; if they cooperated after, return to C.\n            if run_d == 1 and n >= 2 and opp(n - 2) == 'D' and last_me == 'D':\n                return 'C'\n            return 'D'\n        # If they have been defecting for a while, keep defecting.\n        if run_d >= 3:\n            return 'D'\n        # If opponent has been mostly cooperative, punish but with forgiveness\n        # to avoid cascading mutual defection.\n        if overall_rate >= 0.5:\n            if rng.random() < 0.15:\n                return 'C'\n            return 'D'\n        # Against a mixed/aggressive opponent, defect.\n        return 'D'\n\n    # Opponent just cooperated.\n    # If we defected last round while they cooperated, we got DC=5. Consider\n    # exploiting again if they seem forgiving, else return to cooperation.\n    if last_me == 'D':\n        if overall_rate >= 0.7:\n            # They likely keep cooperating; exploit a bit more, then restore.\n            if rng.random() < 0.35:\n                return 'D'\n            return 'C'\n        return 'C'\n\n    # Both cooperated last round.\n    # Detect obviously cooperative opponent and sustain CC.\n    if recent10_rate >= 0.8:\n        # Sustain cooperation but probe rarely later.\n        if n >= 40 and rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # Recent opponent became mixed: retaliate/probe accordingly.\n    if recent5_rate <= 0.4:\n        # More defection in recent history: defect more.\n        if rng.random() < 0.8:\n            return 'D'\n        return 'C'\n\n    # Moderate cooperation: cooperate with mild probing.\n    if n >= 15 and rng.random() < 0.06:\n        return 'D'\n    return 'C'"
  },
