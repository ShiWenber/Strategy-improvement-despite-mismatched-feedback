  "child": {
    "name": "seed4-rank3-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Short opening: cooperate to build mutual cooperation.\n    if n < 12:\n        return 'C'\n\n    # Tally outcomes over full history.\n    cc = cd = dc = dd = 0\n    for me, opp in history:\n        if me == 'C':\n            if opp == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if opp == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    my_last, opp_last = history[-1]\n\n    # Trail: number of consecutive opponent defections at the end.\n    opp_d_streak = 0\n    for me, opp in reversed(history):\n        if opp == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Trail: number of consecutive mutual cooperation rounds at the end.\n    cc_streak = 0\n    for me, opp in reversed(history):\n        if me == 'C' and opp == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Recent window statistics.\n    w = history[-16:]\n    wn = len(w)\n    w_opp_c = sum(1 for me, opp in w if opp == 'C')\n    w_opp_d = wn - w_opp_c\n    w_cc = sum(1 for me, opp in w if me == 'C' and opp == 'C')\n    w_exploit = sum(1 for me, opp in w if me == 'C' and opp == 'D')\n\n    opp_coop_rate = opp_c / n\n\n    # Endgame: if opponent is mostly cooperative, keep cooperating.\n    # Only defect in the final round if they have been exploitative.\n    remaining = 100 - n\n    if remaining <= 0:\n        return 'C'\n    if remaining <= 1:\n        if opp_coop_rate < 0.35:\n            return 'D'\n        return 'C'\n\n    # Relentless defector: defect but occasionally probe/test for change.\n    if n >= 16 and opp_d >= n * 3 // 4:\n        if n % 19 == 0:\n            return 'C'\n        return 'D'\n\n    # Highly cooperative opponent: cooperate, but retaliate against rare defections\n    # and forgive quickly to restore mutual cooperation.\n    if opp_coop_rate >= 0.75:\n        if opp_last == 'D':\n            if opp_d_streak >= 3:\n                return 'D'\n            if w_exploit >= 3 and w_opp_d >= 4:\n                return 'D'\n            return 'D'\n        # Opponent cooperated last; return to cooperation.\n        return 'C'\n\n    # Very low cooperation: punish, with occasional probes.\n    if opp_coop_rate < 0.25:\n        if rng.random() < 0.08:\n            return 'C'\n        return 'D'\n\n    # Middle range: forgiving tit-for-tat.\n    # If mutual cooperation streak is healthy, stay cooperative.\n    if cc_streak >= 2 and opp_d_streak == 0:\n        return 'C'\n\n    # Opponent just defected.\n    if opp_last == 'D':\n        # If they have been consistently exploiting us recently, punish.\n        if w_exploit >= 4 and w_opp_d >= 6:\n            return 'D'\n        # If they have a long defection streak, punish.\n        if opp_d_streak >= 3:\n            return 'D'\n        # Single defection after cooperation: retaliate once, but prepare to forgive.\n        # Occasionally forgive immediately to break death spirals.\n        if opp_d_streak == 1 and cc_streak >= 3:\n            if rng.random() < 0.25:\n                return 'C'\n        return 'D'\n\n    # Opponent just cooperated.\n    # If we defected last round, return to cooperation to rebuild trust.\n    if my_last == 'D':\n        return 'C'\n\n    # If opponent was recently very cooperative, cooperate.\n    if w_opp_c >= 12:\n        return 'C'\n\n    # If opponent is mildly defecting recently but overall mixed,\n    # mostly cooperate with a small probing/defensive chance.\n    if w_opp_d >= 6:\n        if rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Default: cooperate to maintain mutual benefit.\n    return 'C'"
  },
