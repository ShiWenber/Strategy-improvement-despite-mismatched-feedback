    "name": "seed4-rank1-draw0-true",
    "code": "import random\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n < 3:\n        return 'C'\n\n    # Aggregate counts by joint action over whole history.\n    cc = cd = dc = dd = 0\n    for me, op in history:\n        if me == 'C':\n            if op == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    my_c = cc + cd\n    my_d = dc + dd\n    opp_rate = opp_c / n\n\n    # Endgame: last few rounds exploit if opponent has shown any defection tendency.\n    if n >= 97:\n        if opp_rate < 0.7 or opp_d >= 3:\n            return 'D'\n        return 'C'\n\n    # Detect near-pure cooperator: exploit with restraint to keep them cooperating.\n    if n >= 6 and opp_d == 0:\n        # Rare probes to gain DC points without wrecking cooperation.\n        if n % 7 == 3:\n            return 'D'\n        return 'C'\n\n    # Detect near-pure defector: defect hard, rare mercy to reset.\n    if n >= 6 and opp_c <= 1:\n        if n % 11 == 0:\n            return 'C'\n        return 'D'\n\n    # Recent window analysis.\n    w = 12 if n >= 12 else n\n    recent = history[-w:]\n    r_opp_c = 0\n    r_opp_d = 0\n    r_my_c = 0\n    r_exploit = 0  # times we were exploited\n    r_caught = 0   # times opponent cooperated while we defected\n    for me, op in recent:\n        if op == 'C':\n            r_opp_c += 1\n        else:\n            r_opp_d += 1\n        if me == 'C':\n            r_my_c += 1\n            if op == 'D':\n                r_exploit += 1\n        else:\n            if op == 'C':\n                r_caught += 1\n    r_opp_rate = r_opp_c / w\n\n    last_me, last_op = history[-1]\n\n    # If opponent is defecting a lot recently, retaliate strongly.\n    if r_opp_d >= w - 2 and w >= 6:\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # If we just got exploited and opponent has been mostly defecting recently.\n    if last_me == 'C' and last_op == 'D':\n        if r_opp_rate < 0.5:\n            return 'D'\n        # Mostly nice opponent: retaliate but with forgiveness.\n        if rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # If opponent was nice recently, cooperate (maintain trust).\n    if r_opp_rate >= 0.75:\n        # Occasionally probe for DC, but only if we haven't been caught much.\n        if r_caught < 2 and n < 92 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # If opponent has a mixed pattern, be careful.\n    # Estimate if opponent seems to mirror our last move (TFT-like).\n    if n >= 6:\n        mirror_hits = 0\n        mirror_total = 0\n        for i in range(1, n):\n            if history[i][1] == history[i - 1][0]:\n                mirror_hits += 1\n            mirror_total += 1\n        if mirror_total > 0 and mirror_hits * 4 >= mirror_total * 3:\n            # TFT-like: cooperate after they cooperate, exploit rarely.\n            if last_op == 'C':\n                if rng.random() < 0.08:\n                    return 'D'\n                return 'C'\n            if rng.random() < 0.12:\n                return 'C'\n            return 'D'\n\n    # Balanced region: prefer cooperation if we're not being exploited.\n    if r_exploit > r_caught + 1:\n        return 'D'\n    if last_op == 'C':\n        return 'C'\n    if rng.random() < 0.8:\n        return 'D'\n    return 'C'"
  },
