  "child": {
    "name": "seed4-rank1-draw1-hidden",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    if n == 100:\n        return 'D'\n\n    # Tally outcomes.\n    cc = cd = dc = dd = 0\n    for me, op in history:\n        if me == 'C':\n            if op == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if op == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    my_c = cc + cd\n    my_d = dc + dd\n\n    # Recent windows.\n    recent = history[-10:] if n >= 10 else history\n    r_cc = sum(1 for a, b in recent if a == 'C' and b == 'C')\n    r_opp_c = sum(1 for a, b in recent if b == 'C')\n    rn = len(recent)\n\n    # Opponent cooperation streak at the tail.\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][0] == 'C' and history[i][1] == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    remaining = 100 - n\n    last_me, last_op = history[-1]\n    opp_total_rate = opp_c / n\n    recent_rate = r_opp_c / rn\n\n    # Opening probe: cooperate briefly, then read the opponent.\n    if n < 3:\n        return 'C'\n\n    # Late-game endgame exploitation.\n    if remaining <= 2:\n        # If opponent is not perfectly cooperative, grab the last points.\n        if opp_total_rate < 0.95:\n            return 'D'\n        return 'C'\n\n    # Pure cooperator: keep mutual cooperation almost the whole way.\n    if opp_d == 0:\n        if remaining <= 1:\n            return 'D'\n        return 'C'\n\n    # Hard defector: punish quickly, probe rarely.\n    if opp_c <= 1 and n >= 6:\n        if n % 19 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent defecting a lot right now.\n    if opp_d_streak >= 3:\n        if opp_total_rate > 0.5 and remaining > 5:\n            # They may have slipped; try one forgiveness.\n            if opp_d_streak == 3 and cc_streak == 0 and rng.random() < 0.35:\n                return 'C'\n        return 'D'\n\n    # Mostly cooperative opponent: reciprocate with light forgiveness.\n    if recent_rate >= 0.7:\n        if last_op == 'D':\n            if opp_d_streak >= 2:\n                return 'D'\n            # Single recent defection: retaliate once, then return.\n            if last_me == 'C':\n                return 'D'\n            return 'C'\n        return 'C'\n\n    # Mostly defecting opponent recently: defect, with rare probes.\n    if recent_rate <= 0.3:\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # Mixed / noisy opponent: generous tit-for-tat.\n    if last_op == 'D':\n        # Forgive if they've been cooperative overall and we just had a long CC run.\n        if opp_total_rate > 0.55 and cc_streak >= 3:\n            if rng.random() < 0.4:\n                return 'C'\n        if opp_total_rate > 0.65 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    if last_me == 'D':\n        return 'C'\n\n    # If we're being exploited more than we exploit them, lean defensive.\n    if cd > dc + 2 and opp_total_rate < 0.6:\n        return 'D'\n\n    # Slight late probing if opponent is exploitable but not fully cooperative.\n    if remaining <= 8 and opp_total_rate > 0.75 and rng.random() < 0.15:\n        return 'D'\n\n    return 'C'"
  },
