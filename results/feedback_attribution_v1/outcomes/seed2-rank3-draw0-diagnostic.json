  "child": {
    "name": "seed2-rank3-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 1 and history[0][1] == 'C' and n < 3:\n        return 'C'\n\n    # Count behaviors\n    opp_c = 0\n    opp_d = 0\n    my_d = 0\n    for m, o in history:\n        if o == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if m == 'D':\n            my_d += 1\n\n    last_my, last_opp = history[-1]\n\n    # Opponent appears to be unconditional cooperator -> exploit late\n    if opp_d == 0:\n        if n >= 96:\n            return 'D'\n        return 'C'\n\n    # Strong defector detection\n    if opp_d >= 4 and opp_c <= 1:\n        if last_opp == 'C' and opp_c >= 2 and rng.random() < 0.4:\n            return 'C'\n        return 'D'\n\n    # Recent window\n    window = history[-8:] if n >= 8 else history\n    recent_opp_d = 0\n    for _, o in window:\n        if o == 'D':\n            recent_opp_d += 1\n    wlen = len(window)\n\n    # End game exploitation of cooperative opponents\n    if n >= 97:\n        return 'D'\n    if n >= 92 and opp_d * 4 <= n:\n        return 'D'\n\n    # If opponent defected a lot recently, punish\n    if recent_opp_d >= max(2, wlen // 2):\n        if rng.random() < 0.85:\n            return 'D'\n        return 'C'\n\n    # Opponent last defected\n    if last_opp == 'D':\n        # If they rarely defect overall, forgive quickly to restore CC\n        if opp_d * 5 <= n:\n            if rng.random() < 0.55:\n                return 'C'\n            return 'D'\n        # Moderate defect rate: retaliate but sometimes forgive\n        if my_d >= opp_d + 2 and rng.random() < 0.4:\n            return 'C'\n        if rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Opponent last cooperated\n    if last_my == 'D':\n        # We defected and they cooperated - return to cooperative posture\n        return 'C'\n\n    # Both cooperated. Occasionally probe against mixed opponents.\n    if n >= 10 and opp_d * 4 > n and rng.random() < 0.12:\n        return 'D'\n    return 'C'"
  },
