  "child": {
    "name": "seed3-rank1-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n    last_opp = opp[-1]\n    last_me = me[-1]\n    remaining = 100 - n\n\n    # Endgame: grab DC value when opponent is likely to cooperate.\n    if remaining <= 1:\n        return 'D'\n\n    # Count statistics over the whole match.\n    opp_c = 0\n    for a in opp:\n        if a == 'C':\n            opp_c += 1\n    opp_d = n - opp_c\n    rate = opp_c / n\n\n    # Detect unrelenting defectors quickly.\n    if n >= 8:\n        recent_d = 0\n        for i in range(n - 8, n):\n            if opp[i] == 'D':\n                recent_d += 1\n        if recent_d >= 7:\n            return 'D'\n\n    # Pure cooperator: exploit hard, but not so early that we misclassify.\n    if opp_d == 0:\n        if n >= 4:\n            return 'D'\n        return 'C'\n\n    # Pure defector: defend.\n    if opp_c == 0:\n        return 'D'\n\n    # Compute consecutive opponent cooperation at the tail.\n    run_c = 0\n    i = n - 1\n    while i >= 0 and opp[i] == 'C':\n        run_c += 1\n        i -= 1\n\n    # Compute consecutive opponent defections at the tail.\n    run_d = 0\n    i = n - 1\n    while i >= 0 and opp[i] == 'D':\n        run_d += 1\n        i -= 1\n\n    # Opponent just defected.\n    if last_opp == 'D':\n        # If they are mostly cooperative overall and this is an isolated\n        # defection, retaliate once then return to cooperation.\n        if rate >= 0.75:\n            if last_me == 'C':\n                return 'D'\n            # We already retaliated; forgive if they resume C.\n            if run_d == 1 and n >= 2 and opp[n - 2] == 'C':\n                return 'C'\n            return 'D'\n        # Moderately cooperative: punish recent defection streaks.\n        if rate >= 0.5:\n            if run_d >= 3:\n                return 'D'\n            if run_d == 1:\n                return 'D'\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        # Mostly defective: mostly punish, occasional probe for cooperation.\n        if n % 17 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent just cooperated.\n    # Track our own recent defections to avoid being seen as exploiter.\n    if last_me == 'D':\n        # We probed or retaliated and they cooperated back.\n        if run_c >= 2:\n            return 'C'\n        if rate >= 0.5:\n            return 'C'\n        # Against low-cooperation opponents, continue pressure.\n        if rng.random() < 0.3:\n            return 'C'\n        return 'D'\n\n    # Both cooperated. Sustain cooperation, with rare probing.\n    if rate >= 0.85:\n        # Very cooperative opponent. Rarely test exploitation.\n        if remaining > 5 and n > 20:\n            if rng.random() < 0.02:\n                return 'D'\n        return 'C'\n\n    if rate >= 0.6:\n        # Cooperative enough; mostly cooperate, probe sparingly.\n        if remaining > 3:\n            if rng.random() < 0.04:\n                return 'D'\n        return 'C'\n\n    if rate >= 0.4:\n        # Mixed opponent: cooperate but watch for defection runs.\n        if run_c >= 3:\n            return 'C'\n        if rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    # Opponent not very cooperative; press advantage.\n    if rng.random() < 0.2:\n        return 'C'\n    return 'D'"
  },
