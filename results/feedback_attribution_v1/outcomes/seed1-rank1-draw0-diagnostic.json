  "child": {
    "name": "seed1-rank1-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n\n    # Very early: cooperate; punish only an immediate opening defection.\n    if n < 4:\n        if opp[-1] == 'D':\n            return 'D'\n        return 'C'\n\n    remaining = 100 - n\n\n    # Endgame: defect for the last few rounds to grab the extra point\n    # against cooperators, while retaliation against defectors stays natural.\n    if remaining <= 2:\n        return 'D'\n\n    # If opponent is almost purely defecting, protect ourselves.\n    if opp_d * 4 > n * 3:\n        return 'D'\n\n    # Opponent extremely cooperative: keep CC flowing, exploit only rarely.\n    if opp_d <= max(1, n // 12):\n        if opp[-1] == 'D':\n            # Isolated defect: forgive unless two consecutive.\n            if n >= 2 and opp[-2] == 'D':\n                return 'D'\n            return 'C'\n        # Rare opportunistic defection, kept infrequent to preserve trust.\n        if n >= 30 and remaining > 15 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Mostly cooperative but with some noise: Tit-for-Tat with forgiveness.\n    if opp_c * 2 > n:\n        if opp[-1] == 'C':\n            return 'C'\n        # Opponent defected. Punish once, but repair quickly.\n        if n >= 3 and opp[-2] == 'D' and opp[-3] == 'D':\n            return 'D'\n        if rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    # Mixed/aggressive opponent: mirror with limited forbearance.\n    if opp[-1] == 'C':\n        # Reward cooperation, but occasionally test when ahead.\n        if remaining > 20 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n\n    # Opponent just defected in a mixed game.\n    if my[-1] == 'D':\n        # We already punished; try to break the DD cycle.\n        if rng.random() < 0.15:\n            return 'C'\n        return 'D'\n    return 'D'"
  },
