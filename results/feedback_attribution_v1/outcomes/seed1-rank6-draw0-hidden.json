    "name": "seed1-rank6-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    coop_rate = opp_c / n\n    remaining = 100 - n\n\n    # Opponent's cooperation conditioned on our prior move (look at rounds 1..n-1)\n    cc = cd = dc = dd = 0\n    for i in range(1, n):\n        pm = me[i - 1]\n        po = opp[i]\n        if pm == 'C':\n            if po == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if po == 'C':\n                dc += 1\n            else:\n                dd += 1\n    coop_after_c = cc / (cc + cd) if (cc + cd) > 0 else 0.5\n    coop_after_d = dc / (dc + dd) if (dc + dd) > 0 else 0.5\n\n    # Detect strict alternation / short cycles (period 2 or 3)\n    period = 0\n    if n >= 6:\n        for p in (1, 2, 3):\n            ok = True\n            limit = n - 1 - p\n            if limit >= 0:\n                j = 0\n                while j < p and n - 1 - j - p >= 0:\n                    if opp[n - 1 - j] != opp[n - 1 - j - p]:\n                        ok = False\n                        break\n                    j += 1\n                if ok:\n                    period = p\n                    break\n\n    def predict_next(offset):\n        if period > 0:\n            return opp[n - period + (offset % period)]\n        return None\n\n    # Endgame handling\n    if remaining <= 1:\n        return 'D'\n\n    if remaining <= 2:\n        # Exploit if opponent historically cooperates a lot\n        if coop_rate > 0.55:\n            return 'D'\n        # If they cooperate after our defection, still exploit\n        if coop_after_d > 0.5:\n            return 'D'\n        return 'C' if coop_rate > 0.4 else 'D'\n\n    if remaining <= 4:\n        if coop_rate > 0.5 and coop_after_c > 0.5:\n            return 'D'\n        if coop_rate < 0.4:\n            return 'D'\n        return 'C'\n\n    # Punish heavy defectors\n    if coop_rate < 0.25:\n        return 'D'\n\n    # Early probing phase\n    if n < 4:\n        return 'C'\n\n    last_me = me[-1]\n    last_opp = opp[-1]\n\n    # Cycle exploitation: if we detect a cycle, defect when opponent will C\n    if period > 0:\n        nxt = predict_next(0)\n        if nxt == 'C':\n            return 'D'\n        if nxt == 'D':\n            return 'D'\n\n    # Detect opponent rarely defects: minor exploitation\n    if opp_d <= max(1, n // 12) and n >= 15:\n        if remaining > 8 and rng.random() < 0.18:\n            return 'D'\n        return 'C'\n\n    # Cooperate-after-defection: if they forgive immediately, keep exploiting occasionally\n    if last_me == 'D' and last_opp == 'C' and coop_after_d > 0.6:\n        if rng.random() < 0.35:\n            return 'D'\n        return 'C'\n\n    # Response to last opponent move with forgiveness\n    if last_opp == 'D':\n        # Count trailing opponent defections\n        consec = 0\n        for x in reversed(opp):\n            if x == 'D':\n                consec += 1\n            else:\n                break\n        if consec == 1:\n            # Forgive single isolated defection if they are generally nice\n            if coop_rate > 0.7 and coop_after_c > 0.6:\n                if rng.random() < 0.55:\n                    return 'C'\n            if rng.random() < 0.15:\n                return 'C'\n            return 'D'\n        if consec == 2:\n            if coop_rate > 0.75 and rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last round\n    if last_me == 'D':\n        return 'C'\n\n    # Both cooperated: maintain cooperation, occasional probe only if opponent is forgiving\n    if coop_after_d > 0.65 and rng.random() < 0.05:\n        return 'D'\n    return 'C'"
  },
