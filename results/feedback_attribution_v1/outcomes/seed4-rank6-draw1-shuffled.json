    "name": "seed4-rank6-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    my_last, opp_last = history[-1]\n\n    # Count key outcomes\n    cc = cd = dc = dd = 0\n    opp_c = 0\n    for a, b in history:\n        if b == 'C':\n            opp_c += 1\n        if a == 'C' and b == 'C':\n            cc += 1\n        elif a == 'C' and b == 'D':\n            cd += 1\n        elif a == 'D' and b == 'C':\n            dc += 1\n        else:\n            dd += 1\n\n    opp_rate = opp_c / n\n\n    # Endgame: grab final payoffs\n    if n >= 98:\n        if opp_rate >= 0.5:\n            return 'D'\n        return 'D'\n\n    # Very cooperative opponent: cooperate mostly, exploit a little near end\n    if opp_rate >= 0.9 and n >= 8:\n        if n >= 85 and n % 7 == 0:\n            return 'D'\n        return 'C'\n\n    # Persistent defector: punish hard, probe rarely\n    if opp_rate <= 0.15 and n >= 6:\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent just defected\n    if opp_last == 'D':\n        # Count trailing opponent defections\n        k = 0\n        for i in range(n - 1, -1, -1):\n            if history[i][1] == 'D':\n                k += 1\n            else:\n                break\n\n        if k >= 3:\n            # Long defection run: punish unless they look mostly cooperative overall\n            if opp_rate > 0.6 and rng.random() < 0.25:\n                return 'C'\n            return 'D'\n\n        # Short defection: retaliate with forgiveness if generally cooperative\n        if opp_rate > 0.55:\n            if rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent just cooperated\n    # If opponent overall aggressive, occasionally defect preemptively\n    if opp_rate < 0.35 and n >= 10:\n        if rng.random() < 0.55:\n            return 'D'\n        return 'C'\n\n    # Mutual cooperation pattern: keep cooperating, occasional probe\n    if cc >= n * 0.6:\n        if n >= 20 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # If we've been the one exploiting a lot, coast on cooperation\n    if dc >= 3 and dc > cd:\n        if opp_last == 'C':\n            if rng.random() < 0.7:\n                return 'C'\n            return 'D'\n\n    # Default: cooperate to build mutual trust\n    return 'C'"
  },
