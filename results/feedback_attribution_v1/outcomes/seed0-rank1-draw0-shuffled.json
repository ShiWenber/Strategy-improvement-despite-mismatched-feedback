  "child": {
    "name": "seed0-rank1-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n    opp_last = history[-1][1]\n    my_last = history[-1][0]\n    if n < 4:\n        return 'C'\n    opp_c = sum(1 for a, b in history if b == 'C')\n    my_c = sum(1 for a, b in history if a == 'C')\n    last10 = history[-10:]\n    opp_recent = sum(1 for a, b in last10 if b == 'C')\n    if n >= 8 and opp_recent <= 1:\n        return 'D'\n    if n >= 6 and opp_last == 'D':\n        if opp_recent <= 3:\n            return 'D'\n    if n >= 3:\n        if history[-1][1] == 'D' and history[-2][1] == 'D':\n            return 'D'\n    if n >= 20 and opp_c * 100 <= n * 25:\n        return 'D'\n    if n >= 50:\n        if opp_c * 100 <= n * 55:\n            return 'D'\n        if my_c * 100 < n * 25 and opp_c * 100 > n * 70:\n            return 'D'\n    if n >= 10:\n        if opp_recent <= 4 and opp_last == 'D':\n            return 'D'\n    if history[-1][1] == 'C':\n        if n >= 20:\n            if opp_c * 100 > n * 92:\n                if rng.random() < 0.06:\n                    return 'D'\n                return 'C'\n        return 'C'\n    if n >= 5:\n        if history[-2][1] == 'C' and history[-3][1] == 'C':\n            return 'C'\n    if rng.random() < 0.15:\n        return 'C'\n    return 'D'"
  },
