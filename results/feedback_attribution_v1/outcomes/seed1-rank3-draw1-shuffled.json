    "name": "seed1-rank3-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Endgame: exhaustively exploit in final rounds.\n    remaining = 100 - n\n    if remaining <= 2:\n        return 'D'\n\n    # Round-1 probe.\n    if n == 1:\n        if history[0][1] == 'D':\n            return 'D'\n        return 'C'\n\n    # Compute outcome counts and conditional cooperation.\n    cc = cd = dc = dd = 0\n    opp_c = 0\n    for m, o in history:\n        if o == 'C':\n            opp_c += 1\n        if m == 'C':\n            if o == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if o == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    last_me, last_opp = history[-1]\n    opp_coop_rate = opp_c / n\n\n    # Consecutive opponent defection streak.\n    opp_d_streak = 0\n    for m, o in reversed(history):\n        if o == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Streak of mutual cooperation.\n    cc_streak = 0\n    for m, o in reversed(history):\n        if m == 'C' and o == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Identify an always-cooperator to milk carefully.\n    if opp_c == n:\n        # Exploit near end; otherwise mostly cooperate with sparse probes.\n        if remaining <= 6:\n            return 'D'\n        if cc_streak >= 16:\n            # Long mutual-cooperation streak: single defection probe.\n            return 'D'\n        return 'C'\n\n    # Identify a never-cooperator: protect ourselves.\n    if opp_c == 0:\n        return 'D'\n\n    # Count recent opponent behavior over last 10 rounds.\n    k = 10 if n >= 10 else n\n    recent_opp = history[-k:]\n    recent_d = 0\n    for m, o in recent_opp:\n        if o == 'D':\n            recent_d += 1\n\n    # If opponent is nearly always defecting, mirror defection.\n    if recent_d * 2 > k:\n        return 'D'\n\n    # If opponent is heavily cooperative and we haven't provoked recently,\n    # cooperate but occasionally probe with a single defection, then return.\n    if opp_coop_rate > 0.85:\n        if remaining <= 5:\n            return 'D'\n        if cc_streak > 0 and cc_streak % 17 == 0 and remaining > 15:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Endgame exploitation for opponents who tend to cooperate.\n    if remaining <= 5:\n        if opp_coop_rate > 0.45:\n            return 'D'\n        return 'D'\n\n    # Retaliation for fresh exploitation.\n    if last_opp == 'D' and last_me == 'C':\n        if opp_d_streak >= 2:\n            return 'D'\n        # Single defection: retaliate, unless opponent is generally cooperative.\n        if opp_coop_rate > 0.65:\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Mutual defection: escape the trap if opponent has a cooperative track record.\n    if last_opp == 'D' and last_me == 'D':\n        if opp_coop_rate > 0.4:\n            if opp_d_streak <= 2 and rng.random() < 0.5:\n                return 'C'\n            return 'D'\n        if rng.random() < 0.10:\n            return 'C'\n        return 'D'\n\n    # Last opponent cooperated.\n    if last_me == 'D':\n        # Reward their forgiveness immediately.\n        return 'C'\n\n    # Both cooperated: continue unless signals suggest exploitation.\n    if cd > cc and n > 12:\n        return 'D'\n\n    return 'C'"
  },
