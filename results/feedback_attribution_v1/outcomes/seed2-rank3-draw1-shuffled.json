  "child": {
    "name": "seed2-rank3-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 98:\n        return 'D'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    opp_def = sum(1 for x in opp if x == 'D')\n    my_def = sum(1 for x in me if x == 'D')\n    opp_c = n - opp_def\n\n    last_me = me[-1]\n    last_opp = opp[-1]\n\n    # Rolling windows\n    w = history[-12:] if n >= 12 else history\n    r_opp_def = sum(1 for _, o in w if o == 'D')\n    w5 = history[-5:] if n >= 5 else history\n    r5_opp_def = sum(1 for _, o in w5 if o == 'D')\n\n    # Detect long cooperation streak by opponent\n    opp_streak_c = 0\n    for b in reversed(opp):\n        if b == 'C':\n            opp_streak_c += 1\n        else:\n            break\n\n    # Exploit a persistent cooperator, but avoid over-defecting so they retaliate\n    if opp_def == 0:\n        if n < 3:\n            return 'C'\n        # Pure cooperators: defect every 4th round for steady exploitation\n        if last_me == 'D':\n            return 'C'\n        if n >= 100:\n            return 'D'\n        if n % 4 == 0:\n            return 'D'\n        return 'C'\n\n    # Very cooperative opponent (rare defections)\n    if opp_def * 5 <= n and n >= 6:\n        # If they just defected, punish promptly once; otherwise cooperate\n        if last_opp == 'D':\n            if last_me == 'C':\n                return 'D'\n            return 'C'\n        # Occasional test only when very safe\n        if n % 5 == 0 and rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Aggressive opponent: defect most of the time\n    if opp_def * 2 > n:\n        if last_opp == 'C' and r5_opp_def == 0:\n            # They just cooperated in a recent cooperative stretch: take advantage briefly\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        # Try to keep them punished\n        if r5_opp_def >= 2:\n            return 'D'\n        return 'D' if rng.random() < 0.8 else 'C'\n\n    # Mixed opponent: tit-for-tat with calibrated forgiveness\n    if last_opp == 'D':\n        # Opponent just defected\n        if r5_opp_def >= 3:\n            return 'D'\n        if r_opp_def >= 4:\n            return 'D'\n        # Forgive sporadically to try to restore mutual cooperation\n        if last_me == 'D' and r_opp_def <= 1:\n            return 'C'\n        if rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last\n    if last_me == 'D':\n        # Repair after our defection\n        return 'C'\n\n    # Track recent own cooperation to consider probing\n    r_my_def = sum(1 for m, _ in w5 if m == 'D')\n\n    # If opponent's overall defection is moderate, punish pattern when they defect\n    if opp_def * 4 > n:\n        # Moderate defector: defect sometimes even when they cooperate\n        if rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Mostly cooperative: occasional probing to test and exploit\n    if r_my_def == 0 and opp_streak_c >= 3 and rng.random() < 0.08:\n        return 'D'\n    return 'C'"
  },
