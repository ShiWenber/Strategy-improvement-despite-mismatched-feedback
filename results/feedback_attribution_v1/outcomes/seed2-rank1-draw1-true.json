  "child": {
    "name": "seed2-rank1-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 99:\n        return 'D'\n\n    opp_c = 0\n    opp_d = 0\n    my_d = 0\n    for m, o in history:\n        if o == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if m == 'D':\n            my_d += 1\n\n    last_me, last_op = history[-1]\n\n    # Recent window of 8\n    w = 8 if n >= 8 else n\n    rec_opp_d = 0\n    rec_opp_c = 0\n    rec_my_d = 0\n    for i in range(n - w, n):\n        m, o = history[i]\n        if o == 'D':\n            rec_opp_d += 1\n        else:\n            rec_opp_c += 1\n        if m == 'D':\n            rec_my_d += 1\n\n    # Detect opponent defection streak\n    streak_d = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            streak_d += 1\n        else:\n            break\n    streak_c = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'C':\n            streak_c += 1\n        else:\n            break\n\n    # If opponent has been almost perfectly cooperative, cooperate but exploit late\n    if opp_d == 0:\n        if n >= 92:\n            return 'D'\n        # small occasional probe to guard against noise/exploitable detection\n        if n >= 30 and rng.random() < 0.015:\n            return 'D'\n        return 'C'\n\n    # Constant/mostly defector detection\n    if opp_d >= 4 and opp_d * 3 > (opp_c + 1) * 2:\n        if rec_opp_c >= 3 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent defected last: retaliate (defect), but forgive selectively\n    if last_op == 'D':\n        # If they're a rare defector, forgive fast\n        if opp_d <= n * 0.2 and streak_d <= 1 and rng.random() < 0.45:\n            return 'C'\n        # If recent defection is clustered, stay on D\n        if rec_opp_d >= 3:\n            return 'D'\n        # If we've defected a lot recently, try to repair\n        if rec_my_d >= 4 and rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last\n    # If we defected last round, often return to C (restore cooperation)\n    if last_me == 'D':\n        if rec_opp_d == 0 and opp_d <= n * 0.15:\n            return 'C'\n        if last_op == 'C':\n            # We have reason to keep cooperation only if opponent not too hostile\n            if opp_d * 2 <= n:\n                return 'C'\n            if rng.random() < 0.55:\n                return 'C'\n            return 'D'\n\n    # Opponent cooperated and we cooperated: mostly cooperate\n    # Defect ratio-based adaptation\n    if opp_d * 4 > n:\n        # moderately hostile\n        if rec_opp_d >= 2:\n            return 'D'\n        if rng.random() < 0.35:\n            return 'D'\n        return 'C'\n\n    if opp_d * 10 > n:\n        if rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    # End-game exploitation of cooperative opponents\n    if n >= 90:\n        if opp_d <= n * 0.25:\n            if rng.random() < 0.6:\n                return 'D'\n        return 'C'\n\n    # Occasional probing late midgame\n    if n >= 60 and n < 85 and opp_d * 8 < n:\n        if rng.random() < 0.05:\n            return 'D'\n\n    return 'C'"
  },
