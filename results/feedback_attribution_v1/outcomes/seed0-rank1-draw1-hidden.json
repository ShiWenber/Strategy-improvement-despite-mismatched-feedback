  "child": {
    "name": "seed0-rank1-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    # Endgame: with enough info, exploit defectors, cooperate with cooperators\n    if n >= 95:\n        opp_c_early = sum(1 for a, b in history if b == 'C')\n        if opp_c_early * 100 >= n * 75:\n            return 'C'\n        return 'D'\n    if n == 1:\n        return 'C' if history[0][1] == 'C' else 'D'\n    # Gather stats\n    opp_c = sum(1 for a, b in history if b == 'C')\n    my_c = sum(1 for a, b in history if a == 'C')\n    opp_rate = opp_c / n\n    # Recent window\n    wlen = 10 if n >= 10 else n\n    recent = history[-wlen:]\n    rec_opp_c = sum(1 for a, b in recent if b == 'C')\n    rec_opp_d = wlen - rec_opp_c\n    rec_my_d = sum(1 for a, b in recent if a == 'D')\n    opp_last = history[-1][1]\n    my_last = history[-1][0]\n    # Consecutive opponent defections\n    run_d = 0\n    for a, b in reversed(history):\n        if b == 'D':\n            run_d += 1\n        else:\n            break\n    run_c = 0\n    for a, b in reversed(history):\n        if b == 'C':\n            run_c += 1\n        else:\n            break\n    # Very cooperative opponent: exploit occasionally but stay cooperative\n    if opp_rate >= 0.85:\n        if n >= 25 and n <= 85 and rng.random() < 0.12:\n            return 'D'\n        return 'C'\n    # Very uncooperative opponent: defect\n    if opp_rate <= 0.3:\n        if n >= 40 and rng.random() < 0.05:\n            return 'C'\n        return 'D'\n    # Sustained opponent defection: punish\n    if run_d >= 3:\n        return 'D'\n    # Mutual defection: try to reset\n    if run_d >= 1 and my_last == 'D':\n        if rng.random() < 0.35:\n            return 'C'\n        return 'D'\n    # Opponent defected after our cooperation: retaliate with high probability\n    if opp_last == 'D':\n        if rec_opp_d >= 4:\n            return 'D'\n        if rng.random() < 0.8:\n            return 'D'\n        return 'C'\n    # Opponent cooperated:\n    if run_c >= 4 or rec_opp_c >= 8:\n        # Strong cooperation - reward it\n        if n >= 30 and n <= 80 and rng.random() < 0.07:\n            return 'D'\n        return 'C'\n    # Moderate region: be cautious, mirror-ish\n    if rec_opp_d >= 4:\n        if rng.random() < 0.75:\n            return 'D'\n        return 'C'\n    # If we've been defecting a lot and opponent still cooperates, ease off\n    if rec_my_d >= 5:\n        return 'C'\n    return 'C'"
  },
