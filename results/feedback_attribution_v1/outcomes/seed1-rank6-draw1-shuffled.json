    "name": "seed1-rank6-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    me = [h[0] for h in history]\n    opp = [h[1] for h in history]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    last_me = me[-1]\n    last_opp = opp[-1]\n\n    # Final round: grab the extra point if opponent likely cooperates.\n    if n >= 100:\n        return 'D'\n    if n == 99:\n        if opp_c * 2 >= n:\n            return 'D'\n        return 'D'\n\n    # Endgame exploitation window against a cooperative opponent.\n    remaining = 100 - n\n    if remaining <= 3 and opp_c * 3 >= n * 2:\n        return 'D'\n    if remaining <= 6 and opp_c * 4 >= n * 3:\n        return 'D'\n\n    # Detect a periodic opponent pattern in last 8 moves.\n    if n >= 8:\n        best_period = 0\n        for p in range(1, 5):\n            ok = True\n            for i in range(n - p, n):\n                if opp[i] != opp[i - p]:\n                    ok = False\n                    break\n            if ok:\n                best_period = p\n                break\n        if best_period:\n            predicted = opp[n - best_period]\n            # Exploit predicted cooperator, avoid predicted defector's trap.\n            if predicted == 'C':\n                return 'D'\n            return 'D'\n\n    # Punish sustained defection.\n    if n >= 3 and opp[-3:] == ['D', 'D', 'D']:\n        if rng.random() < 0.05:\n            return 'C'\n        return 'D'\n\n    # If opponent defected a lot recently, retaliate hard.\n    if n >= 6:\n        last6_d = opp[-6:].count('D')\n        if last6_d >= 4:\n            return 'D'\n    if n >= 10:\n        last10_d = opp[-10:].count('D')\n        if last10_d >= 6:\n            return 'D'\n\n    # If opponent is overwhelmingly cooperative, cooperate with light probing.\n    if opp_d == 0:\n        if n >= 30 and n % 13 == 12:\n            return 'D'\n        return 'C'\n\n    # Cooperate if opponent is very likely to cooperate overall.\n    if opp_c * 4 >= n * 3:\n        if last_opp == 'D' and n >= 2 and opp[-2] == 'D':\n            return 'D'\n        if rng.random() < 0.02:\n            return 'D'\n        return 'C'\n\n    # Respond to last round.\n    if last_opp == 'D':\n        # Forgive isolated defection if overall record is decent.\n        if opp_c * 2 >= n:\n            if (n < 3 or opp[-2] == 'C') and rng.random() < 0.2:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last round.\n    if last_me == 'D':\n        return 'C'\n    if opp_c * 3 < n and rng.random() < 0.15:\n        return 'D'\n    return 'C'"
  },
