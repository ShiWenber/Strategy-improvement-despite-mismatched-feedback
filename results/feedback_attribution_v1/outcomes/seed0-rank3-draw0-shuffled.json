  "child": {
    "name": "seed0-rank3-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n\n    opp_d = 0\n    for a in opp:\n        if a == 'D':\n            opp_d += 1\n    opp_c = n - opp_d\n    my_d = 0\n    for a in my:\n        if a == 'D':\n            my_d += 1\n\n    # Count consecutive opponent defections from the end\n    run_d = 0\n    for a in reversed(opp):\n        if a == 'D':\n            run_d += 1\n        else:\n            break\n    run_c = 0\n    for a in reversed(opp):\n        if a == 'C':\n            run_c += 1\n        else:\n            break\n\n    # Very cooperative opponent: cooperate, with rare probing early/mid\n    if opp_d == 0:\n        if 15 <= n <= 70 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # Pure defector: defect\n    if opp_c == 0:\n        return 'D'\n\n    # Opponent mostly cooperative\n    if opp_d * 10 <= n:\n        # Strongly cooperative run -> cooperate solidly\n        if run_d == 0:\n            if 20 <= n <= 80 and rng.random() < 0.08:\n                return 'D'\n            return 'C'\n        # Recent defection from cooperative opponent: retaliate briefly\n        if run_d == 1:\n            if rng.random() < 0.75:\n                return 'D'\n            return 'C'\n        if run_d >= 2:\n            return 'D'\n\n    # Moderate defection rate\n    if opp_d * 10 <= n * 4:\n        if run_d >= 2:\n            return 'D'\n        if run_d == 0:\n            # Opponent cooperating: be nice but probe occasionally\n            if n >= 90:\n                return 'C'\n            if opp_d * 10 >= n * 2 and rng.random() < 0.12:\n                return 'D'\n            return 'C'\n        # run_d == 1\n        if rng.random() < 0.8:\n            return 'D'\n        return 'C'\n\n    # High defection rate: mostly defect\n    if run_c >= 3:\n        # Opponent showed cooperation streak; cooperate back but stay alert\n        if rng.random() < 0.6:\n            return 'C'\n        return 'D'\n    if run_c == 0:\n        return 'D'\n    # run_c 1 or 2 with high defect rate: defect, occasional test cooperation\n    if rng.random() < 0.08:\n        return 'C'\n    return 'D'"
  },
