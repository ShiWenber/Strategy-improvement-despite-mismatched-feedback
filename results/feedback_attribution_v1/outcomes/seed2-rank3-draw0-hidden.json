  "child": {
    "name": "seed2-rank3-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    # score bookkeeping\n    my_score = 0\n    opp_score = 0\n    opp_defects = 0\n    my_defects = 0\n    for me, op in history:\n        if me == 'C':\n            if op == 'C':\n                my_score += 3\n                opp_score += 3\n            else:\n                opp_score += 5\n        else:\n            if op == 'C':\n                my_score += 5\n            else:\n                my_score += 1\n                opp_score += 1\n        if op == 'D':\n            opp_defects += 1\n        if me == 'D':\n            my_defects += 1\n    opp_coops = n - opp_defects\n    rounds_left = 100 - n\n    last_me, last_opp = history[-1]\n    # recent window\n    w = min(8, n)\n    recent_opp_d = 0\n    for i in range(n - w, n):\n        if history[i][1] == 'D':\n            recent_opp_d += 1\n    recent_me_d = 0\n    for i in range(n - w, n):\n        if history[i][0] == 'D':\n            recent_me_d += 1\n\n    # Near-end: exploit cooperators, retaliate against defectors.\n    if rounds_left <= 3:\n        if opp_defects * 4 <= n:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        # mixed - take the shot\n        return 'D' if rng.random() < 0.5 else 'C'\n\n    if rounds_left <= 10:\n        if opp_defects == 0:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        if opp_defects * 5 <= n:\n            return 'D' if rng.random() < 0.6 else 'C'\n        return 'C'\n\n    # Detect always-defector / heavy defector.\n    if n >= 4 and opp_defects * 2 > n and recent_opp_d >= 2:\n        return 'D'\n\n    # Pure cooperator: keep mutual cooperation, occasional probe.\n    if opp_defects == 0:\n        if n >= 8 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n\n    # Opponent mostly cooperative.\n    if opp_defects * 4 <= n:\n        if last_opp == 'D':\n            # forgive quickly to repair, but punish repeat\n            if recent_opp_d >= 2:\n                return 'D'\n            return 'D' if rng.random() < 0.3 else 'C'\n        # cooperate, with light probing\n        if n >= 12 and rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # Opponent mostly defective.\n    if opp_defects * 3 > n * 2:\n        # defect to avoid being exploited, but rebuild if they turn around\n        if last_opp == 'C' and recent_opp_d == 0 and rng.random() < 0.4:\n            return 'C'\n        return 'D' if rng.random() < 0.85 else 'C'\n\n    # Mixed opponent: tit-for-tat with controlled forgiveness.\n    if last_opp == 'D':\n        if recent_opp_d >= 3:\n            return 'D'\n        if last_me == 'D' and rng.random() < 0.25:\n            return 'C'\n        return 'D' if rng.random() < 0.7 else 'C'\n    else:\n        if last_me == 'D':\n            return 'C'\n        if recent_opp_d >= 2 and rng.random() < 0.25:\n            return 'D'\n        return 'C'\n    return 'C'"
  },
