  "child": {
    "name": "seed4-rank1-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    if n == 2:\n        return 'C'\n\n    # Count opponent cooperation over whole match and recent window.\n    opp_c_total = 0\n    for a, b in history:\n        if b == 'C':\n            opp_c_total += 1\n    opp_d_total = n - opp_c_total\n\n    window = 12 if n >= 12 else n\n    opp_c_recent = 0\n    for i in range(n - window, n):\n        if history[i][1] == 'C':\n            opp_c_recent += 1\n    recent_coop = opp_c_recent / window\n\n    # Current streak of opponent defections and cooperations.\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    opp_c_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'C':\n            opp_c_streak += 1\n        else:\n            break\n\n    # Detect mutual cooperation streak.\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][0] == 'C' and history[i][1] == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    last_me, last_opp = history[-1]\n\n    # Endgame: secure mutual cooperation if opponent generally reliable, otherwise exploit.\n    if n >= 98:\n        if opp_c_total >= n - 4 and recent_coop >= 0.5:\n            return 'C'\n        if opp_d_total >= 2 and recent_coop < 0.5:\n            return 'D'\n        return 'C'\n\n    # Persistent defector: defect nearly always, occasional probe.\n    if n >= 8 and opp_c_total * 4 <= n:\n        if n % 19 == 0:\n            return 'C'\n        return 'D'\n\n    # If opponent has been cooperating nearly always, cooperate to bank CC=3.\n    if opp_c_total >= n - 1 and n >= 4:\n        return 'C'\n\n    # High recent cooperation -> cooperate, even after rare defection (forgiving).\n    if recent_coop >= 0.75:\n        return 'C'\n\n    # After a short defection burst by a generally cooperative opponent, forgive.\n    if last_opp == 'D' and opp_d_streak <= 2 and opp_c_total * 3 >= n * 2:\n        if rng.random() < 0.65:\n            return 'C'\n\n    # Long defection streak -> retaliate firmly.\n    if opp_d_streak >= 3:\n        # If opponent had strong prior cooperation, occasionally re-probe.\n        if opp_c_total * 2 >= n and rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    # Mutual cooperation active -> keep it.\n    if cc_streak >= 2 and last_opp == 'C':\n        return 'C'\n\n    # If opponent just defected, retaliate but with some mercy if recent coop is decent.\n    if last_opp == 'D':\n        if recent_coop >= 0.5 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated. If moderately cooperative, cooperate; if exploitative, sometimes defect.\n    if recent_coop >= 0.5:\n        # Occasionally exploit a very trusting opponent.\n        if opp_c_streak >= 5 and opp_d_total <= 1 and n < 90:\n            if rng.random() < 0.08:\n                return 'D'\n        return 'C'\n\n    # Otherwise defect-leaning.\n    if rng.random() < 0.8:\n        return 'D'\n    return 'C'"
  },
