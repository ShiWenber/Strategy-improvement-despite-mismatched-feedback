    "name": "seed0-rank6-draw0-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C' if history[0][1] == 'C' else 'D'\n\n    # Extract actions\n    my_actions = [h[0] for h in history]\n    opp_actions = [h[1] for h in history]\n\n    # Counts\n    opp_c = 0\n    for a in opp_actions:\n        if a == 'C':\n            opp_c += 1\n    opp_d = n - opp_c\n    my_c = 0\n    for a in my_actions:\n        if a == 'C':\n            my_c += 1\n    my_d = n - my_c\n\n    # Consecutive opponent defections/cooperations from end\n    consec_opp_d = 0\n    for i in range(n - 1, -1, -1):\n        if opp_actions[i] == 'D':\n            consec_opp_d += 1\n        else:\n            break\n\n    consec_opp_c = 0\n    for i in range(n - 1, -1, -1):\n        if opp_actions[i] == 'C':\n            consec_opp_c += 1\n        else:\n            break\n\n    # Recent window stats (last 10)\n    start = n - 10\n    if start < 0:\n        start = 0\n    recent_d = 0\n    recent_c = 0\n    for i in range(start, n):\n        if opp_actions[i] == 'D':\n            recent_d += 1\n        else:\n            recent_c += 1\n    recent_total = recent_d + recent_c\n\n    # Last 20 window\n    start20 = n - 20\n    if start20 < 0:\n        start20 = 0\n    win20_d = 0\n    for i in range(start20, n):\n        if opp_actions[i] == 'D':\n            win20_d += 1\n    win20_total = n - start20\n\n    opp_coop_rate = opp_c / n\n\n    # Detect mutual defection streak (last 5)\n    if n >= 5:\n        dd_count = 0\n        for i in range(n - 5, n):\n            if my_actions[i] == 'D' and opp_actions[i] == 'D':\n                dd_count += 1\n        if dd_count >= 4:\n            # Try to break out (unless clearly bad endgame)\n            if n >= 95 and opp_coop_rate < 0.4:\n                return 'D'\n            return 'C'\n\n    # Very early game: start cooperative, retaliate immediately on defection\n    if n < 4:\n        last_o = opp_actions[-1]\n        if last_o == 'D':\n            return 'D'\n        return 'C'\n\n    # If opponent is essentially a pure defector, defect\n    if n >= 8 and opp_d >= n - 1:\n        # but final rounds can't help; just defect\n        return 'D'\n\n    # Endgame logic (last few rounds matter for cumulative)\n    rounds_left = 100 - n\n    if rounds_left <= 3:\n        # Defect if opponent is likely to defect (based on recent rate)\n        if recent_total > 0 and recent_d * 2 >= recent_total:\n            return 'D'\n        # If opponent likely cooperates, cooperate (mutual CC = 3 better than DD = 1)\n        if opp_coop_rate > 0.6:\n            return 'C'\n        # Ambiguous: prefer cooperation only if very likely; else defect\n        if opp_coop_rate > 0.45:\n            return 'C'\n        return 'D'\n\n    # If opponent never defected, cooperate but occasionally probe\n    if opp_d == 0:\n        if n >= 30 and rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    # If opponent defects very frequently, mostly defect with occasional C test\n    if opp_coop_rate < 0.25:\n        if n < 90 and rng.random() < 0.07:\n            return 'C'\n        return 'D'\n\n    # If opponent highly cooperative overall, cooperate with light probing\n    if opp_coop_rate > 0.85:\n        if n >= 20 and n < 90 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # If recent behavior shows heavy defection, defect\n    if recent_total >= 5 and recent_d * 2 >= recent_total:\n        # But if opponent just cooperated and is mostly cooperative, maybe forgive\n        if opp_actions[-1] == 'C' and opp_coop_rate > 0.6 and rng.random() < 0.3:\n            return 'C'\n        return 'D'\n\n    # If consecutive defections, punish\n    if consec_opp_d >= 2:\n        return 'D'\n\n    # If opponent just defected\n    if opp_actions[-1] == 'D':\n        # If we also defected, try to reset sometimes\n        if my_actions[-1] == 'D':\n            if opp_coop_rate > 0.5 and rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        # Opponent defected while we cooperated: retaliate strongly\n        # unless they are generally cooperative (forgiveness)\n        if opp_coop_rate > 0.7 and rng.random() < 0.4:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round\n    if my_actions[-1] == 'D':\n        # We exploited and they cooperated—be nice now\n        return 'C'\n\n    # Both cooperated: check for alternating/pattern\n    if n >= 4:\n        # Alternating D-C-D-C pattern -> predict D\n        alt = True\n        for i in range(n - 4, n - 1):\n            if opp_actions[i] == opp_actions[i + 1]:\n                alt = False\n                break\n        if alt and opp_actions[-1] == 'C':\n            return 'D'\n        if alt and opp_actions[-1] == 'D':\n            return 'C'\n\n    # Long-run moderate cooperation\n    if opp_coop_rate > 0.6:\n        return 'C'\n\n    # Fallback mixed: match cooperation rate roughly\n    if rng.random() < opp_coop_rate:\n        return 'C'\n    return 'D'"
