  "child": {
    "name": "seed0-rank3-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    if opp_d == 0:\n        if n >= 20 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n    if opp_d >= n - 1:\n        return 'D'\n    run = 0\n    for a in reversed(opp):\n        if a == 'D':\n            run += 1\n        else:\n            break\n    run_c = 0\n    for a in reversed(opp):\n        if a == 'C':\n            run_c += 1\n        else:\n            break\n    dd_run = 0\n    for i in range(n - 1, -1, -1):\n        if my[i] == 'D' and opp[i] == 'D':\n            dd_run += 1\n        else:\n            break\n    if dd_run >= 3:\n        return 'C'\n    recent = opp[-10:] if n >= 10 else opp\n    recent_d = recent.count('D')\n    recent_c = len(recent) - recent_d\n    if n >= 20:\n        w20 = opp[-20:]\n        d20 = w20.count('D')\n        if d20 >= 17:\n            return 'D'\n        if d20 <= 1:\n            return 'C'\n    if run >= 4:\n        return 'D'\n    if recent_d >= 6:\n        return 'D'\n    if recent_d == 0:\n        if n >= 30 and rng.random() < 0.04:\n            return 'D'\n        return 'C'\n    last_opp = opp[-1]\n    last_my = my[-1]\n    if last_opp == 'C':\n        if last_my == 'D':\n            return 'C'\n        if run_c >= 5 and opp_d * 4 < n:\n            if rng.random() < 0.03:\n                return 'D'\n        return 'C'\n    if last_opp == 'D':\n        if last_my == 'C':\n            if run == 1 and opp_d * 4 < n and rng.random() < 0.35:\n                return 'C'\n            return 'D'\n        else:\n            if recent_d >= 4:\n                return 'D'\n            if rng.random() < 0.35:\n                return 'C'\n            return 'D'\n    return 'C'"
  },
