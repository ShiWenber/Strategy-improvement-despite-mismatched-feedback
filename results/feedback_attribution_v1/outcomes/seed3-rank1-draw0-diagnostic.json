  "child": {
    "name": "seed3-rank1-draw0-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    def opp(i):\n        return history[i][1]\n\n    def me(i):\n        return history[i][0]\n\n    last_opp = opp(n - 1)\n    last_me = me(n - 1)\n\n    # Count opponent behavior.\n    opp_c = 0\n    opp_d = 0\n    my_d = 0\n    for i in range(n):\n        if opp(i) == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if me(i) == 'D':\n            my_d += 1\n\n    coop_rate = opp_c / n\n\n    # Recent opponent behavior.\n    window = 10 if n >= 10 else n\n    recent_c = 0\n    for i in range(n - window, n):\n        if opp(i) == 'C':\n            recent_c += 1\n    recent_rate = recent_c / window\n\n    # Endgame: slight exploitation but only against very cooperative opponents.\n    remaining = 100 - n\n    if remaining <= 1:\n        if coop_rate >= 0.5:\n            return 'D'\n        return 'D' if opp_d > opp_c else 'C'\n\n    # If opponent is extremely cooperative, mostly cooperate but rarely probe.\n    if coop_rate >= 0.9:\n        if remaining > 5 and n >= 20 and n % 23 == 0:\n            return 'D'\n        return 'C'\n\n    # If opponent is mostly defective, defend with occasional tests.\n    if coop_rate <= 0.25:\n        if n % 11 == 0:\n            return 'C'\n        return 'D'\n\n    # If opponent just defected:\n    if last_opp == 'D':\n        # If we have been cooperating and this is a rare defection, retaliate once.\n        if last_me == 'C':\n            return 'D'\n        # Both defected: try to escape DD traps with periodic cooperation,\n        # but only if opponent is not too defective overall.\n        if coop_rate >= 0.45:\n            if n % 3 == 0:\n                return 'C'\n            return 'D'\n        else:\n            if n % 5 == 0:\n                return 'C'\n            return 'D'\n\n    # Opponent just cooperated.\n    if last_me == 'D':\n        # We defected and they cooperated: likely safe to return to C unless\n        # they are generally defective or recently defected a lot.\n        if recent_rate >= 0.4 or coop_rate >= 0.5:\n            return 'C'\n        if rng.random() < 0.6:\n            return 'C'\n        return 'D'\n\n    # Both cooperated last round.\n    # If recent cooperation is high, keep cooperating.\n    if recent_rate >= 0.8:\n        # Rare probe to test exploitability, mainly mid-game.\n        if remaining > 15 and n >= 15 and n % 29 == 0:\n            return 'D'\n        return 'C'\n\n    # Mixed recent behavior: cooperate cautiously, retaliate against runs of D.\n    if recent_rate >= 0.5:\n        return 'C'\n\n    # Opponent has been recently more defective: defect more.\n    if n % 4 == 0:\n        return 'C'\n    return 'D'"
  },
