  "child": {
    "name": "seed2-rank1-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Gather stats\n    opp_def = 0\n    my_def = 0\n    for h in history:\n        if h[1] == 'D':\n            opp_def += 1\n        if h[0] == 'D':\n            my_def += 1\n    opp_coop = n - opp_def\n\n    # Recent window stats\n    w = 8 if n >= 8 else n\n    recent = history[n - w:]\n    r_opp_def = 0\n    r_opp_coop = 0\n    for h in recent:\n        if h[1] == 'D':\n            r_opp_def += 1\n        else:\n            r_opp_coop += 1\n\n    # Opponent last few moves\n    last_opp = history[-1][1]\n    prev_opp = history[-2][1] if n >= 2 else 'C'\n\n    # opening: cooperate\n    if n < 3:\n        return 'C'\n\n    # Detect nearly-always-defector\n    if opp_def >= 5 and opp_def * 3 > n * 2:\n        # Defect almost always, rare random probe\n        if rng.random() < 0.95:\n            return 'D'\n        return 'C'\n\n    # Detect highly cooperative opponent\n    if opp_def == 0:\n        # Opponent always cooperated. Exploit near end, otherwise cooperate.\n        if n >= 95:\n            return 'D'\n        if n >= 80 and rng.random() < 0.15:\n            return 'D'\n        # occasional test to see if exploitable\n        if n >= 20 and n % 13 == 0 and rng.random() < 0.4:\n            return 'D'\n        return 'C'\n\n    if opp_def * 6 <= n:\n        # very cooperative opponent (<= ~16% defection)\n        if n >= 97:\n            return 'D'\n        if n >= 85 and rng.random() < 0.25:\n            return 'D'\n        if last_opp == 'D':\n            # forgive quickly\n            if r_opp_def <= 1 and rng.random() < 0.5:\n                return 'C'\n            return 'D'\n        return 'C'\n\n    # Mixed opponent - tit-for-tat with adaptive forgiveness\n    if last_opp == 'D':\n        # retaliate\n        if r_opp_def >= 3:\n            return 'D'\n        # forgive if opponent mostly cooperative\n        if opp_coop * 3 >= n * 2:\n            if rng.random() < 0.2:\n                return 'C'\n            return 'D'\n        # if we've been defecting a lot, ease up (avoids mutual DD lock)\n        if my_def >= 3 and my_def >= opp_def and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # last_opp == 'C'\n    if n >= 95:\n        return 'D'\n    if n >= 85 and opp_def * 4 <= n:\n        if rng.random() < 0.3:\n            return 'D'\n    # If opponent defected recently but cooperated last, cautious\n    if r_opp_def >= 2:\n        if rng.random() < 0.25:\n            return 'D'\n        return 'C'\n    # If we just defected, cooperate to rebuild\n    if history[-1][0] == 'D':\n        return 'C'\n    return 'C'"
  },
