    "name": "seed1-rank6-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Collect compact stats.\n    opp_c = 0\n    my_c = 0\n    last_opp = history[-1][1]\n    last_me = history[-1][0]\n    for m, o in history:\n        if o == 'C':\n            opp_c += 1\n        if m == 'C':\n            my_c += 1\n    opp_d = n - opp_c\n    coop_rate = opp_c / n\n\n    # Endgame: last two rounds exploit a known cooperator, otherwise defect.\n    if n >= 99:\n        return 'D'\n    if n >= 96:\n        return 'D' if coop_rate > 0.5 else 'D'\n\n    # Strongly defective opponent: punish hard.\n    if coop_rate < 0.25:\n        return 'D'\n\n    # Count recent consecutive opponent defections (from the tail).\n    consec_d = 0\n    for m, o in reversed(history):\n        if o == 'D':\n            consec_d += 1\n        else:\n            break\n\n    # Count recent consecutive mutual cooperation.\n    consec_cc = 0\n    for m, o in reversed(history):\n        if m == 'C' and o == 'C':\n            consec_cc += 1\n        else:\n            break\n\n    # Very cooperative opponent: mostly cooperate, probe rarely, exploit a bit near end.\n    if coop_rate > 0.9:\n        if n >= 90:\n            if last_opp == 'C':\n                return 'D'\n        if consec_cc >= 8 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # If opponent just defected: retaliate, but forgive isolated defections\n    # against an otherwise cooperative opponent (breaks DD spirals).\n    if last_opp == 'D':\n        if consec_d >= 3:\n            return 'D'\n        if consec_d == 1 and coop_rate > 0.7 and rng.random() < 0.35:\n            return 'C'\n        if consec_d == 2 and coop_rate > 0.75 and rng.random() < 0.2:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated last round.\n    # If we just defected, return to cooperation to rebuild trust.\n    if last_me == 'D':\n        return 'C'\n\n    # Both cooperated last round: maintain cooperation.\n    # If opponent has shown occasional defections, occasionally remind them.\n    if coop_rate < 0.6 and rng.random() < 0.08:\n        return 'D'\n    if coop_rate > 0.75 and consec_cc >= 5 and n % 17 == 0:\n        # Rare probe to test for exploitability.\n        return 'D'\n    return 'C'"
  },
