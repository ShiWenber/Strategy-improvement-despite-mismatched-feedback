    "name": "seed2-rank1-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n\n    # Tally opponent and own behavior\n    opp_c = 0\n    opp_d = 0\n    my_c = 0\n    my_d = 0\n    for mine, theirs in history:\n        if theirs == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if mine == 'C':\n            my_c += 1\n        else:\n            my_d += 1\n\n    last_me, last_opp = history[-1]\n\n    # Recent window of 6\n    w = 6 if n >= 6 else n\n    recent = history[-w:]\n    r_opp_c = 0\n    r_opp_d = 0\n    r_my_d = 0\n    for mine, theirs in recent:\n        if theirs == 'C':\n            r_opp_c += 1\n        else:\n            r_opp_d += 1\n        if mine == 'D':\n            r_my_d += 1\n\n    # Detect pure/almost-pure defector: extract remaining value\n    if opp_d >= 4 and opp_c <= 1 and n >= 5:\n        if r_opp_d >= 2:\n            return 'D'\n        return 'D' if rng.random() < 0.95 else 'C'\n\n    # Detect nearly-pure cooperator: exploit only in final rounds\n    if opp_d == 0:\n        if n >= 97:\n            return 'D'\n        if n >= 90:\n            return 'D' if rng.random() < 0.5 else 'C'\n        return 'C'\n\n    # Highly cooperative opponent: mostly cooperate, rare stiff probe, endgame exploit\n    if opp_c >= 3 and opp_c * 3 >= opp_d * 2:\n        if n >= 97:\n            return 'D'\n        if n >= 90:\n            if rng.random() < 0.35:\n                return 'D'\n        # If opponent mistakenly defected once, don't spiral: forgive promptly\n        if last_opp == 'D':\n            if r_opp_d <= 1 and rng.random() < 0.6:\n                return 'C'\n            return 'D'\n        # Rare probing only in mid-game\n        if 20 <= n < 85 and rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # Opponent has been mostly defecting\n    if opp_d * 2 > opp_c + 1:\n        if n >= 97:\n            return 'D'\n        if r_opp_d >= 3:\n            return 'D'\n        # Don't reward occasional defection with cooperation\n        if last_opp == 'D':\n            return 'D' if rng.random() < 0.9 else 'C'\n        # Opponent just cooperated: reward but stay wary\n        if rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # Balanced opponent: tit-for-tat with controlled forgiveness and endgame\n    if n >= 97:\n        return 'D'\n    if n >= 90:\n        if opp_d <= 2:\n            return 'D' if rng.random() < 0.7 else 'C'\n        if last_opp == 'D':\n            return 'D'\n        return 'D' if rng.random() < 0.4 else 'C'\n\n    if last_opp == 'D':\n        # Excessive recent defection -> hard punish\n        if r_opp_d >= 3:\n            return 'D'\n        # If we ourselves defected last round, follow up to avoid alternating noise\n        if last_me == 'D':\n            return 'D' if rng.random() < 0.7 else 'C'\n        # Forgive sometimes if opponent is mostly cooperative overall\n        if opp_c > opp_d and r_opp_d <= 1 and rng.random() < 0.25:\n            return 'C'\n        return 'D'\n\n    # Opponent cooperated\n    if last_me == 'D':\n        # We just defected and opponent cooperated: repeat if exploitable, else return to C\n        if opp_d * 4 < n and n >= 15 and rng.random() < 0.35:\n            return 'D'\n        return 'C'\n    # Both cooperated\n    if r_opp_d >= 2:\n        return 'D' if rng.random() < 0.6 else 'C'\n    if n >= 20 and r_my_d == 0 and opp_d * 8 < n and rng.random() < 0.02:\n        return 'D'\n    return 'C'"
  },
