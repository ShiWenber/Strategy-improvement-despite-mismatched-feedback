    "name": "seed4-rank6-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    if not history:\n        return 'C'\n    n = len(history)\n    my = [h[0] for h in history]\n    op = [h[1] for h in history]\n    opp_last = op[-1]\n    my_last = my[-1]\n\n    # Endgame exploitation: defect on final round against likely cooperators.\n    if n >= 99:\n        return 'D'\n    if n >= 98:\n        # Second-to-last: only defect if opponent looks cooperative/forgiving.\n        opp_c = op.count('C')\n        if opp_c >= 60:\n            return 'D'\n        return 'C'\n\n    # Count consecutive opponent defections at the end.\n    k = 0\n    for a in reversed(op):\n        if a == 'D':\n            k += 1\n        else:\n            break\n\n    # Count consecutive opponent cooperations at the end.\n    c_streak = 0\n    for a in reversed(op):\n        if a == 'C':\n            c_streak += 1\n        else:\n            break\n\n    cc = sum(1 for a, b in history if a == 'C' and b == 'C')\n    cd = sum(1 for a, b in history if a == 'C' and b == 'D')\n    dc = sum(1 for a, b in history if a == 'D' and b == 'C')\n    dd = sum(1 for a, b in history if a == 'D' and b == 'D')\n\n    opp_c = cc + dc\n    opp_d = cd + dd\n    my_c = cc + cd\n\n    # Pure cooperator: keep cooperating, but exploit at very end (already handled above).\n    if opp_d == 0:\n        return 'C'\n\n    # Strong defector: defect hard once clearly identified.\n    if n >= 6 and opp_d * 3 >= n * 2:\n        # Probe rarely to detect a switch back to cooperation.\n        if n % 20 == 0 and c_streak >= 0:\n            return 'C'\n        return 'D'\n\n    # Opponent just defected.\n    if opp_last == 'D':\n        # Long defection streak: punish, but occasionally forgive if history was good.\n        if k >= 3:\n            prior_c = op[:-k].count('C')\n            if n - k >= 6 and prior_c >= n - k - 1 and rng.random() < 0.4:\n                return 'C'\n            # Test periodically to see if opponent has returned to cooperation.\n            if k >= 5 and k % 4 == 0 and prior_c >= (n - k) // 2:\n                return 'C'\n            return 'D'\n        # Short defection burst: retaliate once, then forgive.\n        if k == 1:\n            # Forgive quickly if opponent has been reliably cooperative.\n            if opp_d <= 2 and n >= 8:\n                return 'C'\n            # Occasional forgiveness to avoid noise-driven death spirals.\n            if rng.random() < 0.25 and opp_c * 3 >= n * 2:\n                return 'C'\n            return 'D'\n        # k == 2\n        if opp_d * 4 <= n and rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    # Opponent just cooperated.\n    # If we just defected and they still cooperated, return to cooperation.\n    if my_last == 'D':\n        if c_streak >= 1:\n            return 'C'\n\n    # Exploit clearly exploitable opponents: those who forgive our defections.\n    if dc >= 2 and opp_d <= 3 and n >= 20:\n        # Mild probing exploitation, not too aggressive.\n        if my_last == 'C' and rng.random() < 0.2:\n            return 'D'\n\n    # Opponent has been sufficiently cooperative: maintain CC.\n    if opp_c * 4 >= n * 3:\n        return 'C'\n\n    # Cautious middle: mostly cooperate, occasional probe.\n    if n >= 15 and cd >= 3 and cc * 2 < n:\n        if rng.random() < 0.3:\n            return 'D'\n\n    # Light probing early to detect exploitable opponents.\n    if n < 20 and n >= 10 and rng.random() < 0.05:\n        return 'D'\n\n    return 'C'"
  },
