    "name": "seed1-rank3-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # Tallies of opponent's reactions conditioned on our previous action.\n    cc = 0\n    cd = 0\n    dc = 0\n    dd = 0\n    opp_c = 0\n    for mine, opp in history:\n        if opp == 'C':\n            opp_c += 1\n        if mine == 'C':\n            if opp == 'C':\n                cc += 1\n            else:\n                cd += 1\n        else:\n            if opp == 'C':\n                dc += 1\n            else:\n                dd += 1\n\n    remaining = 100 - n\n    last_me, last_opp = history[-1]\n    coop_rate = opp_c / n\n\n    # Very short history: open cooperatively but retaliate immediately on a defection.\n    if n <= 2:\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Endgame: squeeze value. Against likely cooperators defect; against\n    # relentless defectors defecting is also safest (1 vs 0).\n    if remaining <= 3:\n        return 'D'\n\n    # Long-run exploitation of a nearly unconditional cooperator, but keep\n    # enough cooperation that we do not destroy the relationship too early.\n    if coop_rate > 0.9 and n >= 10:\n        if remaining <= 15:\n            return 'D'\n        if rng.random() < 0.15:\n            return 'D'\n        return 'C'\n\n    # Pure defector: cut losses.\n    if coop_rate < 0.15:\n        return 'D'\n\n    # Conditional cooperation probabilities.\n    after_c = cc / (cc + cd) if (cc + cd) > 0 else 0.5\n    after_d = dc / (dc + dd) if (dc + dd) > 0 else 0.5\n\n    # Opponent appears forgiving (cooperated after our defection).\n    forgiving = after_d > 0.5\n\n    # Opponent is a consistent retaliator (rarely cooperates after our D).\n    retaliatory = after_d < 0.2 and (dc + dd) >= 3\n\n    # Opponent punishes cooperative play (defects after our C).\n    punishing = after_c < 0.35 and (cc + cd) >= 4\n\n    if last_opp == 'C':\n        if punishing and rng.random() < 0.7:\n            return 'D'\n        # Maintain cooperation; occasional probe against very cooperative foes.\n        if coop_rate > 0.75 and remaining > 20 and rng.random() < 0.07:\n            return 'D'\n        return 'C'\n\n    # Opponent just defected.\n    if punishing:\n        return 'D'\n\n    if retaliatory:\n        # Mirror defection; only very rarely offer an olive branch.\n        if rng.random() < 0.04 and remaining > 10:\n            return 'C'\n        return 'D'\n\n    if forgiving and coop_rate > 0.5:\n        # Forgive isolated defections to restore mutual cooperation.\n        if rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    if coop_rate > 0.55:\n        if rng.random() < 0.15:\n            return 'C'\n        return 'D'\n\n    return 'D'"
  },
