    "name": "seed3-rank1-draw0-shuffled",
    "code": "import random\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n    last_my = my[-1]\n    last_opp = opp[-1]\n\n    remaining = 100 - n\n\n    # Endgame: defect in the final round to secure DC=5 if opponent likely cooperates.\n    if remaining <= 0:\n        return 'D'\n    if remaining == 1:\n        # Last round: defect against likely cooperators, otherwise make safe choice.\n        coop_count = opp.count('C')\n        if coop_count * 2 >= n:\n            return 'D'\n        return 'D'\n\n    # Track consecutive opponent cooperation to allow recovery from punishment.\n    run_c = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'C':\n            run_c += 1\n        else:\n            break\n\n    # Consecutive opponent defections at the tail.\n    run_d = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'D':\n            run_d += 1\n        else:\n            break\n\n    # Detect pure/very-cooperative opponent: exploit carefully while preserving enough CC.\n    if n >= 6:\n        coop_count = opp.count('C')\n        if coop_count == n:\n            # Opponent always cooperates. Keep mostly cooperating, occasionally defect\n            # but not so often that we destroy a sustained 3-per-round stream.\n            if remaining > 3 and n % 9 == 0:\n                return 'D'\n            return 'C'\n        if coop_count >= n - 1:\n            if remaining > 3 and n % 11 == 0:\n                return 'D'\n            return 'C'\n\n    # Detect pure defector.\n    if n >= 3 and opp.count('D') == n:\n        # Probe occasionally to see if they can be coaxed into cooperation.\n        if n % 17 == 0:\n            return 'C'\n        return 'D'\n\n    # Immediate retaliation with a controlled punishment length.\n    if last_opp == 'D':\n        if run_d >= 3:\n            # Deep defection streak: mostly defect, rare probe.\n            if n % 13 == 0:\n                return 'C'\n            return 'D'\n        # Short defection: punish, then be ready to forgive.\n        return 'D'\n\n    # Opponent cooperated last round.\n    if run_c >= 2:\n        # They are cooperating steadily. Cooperate, with rare probing near midgame.\n        if last_my == 'D':\n            # We just punished; return to cooperation to rebuild CC.\n            return 'C'\n        if remaining > 5 and n % 23 == 0:\n            return 'D'\n        return 'C'\n\n    if run_c == 1:\n        # They just cooperated after a defection. Forgive and cooperate to\n        # restore the cooperative equilibrium, unless they look like a chronic defector.\n        d_count = opp.count('D')\n        if d_count * 2 > n and n >= 8:\n            # Chronically defective; test them once more.\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'C'\n\n    # Fallback: cooperate.\n    return 'C'"
  },
