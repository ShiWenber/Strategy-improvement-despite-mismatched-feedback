    "name": "seed3-rank1-draw1-true",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    if n == 1:\n        return 'C'\n\n    def opp(i):\n        return history[i][1]\n\n    def me(i):\n        return history[i][0]\n\n    last_opp = opp(n - 1)\n    last_me = me(n - 1)\n    remaining = 100 - n\n\n    # Endgame: exploit likely cooperators, defend against defectors.\n    if remaining <= 2:\n        opp_c = 0\n        for i in range(n):\n            if opp(i) == 'C':\n                opp_c += 1\n        if opp_c * 2 >= n:\n            return 'D'\n        return 'D'\n\n    # Count recent opponent cooperation over last 10 rounds.\n    recent_len = 10 if n >= 10 else n\n    recent_c = 0\n    for i in range(n - recent_len, n):\n        if opp(i) == 'C':\n            recent_c += 1\n    recent_rate = recent_c / recent_len\n\n    # Overall rate.\n    total_c = 0\n    for i in range(n):\n        if opp(i) == 'C':\n            total_c += 1\n    overall_rate = total_c / n\n\n    # Pure always-cooperator detection: exploit but keep them cooperating.\n    if total_c == n:\n        # Avoid too much defection that could trigger them.\n        if n % 5 == 0:\n            return 'D'\n        return 'C'\n\n    # Always-defector detection.\n    if total_c == 0:\n        # Try occasional cooperation to see if they soften.\n        if n % 10 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent just defected.\n    if last_opp == 'D':\n        # If opponent has been mostly cooperative recently, retaliate once.\n        if recent_rate >= 0.7:\n            if last_me == 'D':\n                # We already retaliated; return to cooperation.\n                return 'C'\n            return 'D'\n        # If recent defections are high, keep defecting.\n        if recent_rate <= 0.3:\n            return 'D'\n        # Medium: retaliate, but occasionally forgive to break DD traps.\n        if last_me == 'D' and n >= 2 and opp(n - 2) == 'D':\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent just cooperated.\n    if recent_rate >= 0.8:\n        # Mostly cooperate, rarely probe if very stable and late enough.\n        if remaining > 5 and n >= 20 and n % 13 == 0:\n            return 'D'\n        return 'C'\n\n    if recent_rate >= 0.5:\n        # Mixed opponent. Cooperate, but occasionally defect when they seem safe.\n        if last_me == 'D':\n            return 'C'\n        if n >= 15 and n % 11 == 0:\n            return 'D'\n        return 'C'\n\n    # Opponent is mostly defecting recently. Defect to minimize losses,\n    # with rare cooperation to detect a change.\n    if n % 7 == 0:\n        return 'C'\n    return 'D'"
  },
