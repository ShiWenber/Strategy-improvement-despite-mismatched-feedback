  "child": {
    "name": "seed4-rank1-draw1-diagnostic",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    # Track recent context\n    recent = history[-8:]\n    rn = len(recent)\n    recent_opp_d = 0\n    recent_my_d = 0\n    for a, b in recent:\n        if b == 'D':\n            recent_opp_d += 1\n        if a == 'D':\n            recent_my_d += 1\n    recent_opp_c = rn - recent_opp_d\n\n    # Counts\n    opp_c = 0\n    opp_d = 0\n    cc = 0\n    cd = 0\n    dc = 0\n    dd = 0\n    for a, b in history:\n        if b == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if a == 'C' and b == 'C':\n            cc += 1\n        elif a == 'C' and b == 'D':\n            cd += 1\n        elif a == 'D' and b == 'C':\n            dc += 1\n        else:\n            dd += 1\n\n    my_last, opp_last = history[-1]\n    remaining = 100 - n\n\n    # Opponent's cooperation behavior mostly\n    opp_coop_rate = opp_c / n if n > 0 else 0\n\n    # Detect relentless defector\n    if opp_d >= n * 0.85 and n >= 6:\n        # punish consistently, but occasionally probe\n        if n % 19 == 0:\n            return 'C'\n        return 'D'\n\n    # Detect very cooperative opponent: exploit gently in mid-game, cooperate otherwise\n    if opp_coop_rate >= 0.95 and n >= 6:\n        # Against pure cooperator, occasionally defect to gain, but keep them cooperative\n        if remaining > 4:\n            # Defect about 25% of the time\n            if rng.random() < 0.25:\n                return 'D'\n            return 'C'\n        else:\n            return 'D'\n\n    # Endgame: squeeze last rounds against non-cooperative types\n    if remaining <= 2:\n        if opp_coop_rate > 0.6:\n            return 'D'\n        return 'D'\n\n    if remaining <= 5:\n        if opp_c >= n - 3:\n            return 'C'\n        if recent_opp_d >= 2:\n            return 'D'\n        return 'D'\n\n    # Default mostly-cooperative opponent: stay cooperative, punish clearly\n    if opp_coop_rate >= 0.8:\n        if opp_last == 'D':\n            # brief retaliation, then recover\n            if recent_opp_d >= 2:\n                return 'D'\n            return 'D'\n        return 'C'\n\n    # Moderate opponent: forgiving tit-for-tat with recovery bias\n    if opp_coop_rate >= 0.45:\n        # If recent window shows recovery (many C), cooperate\n        if recent_opp_c >= 5:\n            if opp_last == 'C':\n                return 'C'\n            # one D within a cooperative stretch: forgive\n            if recent_opp_d <= 1:\n                return 'C'\n            return 'D'\n        if opp_last == 'C':\n            return 'C'\n        # opponent defected: retaliate but quick to forgive\n        if recent_opp_d >= 3:\n            return 'D'\n        # occasional forgiveness\n        if rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    # Aggressive opponent: defect mostly, probe occasionally\n    if opp_last == 'C':\n        # they've turned nice: reciprocate mostly\n        if recent_opp_c >= rn * 0.6:\n            return 'C'\n        if rng.random() < 0.7:\n            return 'C'\n        return 'D'\n    if rng.random() < 0.9:\n        return 'D'\n    return 'C'"
  },
