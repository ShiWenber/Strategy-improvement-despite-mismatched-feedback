    "name": "seed0-rank6-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    my = [h[0] for h in history]\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n\n    # Detect run of opponent defections from the end\n    run_d = 0\n    for a in reversed(opp):\n        if a == 'D':\n            run_d += 1\n        else:\n            break\n\n    # Detect run of opponent cooperations from the end\n    run_c = 0\n    for a in reversed(opp):\n        if a == 'C':\n            run_c += 1\n        else:\n            break\n\n    # Always punish sustained defection streaks\n    if run_d >= 4:\n        return 'D'\n\n    # If opponent has never defected, cooperate (don't wreck mutual gains)\n    if opp_d == 0:\n        # Near endgame, lock in cooperation instead of exploiting\n        return 'C'\n\n    # If opponent is almost always defecting, defect too\n    if opp_d >= n - 1 and n >= 4:\n        return 'D'\n\n    last_opp = opp[-1]\n    last_my = my[-1]\n\n    # Mutual cooperation streaks: keep cooperating\n    if run_c >= 3 and opp_d * 4 <= n:\n        return 'C'\n\n    # Opponent cooperated last round\n    if last_opp == 'C':\n        # We defected into a cooperator: return to cooperation to preserve trust\n        if last_my == 'D':\n            return 'C'\n        # If opponent occasionally defects (not too often), cooperate\n        if opp_d * 5 <= n:\n            return 'C'\n        # Otherwise mixed\n        if opp_d * 2 <= n:\n            return 'C'\n        # Opponent historically mostly defects but just cooperated: exploit\n        if rng.random() < 0.6:\n            return 'D'\n        return 'C'\n\n    # Opponent defected last round\n    if last_my == 'C':\n        # Retaliate, but forgive if opponent's overall rate is decent\n        if opp_d * 3 <= n and run_d == 1:\n            # Occasional forgiveness to break cycles\n            if rng.random() < 0.3:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # We also defected last round (mutual defection)\n    if last_my == 'D':\n        # If opponent's overall defection rate is low, try to restore cooperation\n        if opp_d * 3 <= n:\n            if rng.random() < 0.55:\n                return 'C'\n            return 'D'\n        # Otherwise keep defecting\n        return 'D'\n\n    return 'C'"
  },
