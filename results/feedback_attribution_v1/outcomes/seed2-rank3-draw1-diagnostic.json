  "child": {
    "name": "seed2-rank3-draw1-diagnostic",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    # --- fast counters over history ---\n    opp_d = 0\n    my_d = 0\n    for m, o in history:\n        if o == 'D':\n            opp_d += 1\n        if m == 'D':\n            my_d += 1\n    opp_c = n - opp_d\n\n    def last_k_opp(k):\n        if n == 0:\n            return 0\n        m = min(k, n)\n        s = 0\n        for i in range(n - m, n):\n            if history[i][1] == 'D':\n                s += 1\n        return s\n\n    last_me, last_opp = history[-1]\n    rounds_left = 100 - n\n\n    # --- opening: build trust, but punish immediately if provoked ---\n    if n <= 2:\n        if last_opp == 'D' and n >= 2:\n            return 'D'\n        return 'C'\n\n    # --- strong, near-permanent retaliation against heavy defectors ---\n    # If opponent defects a lot, lock into defection but leave a tiny probe.\n    if opp_d >= 4 and opp_d * 2 > n:\n        if rounds_left <= 4:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        if rng.random() < 0.9:\n            return 'D'\n        return 'C'\n\n    # --- endgame: exploit unconditional cooperators hard ---\n    if rounds_left <= 1:\n        return 'D'\n    if rounds_left <= 3:\n        if opp_d * 3 <= n:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        if rng.random() < 0.6:\n            return 'D'\n        return 'C'\n    if rounds_left <= 6:\n        if opp_d * 4 <= n:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        if rng.random() < 0.4:\n            return 'D'\n        return 'C'\n    if rounds_left <= 12:\n        if opp_d == 0:\n            # pure cooperator: defect most of the time\n            return 'D' if rng.random() < 0.8 else 'C'\n        if last_opp == 'D':\n            return 'D'\n        if rng.random() < 0.25:\n            return 'D'\n        return 'C'\n\n    # --- opponent has never defected: cooperate, exploit only rarely ---\n    if opp_d == 0:\n        if n >= 10 and rng.random() < 0.06:\n            return 'D'\n        return 'C'\n\n    # --- tit-for-tat core with limited, targeted forgiveness ---\n    if last_opp == 'D':\n        recent = last_k_opp(4)\n        # If we've defected a lot already, occasionally restore cooperation\n        # against a mostly-cooperative opponent (avoids endless DD with TFT).\n        if opp_d * 3 < n:\n            if recent >= 2:\n                return 'D'\n            if rng.random() < 0.25:\n                return 'C'\n            return 'D'\n        # Otherwise retaliate firmly.\n        if recent >= 2:\n            return 'D'\n        if rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    # --- opponent cooperated last round ---\n    # If we defected last round, restore cooperation unless clearly behind.\n    if last_me == 'D':\n        if opp_d * 3 > n:\n            # opponent is hostile; keep defecting sometimes\n            if rng.random() < 0.5:\n                return 'D'\n        return 'C'\n\n    # occasional probe against very cooperative opponents\n    if opp_d * 5 < n and n >= 15:\n        if rng.random() < 0.04:\n            return 'D'\n    return 'C'"
  },
