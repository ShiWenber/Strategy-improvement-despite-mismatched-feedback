    "name": "seed0-rank1-draw0-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n >= 100:\n        return 'D'\n    if n < 4:\n        return 'C'\n    opp_last = history[-1][1]\n    my_last = history[-1][0]\n    opp_c = 0\n    my_c = 0\n    for h in history:\n        if h[1] == 'C':\n            opp_c += 1\n        if h[0] == 'C':\n            my_c += 1\n    last10 = history[-10:]\n    opp_recent = 0\n    my_recent = 0\n    for h in last10:\n        if h[1] == 'C':\n            opp_recent += 1\n        if h[0] == 'C':\n            my_recent += 1\n    if opp_c == n:\n        if n >= 20 and rng.random() < 0.1:\n            return 'D'\n        return 'C'\n    if n >= 8 and opp_recent <= 1:\n        return 'D'\n    if n >= 6 and opp_last == 'D' and opp_recent <= 3:\n        return 'D'\n    if opp_last == 'D' and history[-2][1] == 'D':\n        return 'D'\n    if n >= 20 and opp_c * 4 <= n:\n        return 'D'\n    if n >= 50:\n        if opp_c * 100 <= n * 55:\n            return 'D'\n        if my_c * 4 < n and opp_c * 10 > n * 7:\n            return 'D'\n    if n >= 10 and opp_recent <= 4 and opp_last == 'D':\n        return 'D'\n    if opp_last == 'C':\n        if n >= 10 and opp_recent == 10 and my_recent >= 8 and rng.random() < 0.05:\n            return 'D'\n        return 'C'\n    if n >= 5 and history[-2][1] == 'C' and history[-3][1] == 'C':\n        return 'C'\n    if n >= 15 and my_c * 2 < n and opp_c * 2 > n:\n        if rng.random() < 0.3:\n            return 'C'\n    if rng.random() < 0.2:\n        return 'C'\n    return 'D'"
  },
