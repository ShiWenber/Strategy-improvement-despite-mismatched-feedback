  "child": {
    "name": "seed4-rank3-draw1-shuffled",
    "code": "import random\n\n\ndef strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    if n == 2:\n        # If opponent defected at any point so far, retaliate; else cooperate.\n        if history[0][1] == 'D' or history[1][1] == 'D':\n            return 'D'\n        return 'C'\n\n    # Extract opponent sequence once.\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    my_c = me.count('C')\n    my_d = n - my_c\n\n    last_opp = opp[-1]\n    last_me = me[-1]\n\n    # Count consecutive opponent defections at the end.\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Count consecutive opponent cooperations at the end.\n    opp_c_streak = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'C':\n            opp_c_streak += 1\n        else:\n            break\n\n    # Recent window analysis.\n    w = 12 if n > 12 else n\n    recent_opp = opp[-w:]\n    recent_me = me[-w:]\n    recent_opp_d = recent_opp.count('D')\n    recent_opp_c = w - recent_opp_d\n\n    # Exploitation count: our C vs their D.\n    exploited = 0\n    mutual_c = 0\n    for i in range(n):\n        if me[i] == 'C' and opp[i] == 'D':\n            exploited += 1\n        elif me[i] == 'C' and opp[i] == 'C':\n            mutual_c += 1\n\n    # Endgame: last few rounds.\n    remaining = 100 - n\n    if remaining <= 2:\n        # With one or two rounds left, exploit if opponent is likely to cooperate.\n        if opp_d == 0:\n            return 'D' if remaining == 1 else 'D'\n        if recent_opp_c >= recent_opp_d:\n            return 'D'\n        if last_opp == 'C':\n            return 'D'\n        return 'D'\n\n    if remaining <= 5:\n        # Near end. If opponent is mostly cooperative and not heavily punished before,\n        # take advantage but avoid triggering last-minute retaliation if they are aggressive.\n        if opp_c * 4 >= n * 3 and opp_d_streak <= 1:\n            return 'D'\n        if recent_opp_d >= 3:\n            return 'D'\n        if last_opp == 'C' and opp_c >= opp_d:\n            return 'D'\n        if last_opp == 'D':\n            return 'D'\n        return 'C'\n\n    # Persistent pure cooperator: exploit periodically but keep them cooperating.\n    if opp_d == 0 and n >= 6:\n        # Defect occasionally, otherwise cooperate so they don't get angry (they can't anyway).\n        if n % 5 == 0:\n            return 'D'\n        return 'C'\n\n    # Persistent pure defector: defect hard, with rare test.\n    if opp_c == 0 and n >= 4:\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # Very exploitative opponent (mostly defects).\n    if n >= 6 and opp_d * 3 >= n * 2:\n        if recent_opp_c >= 3 and last_opp == 'C':\n            # They may have switched; be a bit forgiving.\n            if rng.random() < 0.35:\n                return 'C'\n        if n % 11 == 0:\n            return 'C'\n        return 'D'\n\n    # Opponent is heavily cooperative but occasionally defects.\n    if opp_c * 4 >= n * 3 and n >= 6:\n        # Short punishment for last defection, then return to cooperation.\n        if last_opp == 'D':\n            if opp_d_streak >= 3:\n                return 'D'\n            if rng.random() < 0.7:\n                return 'D'\n            return 'C'\n        return 'C'\n\n    # Heavily exploited: if we've been burned a lot while cooperating, retaliate.\n    if exploited >= 3 and exploited * 2 > mutual_c + 1:\n        if last_opp == 'C' and rng.random() < 0.55:\n            return 'C'\n        return 'D'\n\n    # Recent opponent behavior drives tit-for-tat-with-forgiveness.\n    if n >= 10:\n        if recent_opp_d >= 8:\n            if n % 9 == 0:\n                return 'C'\n            return 'D'\n        if recent_opp_c >= 9:\n            # Mostly cooperative recently; exploit slightly.\n            if last_opp == 'C':\n                if my_d > 0 and my_d * 4 <= n:\n                    if rng.random() < 0.08:\n                        return 'D'\n                return 'C'\n            # Opponent just defected; punish once.\n            if opp_d_streak >= 3:\n                return 'D'\n            if rng.random() < 0.5:\n                return 'D'\n            return 'C'\n\n    # Opponent just defected.\n    if last_opp == 'D':\n        if opp_d_streak >= 3:\n            # Long defection streak: punish.\n            if rng.random() < 0.9:\n                return 'D'\n            return 'C'\n        # Short defection: mild retaliation, then forgive.\n        if last_me == 'D':\n            # We already punished last round; consider returning to C.\n            if rng.random() < 0.5:\n                return 'C'\n            return 'D'\n        # First response: defect to signal.\n        if opp_c_streak == 0 and rng.random() < 0.75:\n            return 'D'\n        return 'C'\n\n    # Opponent just cooperated.\n    if last_me == 'D':\n        # We defected last round; return to cooperation to restore mutual C.\n        return 'C'\n\n    # Occasional random probe if opponent has been very cooperative for a while.\n    if opp_c_streak >= 6 and n < 90:\n        if rng.random() < 0.04:\n            return 'D'\n\n    return 'C'"
  },
