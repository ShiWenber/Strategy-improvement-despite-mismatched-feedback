  "child": {
    "name": "seed1-rank1-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n\n    my = [h[0] for h in history]\n    opp = [h[1] for h in history]\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    my_c = my.count('C')\n    my_d = n - my_c\n\n    # Mutual cooperation streak at the tail.\n    cc_streak = 0\n    for i in range(n - 1, -1, -1):\n        if my[i] == 'C' and opp[i] == 'C':\n            cc_streak += 1\n        else:\n            break\n\n    # Opponent defection streak at the tail.\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if opp[i] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    remaining = 100 - n\n\n    # Endgame: squeeze a likely cooperator one last time.\n    if remaining <= 1:\n        if opp_c * 3 >= n * 2 and opp_d_streak == 0:\n            return 'D'\n        if opp[-1] == 'C':\n            return 'D'\n        return 'D'\n\n    # Punish an ongoing defection streak hard.\n    if opp_d_streak >= 2:\n        # If opponent usually cooperates, forgive the streak sometimes.\n        if opp_d_streak == 2 and opp_d <= max(1, n // 8) and rng.random() < 0.35:\n            return 'C'\n        return 'D'\n\n    # Opponent just defected once.\n    if opp[-1] == 'D':\n        # If opponent rarely defects, restore cooperation quickly.\n        if opp_d <= max(1, n // 6):\n            if rng.random() < 0.4:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last round.\n    # If we defected last round and opponent still cooperated, return to C.\n    if my[-1] == 'D':\n        return 'C'\n\n    # Opponent mostly defective: defend.\n    if opp_d * 2 > n:\n        if rng.random() < 0.9:\n            return 'D'\n        return 'C'\n\n    # Exploit a persistent-naive cooperator, but keep it calibrated.\n    if opp_d <= max(1, n // 12) and cc_streak >= 5:\n        if remaining > 6 and rng.random() < 0.12:\n            return 'D'\n        return 'C'\n\n    # Mostly cooperative opponent: maintain cooperation with rare probes.\n    if opp_c * 4 >= n * 3:\n        if remaining > 3 and rng.random() < 0.03:\n            return 'D'\n        return 'C'\n\n    # Balanced opponent: TFT-with-forgiveness default.\n    if opp[-1] == 'C':\n        return 'C'\n\n    return 'D'"
  },
