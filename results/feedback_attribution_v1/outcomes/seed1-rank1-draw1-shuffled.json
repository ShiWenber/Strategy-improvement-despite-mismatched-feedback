  "child": {
    "name": "seed1-rank1-draw1-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    opp = [h[1] for h in history]\n    me = [h[0] for h in history]\n    last_me, last_opp = history[-1]\n    rounds_left = 100 - n\n\n    opp_c = opp.count('C')\n    opp_d = n - opp_c\n    coop_rate = opp_c / n\n\n    # ----- Endgame exploitation -----\n    if rounds_left <= 0:\n        return 'C'\n    if rounds_left <= 2:\n        if coop_rate >= 0.4:\n            return 'D'\n        return 'D'\n\n    # Against pure coop, milk it late\n    if opp_d == 0:\n        if rounds_left <= 6:\n            return 'D'\n        return 'C'\n\n    # Against pure defector, defect\n    if opp_c == 0:\n        return 'D'\n\n    # Detect opponent defect streak at tail\n    opp_d_streak = 0\n    for x in reversed(opp):\n        if x == 'D':\n            opp_d_streak += 1\n        else:\n            break\n    my_d_streak = 0\n    for x in reversed(me):\n        if x == 'D':\n            my_d_streak += 1\n        else:\n            break\n\n    # Mutual defection spiral escape\n    if last_me == 'D' and last_opp == 'D':\n        if coop_rate > 0.5 and my_d_streak >= 2:\n            return 'C'\n        if rng.random() < 0.15:\n            return 'C'\n        return 'D'\n\n    # After we defected and opp cooperated, restore cooperation\n    if last_me == 'D' and last_opp == 'C':\n        if coop_rate > 0.35:\n            return 'C'\n        return 'D'\n\n    # Opponent exploited our cooperation\n    if last_me == 'C' and last_opp == 'D':\n        if opp_d_streak >= 2:\n            return 'D'\n        # Forgiving opponent detection: they retaliate but forgive\n        if coop_rate > 0.75 and rng.random() < 0.5:\n            return 'C'\n        return 'D'\n\n    # Both cooperated\n    if last_me == 'C' and last_opp == 'C':\n        # Occasional probe if very cooperative opponent, but calibrated to not\n        # trigger retaliation from TFT-like opponents.\n        if coop_rate > 0.9 and n > 20 and rounds_left > 15:\n            if rng.random() < 0.04:\n                return 'D'\n        return 'C'\n\n    # Fallback: mirror\n    return 'C' if last_opp == 'C' else 'D'"
  },
