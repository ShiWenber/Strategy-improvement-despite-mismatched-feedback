  "child": {
    "name": "seed4-rank3-draw1-hidden",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n    if n == 2:\n        return 'C'\n\n    # Aggregate counts\n    opp_c = 0\n    my_d = 0\n    cc = 0\n    dc = 0\n    cd = 0\n    for i in range(n):\n        me, op = history[i]\n        if op == 'C':\n            opp_c += 1\n        if me == 'D':\n            my_d += 1\n        if me == 'C' and op == 'C':\n            cc += 1\n        elif me == 'D' and op == 'C':\n            dc += 1\n        elif me == 'C' and op == 'D':\n            cd += 1\n\n    opp_c_rate = opp_c / n\n    my_d_rate = my_d / n\n\n    # Last-round info\n    last_me, last_op = history[-1]\n\n    # Track opponent's recent defection streak\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Recent 10 opponent cooperation count\n    start = n - 10\n    if start < 0:\n        start = 0\n    rec_opp_c = 0\n    rec_opp_n = n - start\n    for i in range(start, n):\n        if history[i][1] == 'C':\n            rec_opp_c += 1\n    rec_opp_c_rate = rec_opp_c / rec_opp_n\n\n    remaining = 100 - n\n\n    # ---- Endgame exploitation ----\n    if remaining == 0:\n        return 'D' if opp_c_rate < 0.9 else 'C'\n\n    if remaining == 1:\n        # Last round: defect unless opponent is essentially always cooperative\n        # and we want to preserve long-run; but final round defection always\n        # gains +2 over cooperating when opp plays C, and +0 vs D (same as C vs D).\n        return 'D'\n\n    if remaining == 2:\n        if opp_c_rate >= 0.85:\n            # Defect now; opponent may retaliate last round but expected gain positive\n            return 'D'\n        return 'D'\n\n    # ---- Hard defectors: punish consistently ----\n    if n >= 6 and opp_c_rate < 0.2:\n        # Mostly defect; occasionally cooperate to probe/reset\n        if n % 13 == 0:\n            return 'C'\n        return 'D'\n\n    # ---- Long-run harshly defecting opponent ----\n    if n >= 15 and opp_c_rate < 0.35:\n        if last_op == 'C' and rec_opp_c_rate >= 0.5:\n            return 'C'\n        if n % 11 == 0:\n            return 'C'\n        return 'D'\n\n    # ---- Mostly cooperative opponent: maintain cooperation ----\n    if opp_c_rate >= 0.85 and rec_opp_c_rate >= 0.7:\n        if opp_d_streak >= 2:\n            return 'D'\n        return 'C'\n\n    # ---- Generous tit-for-tat core ----\n    if last_op == 'D':\n        # Opponent just defected\n        if opp_d_streak >= 3:\n            return 'D'\n        # Forgive isolated defections when opponent is generally nice\n        if opp_c_rate >= 0.6 and rec_opp_c_rate >= 0.5:\n            if rng.random() < 0.3:\n                return 'C'\n            return 'D'\n        # Moderate opponent: retaliate but with small forgiveness\n        if rng.random() < 0.1:\n            return 'C'\n        return 'D'\n\n    # Opponent just cooperated\n    # If we defected last round, return to cooperation to avoid spiral\n    if last_me == 'D':\n        return 'C'\n\n    # Probe/exploit when opponent very cooperative and not yet punished\n    if remaining > 4 and opp_c_rate >= 0.9 and rec_opp_c_rate >= 0.8:\n        if n >= 20 and n % 7 == 0:\n            return 'D'\n        return 'C'\n\n    # Cooperative default\n    return 'C'"
  },
