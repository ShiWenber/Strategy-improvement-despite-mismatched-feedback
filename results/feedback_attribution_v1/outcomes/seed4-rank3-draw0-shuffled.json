  "child": {
    "name": "seed4-rank3-draw0-shuffled",
    "code": "def strategy(history, rng):\n    n = len(history)\n    if n == 0:\n        return 'C'\n    if n == 1:\n        return 'C'\n\n    # Gather statistics\n    opp_c = 0\n    opp_d = 0\n    my_c = 0\n    my_d = 0\n    cc = cd = dc = dd = 0\n    for i in range(n):\n        me, op = history[i]\n        if op == 'C':\n            opp_c += 1\n        else:\n            opp_d += 1\n        if me == 'C':\n            my_c += 1\n        else:\n            my_d += 1\n        if me == 'C' and op == 'C':\n            cc += 1\n        elif me == 'C' and op == 'D':\n            cd += 1\n        elif me == 'D' and op == 'C':\n            dc += 1\n        else:\n            dd += 1\n\n    last_me, last_op = history[-1]\n\n    # Score tracking (own perspective): payoff\n    my_score = cc * 3 + dc * 5 + dd * 1\n\n    # Opponent's likely score\n    opp_score = cc * 3 + cd * 5 + dd * 1\n\n    # Recent window (last 10)\n    start = n - 10 if n > 10 else 0\n    r_opp_c = 0\n    r_opp_d = 0\n    for i in range(start, n):\n        if history[i][1] == 'C':\n            r_opp_c += 1\n        else:\n            r_opp_d += 1\n    rwin = n - start\n\n    # Track consecutive opponent defections\n    opp_d_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'D':\n            opp_d_streak += 1\n        else:\n            break\n\n    # Track consecutive opponent cooperations\n    opp_c_streak = 0\n    for i in range(n - 1, -1, -1):\n        if history[i][1] == 'C':\n            opp_c_streak += 1\n        else:\n            break\n\n    # Endgame: last 2 rounds, defect if opponent has been defecting, else cooperate\n    remaining = 100 - n\n    if remaining <= 2:\n        if opp_d_streak >= 1 or (opp_d > opp_c and n > 50):\n            return 'D'\n        return 'C'\n\n    # If opponent is a pure cooperator, keep cooperating (they'd cooperate anyway)\n    if opp_d == 0:\n        # Never defect against never-defector\n        return 'C'\n\n    # If opponent is mostly defecting (very aggressive)\n    if opp_d >= n * 0.75 and n >= 4:\n        if remaining <= 10:\n            return 'D'\n        # Rare probe\n        if rng.random() < 0.05:\n            return 'C'\n        return 'D'\n\n    # Opponent defected last move\n    if last_op == 'D':\n        # Retaliate, but forgive mild mistakes\n        if opp_d_streak >= 3:\n            return 'D'\n        if opp_d_streak == 2:\n            # Two in a row: defect\n            return 'D'\n        # Single defection: sometimes forgive if opponent usually cooperative\n        if opp_c >= opp_d + 2 and n > 10:\n            if rng.random() < 0.3:\n                return 'C'\n            return 'D'\n        return 'D'\n\n    # Opponent cooperated last move\n    # If we defected last move, usually return to cooperation\n    if last_me == 'D':\n        # Don't get stuck in defection spiral\n        return 'C'\n\n    # Opponent cooperated and we cooperated\n    # Check if opponent seems exploitable (very cooperative, we can occasionally defect)\n    if opp_c >= n * 0.85 and n >= 10 and remaining > 10:\n        # Mostly cooperating opponent - defect occasionally to gain\n        if rng.random() < 0.08:\n            return 'D'\n        return 'C'\n\n    # If opponent has high cooperation rate, cooperate\n    if r_opp_c >= rwin * 0.7:\n        return 'C'\n\n    # If opponent has been cooperative overall\n    if opp_c >= opp_d + 3:\n        return 'C'\n\n    # If opponent has defected a lot recently\n    if r_opp_d >= rwin * 0.5:\n        # Defect more often\n        if rng.random() < 0.6:\n            return 'D'\n        return 'C'\n\n    # If we're behind in score, be more aggressive\n    if my_score < opp_score - 5 and remaining > 5:\n        if rng.random() < 0.4:\n            return 'D'\n\n    # Default: cooperate (tit-for-tat with slight cooperation bias)\n    return 'C'"
  },
