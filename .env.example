# Example .env file — copy to `.env` and fill in your own keys.
# The real `.env` is git-ignored; this template is safe to commit.

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=

QWEN_API_KEY=
QWEN_API_BASE=
QWEN_MODEL=

# Set both MODEL fields explicitly for new API experiments; there is no
# built-in model fallback. --env-file values override inherited settings.


# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google / Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=
